import logging
import re
import sys
import os
import subprocess
import time
from threading import Timer

# ---- This snippet of code adds the sources path and the waf configured PYTHONDIR to the Python path ----
# ---- We do this so cloud_utils can be looked up in the following order:
# ---- 1) Sources directory
# ---- 2) waf configured PYTHONDIR
# ---- 3) System Python path
for pythonpath in (
        "@PYTHONDIR@",
        os.path.join(os.path.dirname(__file__),os.path.pardir,os.path.pardir,"python","lib"),
    ):
        if os.path.isdir(pythonpath): sys.path.insert(0,pythonpath)
# ---- End snippet of code ----

from xml.dom.minidom import parse
from cloudutils.configFileOps import configFileOps
from cloudutils.networkConfig import networkConfig

qemuHookLog = os.environ.get("QEMU_HOOK_LOG", "/var/log/libvirt/qemu-hook.log")
logging.basicConfig(filename=qemuHookLog,
                    filemode='a',
                    format='%(asctime)s,%(msecs)d %(name)s %(levelname)s %(message)s',
                    datefmt='%H:%M:%S',
                    level=logging.INFO)
logger = logging.getLogger('qemu-hook')

customDir = "/etc/libvirt/hooks/custom"
customDirPermissions = 0o744
timeoutSeconds = 10 * 60
validQemuActions = ['prepare', 'start', 'started', 'stopped', 'release', 'migrate', 'restore', 'reconnect', 'attach']
FTCTL_GUARD_ROOT = os.environ.get("FTCTL_KRBD_GUARD_ROOT", "/run/ablestack-vm-ftctl/krbd-guard")


def isOldStyleBridge(brName):
    if brName.find("cloudVirBr") == 0:
        return True
    else:
        return False


def isNewStyleBridge(brName):
    if brName.startswith('brvx-'):
        return False
    if re.fullmatch(r"br(.+)-(\d+)", brName) is None:
        return False
    else:
        return True


def getGuestNetworkDevice():
    netlib = networkConfig()
    cfo = configFileOps("/etc/cloudstack/agent/agent.properties")
    guestDev = cfo.getEntry("guest.network.device")
    enslavedDev = netlib.getEnslavedDev(guestDev, 1)
    return enslavedDev.split(".")[0]


def vlanBridgeName(phyDev, vlanId):
    import base64
    import hashlib
    legacy = "br" + phyDev + "-" + vlanId
    if len(legacy.encode("utf-8")) <= 15:
        return legacy
    token = base64.b32encode(hashlib.sha256(phyDev.encode("utf-8")).digest()[:5]).decode("ascii").lower()
    return "br" + token + "-" + vlanId


def preparedVlanParent(bridge, vlanId):
    # PrepareForMigration has already created and ownership-checked the destination bridge.
    try:
        with open("/sys/class/net/" + bridge + "/ifalias") as alias:
            owner = alias.read().strip().split(":")
        if len(owner) == 4 and owner[:2] == ["cloudstack", "vlan"] and owner[3] == vlanId:
            if vlanBridgeName(owner[2], vlanId) == bridge:
                return owner[2]
    except OSError:
        pass
    return None


def handleMigrateBegin():
    try:
        domain = parse(sys.stdin)
        for interface in domain.getElementsByTagName("interface"):
            sources = interface.getElementsByTagName("source")
            if sources.length > 0:
                source = interface.getElementsByTagName("source")[0]
                bridge = source.getAttribute("bridge")
                if isOldStyleBridge(bridge):
                    vlanId = bridge.replace("cloudVirBr", "")
                    phyDev = getGuestNetworkDevice()
                elif isNewStyleBridge(bridge):
                    phyDev, vlanId = re.fullmatch(r"br(.+)-(\d+)", bridge).groups()
                    netlib = networkConfig()
                    if not netlib.isNetworkDev(phyDev):
                        phyDev = preparedVlanParent(bridge, vlanId) or getGuestNetworkDevice()
                else:
                    continue
                newBrName = vlanBridgeName(phyDev, vlanId)
                source.setAttribute("bridge", newBrName)
        print(domain.toxml())
    except:
        pass


def executeCustomScripts(sysArgs):
    if not os.path.exists(customDir) or not os.path.isdir(customDir):
        return

    scripts = getCustomScriptsFromDirectory()

    for scriptName in scripts:
        executeScript(scriptName, sysArgs)


def executeScript(scriptName, sysArgs):
    logger.info('Executing custom script: %s, parameters: %s' % (scriptName, ' '.join(map(str, sysArgs))))
    path = customDir + os.path.sep + scriptName

    if not os.access(path, os.X_OK):
        logger.warning('Custom script: %s is not executable; skipping execution.' % scriptName)
        return

    try:
        process = subprocess.Popen([path] + sysArgs, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, shell=False)
        try:
            timer = Timer(timeoutSeconds, terminateProcess, [process, scriptName])
            timer.start()
            output, error = process.communicate()

            if process.returncode == -15:
                logger.error('Custom script: %s terminated after timeout of %s second[s].'
                             % (scriptName, timeoutSeconds))
                return
            if process.returncode != 0:
                logger.info('return code: %s' % str(process.returncode))
                raise Exception(error)
            logger.info('Custom script: %s finished successfully; output: \n%s' %
                        (scriptName, str(output)))
        finally:
            timer.cancel()
    except (OSError, Exception) as e:
        logger.exception("Custom script: %s finished with error: \n%s" % (scriptName, e))


def terminateProcess(process, scriptName):
    logger.warning(
        'Custom script: %s taking longer than %s second[s]; terminating..' % (scriptName, str(timeoutSeconds)))
    process.terminate()


def getCustomScriptsFromDirectory():
    return sorted([fileName for fileName in os.listdir(customDir) if
                   (fileName is not None) & (fileName != "") & ('_' in fileName) &
                   (fileName.startswith((action + '_')) | fileName.startswith(('all' + '_')))],
                  key=lambda fileName: substringAfter(fileName, '_'))


def substringAfter(s, delimiter):
    return s.partition(delimiter)[2]


def executeProgram(programName, sysArgs):
    logger.info('Executing custom program: %s, parameters: %s' % (programName, ' '.join(map(str, sysArgs))))
    path = programName
    ret_code = -1

    if not os.access(path, os.X_OK):
        logger.warning('Custom script: %s is not executable; skipping execution.' % programName)
        return ret_code

    try:
        process = subprocess.Popen([path] + sysArgs, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, shell=False)
        try:
            timer = Timer(timeoutSeconds, terminateProgram, [process, programName])
            timer.start()
            output, error = process.communicate()
            ret_code = process.returncode

            if process.returncode == -15:
                logger.error('Custom program: %s terminated after timeout of %s second[s].'
                             % (programName, timeoutSeconds))
                return ret_code
            if process.returncode != 0:
                logger.debug('return code: %s' % str(process.returncode))
                raise Exception(error)
            logger.debug('Custom program: %s finished successfully; output: \n%s' %
                         (programName, str(output)))
        finally:
            timer.cancel()
    except (OSError, Exception) as e:
        logger.error("Custom script: %s finished with error: \n%s" % (programName, e))
        pass
    return ret_code


def terminateProgram(process, programName):
    logger.warning(
        'Custom program: %s taking longer than %s second[s]; terminating..' % (programName, str(timeoutSeconds)))
    process.terminate()


def readTextFile(path):
    try:
        with open(path, "r") as handle:
            return handle.read().strip()
    except Exception:
        return ""


def rbdShowmappedRows():
    try:
        output = subprocess.check_output(
            ["/usr/bin/rbd", "showmapped"],
            stderr=subprocess.DEVNULL,
            timeout=10,
            universal_newlines=True)
    except Exception:
        return []

    rows = []
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    if len(lines) <= 1:
        return rows

    headers = re.split(r"\s+", lines[0].lower())
    for line in lines[1:]:
        cols = re.split(r"\s+", line)
        row = {}
        if len(headers) == len(cols):
            row = dict(zip(headers, cols))
        elif len(cols) >= 5:
            row = {
                "pool": cols[1],
                "image": cols[2],
                "device": cols[-1],
            }
        if row:
            rows.append(row)
    return rows


def rbdKeysFromShowmappedDevice(path):
    keys = set()
    for row in rbdShowmappedRows():
        if row.get("device") != path:
            continue
        pool = row.get("pool", "")
        image = row.get("image", "")
        if pool and image:
            keys.add("%s/%s" % (pool, image))
            keys.add(image)
    return keys


def rbdMatchKeys(path):
    keys = set()
    if not path:
        return keys

    keys.add(path)
    if path.startswith("/dev/rbd/"):
        parts = path.split("/")
        if len(parts) >= 5:
            pool = parts[3]
            image = "/".join(parts[4:])
            if pool and image:
                keys.add("%s/%s" % (pool, image))
                keys.add(image)
        elif re.match(r"^/dev/rbd[0-9]+$", path):
            keys.update(rbdKeysFromShowmappedDevice(path))
    elif re.match(r"^/dev/rbd[0-9]+$", path):
        keys.update(rbdKeysFromShowmappedDevice(path))
    elif "/" in path:
        keys.add(path.split("/", 1)[1])

    try:
        real = os.path.realpath(path)
        if real and real != path:
            keys.add(real)
            keys.update(rbdKeysFromShowmappedDevice(real))
    except Exception:
        pass
    return keys


def ftctlGuardPathKeys(guardDir):
    keys = set()
    pathsFile = os.path.join(guardDir, "paths")
    try:
        with open(pathsFile, "r") as handle:
            for line in handle:
                value = line.strip()
                if value:
                    keys.update(rbdMatchKeys(value))
    except Exception:
        pass
    return keys


def ftctlGuardIsActive(guardDir):
    enabled = os.path.join(guardDir, "enabled")
    if not os.path.isfile(enabled):
        return False

    expiresText = readTextFile(os.path.join(guardDir, "expires"))
    try:
        expires = int(expiresText)
    except Exception:
        logger.warning("ftctl_krbd_guard_ignore_malformed_expires guard=%s expires=%s" % (guardDir, expiresText))
        return False

    now = int(time.time())
    if expires <= now:
        logger.info("ftctl_krbd_guard_ignore_expired guard=%s expires=%s now=%s" % (guardDir, expires, now))
        return False
    return True


def isFtctlKrbdGuarded(domainName, path):
    if not domainName or not path:
        return False

    guardDirs = [os.path.join(FTCTL_GUARD_ROOT, domainName)]
    try:
        if os.path.isdir(FTCTL_GUARD_ROOT):
            for name in os.listdir(FTCTL_GUARD_ROOT):
                candidate = os.path.join(FTCTL_GUARD_ROOT, name)
                if candidate not in guardDirs:
                    guardDirs.append(candidate)
    except Exception:
        pass

    candidateKeys = rbdMatchKeys(path)
    for guardDir in guardDirs:
        if not ftctlGuardIsActive(guardDir):
            continue
        guardKeys = ftctlGuardPathKeys(guardDir)
        matched = candidateKeys.intersection(guardKeys)
        if matched:
            logger.info("ftctl_krbd_guard_match domain=%s path=%s guard=%s keys=%s" %
                        (domainName, path, guardDir, sorted(matched)))
            return True
    return False


def unmapStorage():
    try:
        domain = parse(sys.stdin)
        domain_name = sys.argv[1] if len(sys.argv) > 1 else ""

        for volume in domain.getElementsByTagName("disk"):
            target = volume.getElementsByTagName("target")[0]
            #if target.getAttribute("bus") == "scsi":
            try:
                if volume.getElementsByTagName("source"):
                    disk = volume.getElementsByTagName("source")[0]
                    img = disk.getAttribute("dev")
                    if not img:
                        logger.info('ftctl_krbd_skip_empty_unmap_source domain=%s' % domain_name)
                        continue
                    #If kvdo, disable operation is required
                    if "vg_" in img and img.endswith("-ablestack_kvdo"):
                        pattern = r'/dev/mapper/vg_([0-9a-f]{32})-ablestack_kvdo'
                        match = re.search(pattern, img)
                        # If there are matching results
                        if match:
                            vg_name = "vg_"+str(match.group(1))
                            for i in range(10):
                                ret_code = executeProgram("/usr/sbin/vgchange", ["-an", vg_name])
                                if ret_code == 0:
                                    break
                                elif i < 10 and ret_code != 0:
                                    time.sleep(6)
                                else:
                                    logger.error('kvdo vgchange failed: %s' % img)

                            # Convert to UUID format
                            hex_string = match.group(1)
                            image_uuid = f"{hex_string[:8]}-{hex_string[8:12]}-{hex_string[12:16]}-{hex_string[16:20]}-{hex_string[20:]}"
                            for i in range(10):
                                ret_code = executeProgram("/usr/bin/rbd", ["unmap", image_uuid])
                                if ret_code == 0:
                                    break
                                elif i < 10 and ret_code != 0:
                                    time.sleep(6)
                                else:
                                    logger.error('kvdo rbd unmap failed: %s is not rbd image' % img)
                        else:
                            logger.error('rbd kvdo unmap failed: %s is not ablestack kvdo image' % img)
                    else:
                        if isFtctlKrbdGuarded(domain_name, img):
                            logger.info('ftctl_krbd_guard_skip_unmap domain=%s path=%s' % (domain_name, img))
                            continue
                        ret_code = executeProgram("/usr/bin/rbd", ["unmap", img])
                        if ret_code == 22:
                            logger.error('rbd unmap failed: %s is not rbd image' % img)
            except Exception as e:
                logger.exception("exception: %s\n" % (e))
                pass

        # print(domain.toxml())
    except Exception as e:
        logger.exception("exception: %s\n" % (e))
        pass


def iscsiDisks():
    disks = []
    try:
        domain = parse(sys.stdin)
        # logger.info(domain)
        for volume in domain.getElementsByTagName("disk"):
            # logger.info(volume.toxml())
            sources = volume.getElementsByTagName("source")
            for source in sources:
                if str(source.getAttribute("dev")).find("dev"):
                    disk = volume.getElementsByTagName("source")[0]
                    dev = disk.getAttribute("dev")
                    rc = executeProgram("/usr/sbin/lvs", [dev])
                    if rc == 0:
                        disks.append(dev)

        # print(domain.toxml())
    except Exception as e:
        logger.exception("exception: %s\n" % (e))
        pass
    return disks


def getOwnership():
    disks = iscsiDisks()
    logger.info("disk list %s" % disks)
    for disk in disks:
        rc = executeProgram("/usr/sbin/lvchange", ["-ay", disk])
        logger.info(rc)


def removeOwnership():
    disks = iscsiDisks()
    logger.info("disk list %s" % disks)
    for disk in disks:
        rc = executeProgram("/usr/sbin/lvchange", ["-an", disk])
        logger.info(rc)


if __name__ == '__main__':
    if len(sys.argv) != 5:
        sys.exit(0)

    # For docs refer https://libvirt.org/hooks.html#qemu
    logger.info("Executing qemu hook with args: %s" % sys.argv)
    # logger.info("Executing qemu hook with xml: %s" % parse(sys.stdin).toxml())
    action, status = sys.argv[2:4]
    # logger.debug('The given action: %s, and status: %s' % (action, status))
    if action not in validQemuActions:
        logger.error('The given action: %s, is not a valid libvirt qemu operation.' % action)
        sys.exit(0)

    if action == "prepare" and status == "begin":
        getOwnership()

    if action == "migrate" and status == "begin":
        handleMigrateBegin()

    if action == "release" and status == "end":
        unmapStorage()

    executeCustomScripts(sys.argv[1:])
