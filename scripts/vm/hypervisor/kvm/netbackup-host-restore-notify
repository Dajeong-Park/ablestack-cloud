set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="${LOG_FILE:-/var/log/netbackup-mold-restore.log}"
CONFIG_FILE="${MOLD_CONFIG_FILE:-/etc/ablestack/netbackup/restore.conf}"
CONFIG_ROOT="${CONFIG_ROOT:-/etc/ablestack/netbackup}"
MOLD_RESTORE_API_METHOD="${MOLD_RESTORE_API_METHOD:-POST}"
MOLD_RESTORE_MODE="${MOLD_RESTORE_MODE:-live}"
MOLD_API_RESPONSE_FORMAT="${MOLD_API_RESPONSE_FORMAT:-json}"
MOLD_ASYNC_JOB_POLL_INTERVAL="${MOLD_ASYNC_JOB_POLL_INTERVAL:-5}"
MOLD_ASYNC_JOB_TIMEOUT="${MOLD_ASYNC_JOB_TIMEOUT:-1800}"
MOLD_URL="${MOLD_URL:-}"
MOLD_RESTORE_API_URL="${MOLD_RESTORE_API_URL:-}"
ADMIN_APIKEY="${ADMIN_APIKEY:-}"
ADMIN_SECRETKEY="${ADMIN_SECRETKEY:-}"
MOLD_SECRET_FILE="${MOLD_SECRET_FILE:-}"
SECRET_KEY_FILE="${SECRET_KEY_FILE:-}"
SECRET_HELPER="${SECRET_HELPER:-/usr/share/cloudstack-common/scripts/vm/hypervisor/kvm/netbackup-host-secret-helper.sh}"

ensure_log_dir() {
  mkdir -p "$(dirname "${LOG_FILE}")"
}

log_line() {
  ensure_log_dir
  printf '[%s] %s\n' "$(date '+%m/%d/%Y %H:%M:%S.%3N')" "$1" >> "${LOG_FILE}"
}

fail() {
  log_line "RESTORE error: $*"
  printf '%s\n' "$*" >&2
  exit 1
}

require_commands() {
  local missing=()
  local command_name
  for command_name in "$@"; do
    command -v "${command_name}" >/dev/null 2>&1 || missing+=("${command_name}")
  done
  [[ ${#missing[@]} -eq 0 ]] || fail "Required command(s) not found: ${missing[*]}"
}

raw_to_hex() {
  od -An -tx1 -v | tr -d ' \n'
}

hex_to_raw() {
  local hex
  hex="$(printf '%s' "$1" | tr -d '[:space:]')"
  [[ $(( ${#hex} % 2 )) -eq 0 ]] || fail "Invalid hex string length."
  printf '%b' "$(printf '%s' "${hex}" | sed 's/../\\x&/g')"
}

looks_like_backup_id() {
  [[ "${1:-}" =~ ^[^/\\]+_[0-9]+$ ]]
}

trim_quotes() {
  local value="$1"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  printf '%s' "${value}"
}

load_config() {
  [[ -n "${CONFIG_FILE}" ]] || fail "MOLD_CONFIG_FILE must be configured"
  [[ -f "${CONFIG_FILE}" ]] || fail "MOLD_CONFIG_FILE not found: ${CONFIG_FILE}"

  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "${line}" ]] || continue
    [[ "${line}" == \#* ]] && continue
    [[ "${line}" == *"="* ]] || continue

    key="${line%%=*}"
    value="${line#*=}"
    key="${key//[[:space:]]/}"
    value="$(trim_quotes "${value}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    case "${key}" in
      MOLD_URL) [[ -n "${MOLD_URL}" ]] || MOLD_URL="${value}" ;;
      ADMIN_APIKEY) [[ -n "${ADMIN_APIKEY}" ]] || ADMIN_APIKEY="${value}" ;;
      LOG_FILE) [[ "${LOG_FILE}" == "/var/log/netbackup-mold-restore.log" ]] && LOG_FILE="${value}" ;;
      MOLD_SECRET_FILE) [[ -n "${MOLD_SECRET_FILE}" ]] || MOLD_SECRET_FILE="${value}" ;;
      SECRET_KEY_FILE) [[ -n "${SECRET_KEY_FILE}" ]] || SECRET_KEY_FILE="${value}" ;;
      SECRET_HELPER) [[ -n "${SECRET_HELPER}" ]] || SECRET_HELPER="${value}" ;;
    esac
  done < "${CONFIG_FILE}"

  if [[ -z "${MOLD_RESTORE_API_URL}" ]]; then
    MOLD_RESTORE_API_URL="${MOLD_URL}"
  fi
  [[ -n "${MOLD_RESTORE_API_URL}" ]] || fail "MOLD_RESTORE_API_URL or MOLD_URL must be configured"
  [[ -n "${ADMIN_APIKEY}" ]] || fail "ADMIN_APIKEY must be configured"
  [[ "${MOLD_RESTORE_MODE}" == "live" || "${MOLD_RESTORE_MODE}" == "validate-only" ]] || \
    fail "MOLD_RESTORE_MODE must be either 'live' or 'validate-only'"
}

load_secret() {
  [[ -n "${SECRET_KEY_FILE}" ]] || fail "SECRET_KEY_FILE must be configured"
  [[ -n "${MOLD_SECRET_FILE}" ]] || MOLD_SECRET_FILE="${CONFIG_ROOT}/secrets/secret.enc"
  [[ -f "${SECRET_KEY_FILE}" ]] || fail "Secret key file not found: ${SECRET_KEY_FILE}"
  [[ -f "${MOLD_SECRET_FILE}" ]] || fail "Secret file not found: ${MOLD_SECRET_FILE}"

  [[ -x "${SECRET_HELPER}" ]] || fail "Secret helper not found or not executable: ${SECRET_HELPER}"

  ADMIN_SECRETKEY="$(SECRET_KEY_FILE="${SECRET_KEY_FILE}" "${SECRET_HELPER}" decrypt "${MOLD_SECRET_FILE}")" || \
    fail "Failed to decrypt NetBackup secret file ${MOLD_SECRET_FILE}"
  ADMIN_SECRETKEY="${ADMIN_SECRETKEY%$'\r'}"
  ADMIN_SECRETKEY="${ADMIN_SECRETKEY%$'\n'}"
  [[ -n "${ADMIN_SECRETKEY}" ]] || fail "Decrypted MOLD secret is empty."
}

urlencode_plus() {
  python3 - "$1" <<'PY'
import sys
from urllib.parse import quote_plus

print(quote_plus(sys.argv[1]), end="")
PY
}

build_api_params() {
  local command_name="$1"
  shift
  local params="$1"
  printf 'command=%s&%s&response=%s' "$(urlencode_plus "${command_name}")" "${params}" "$(urlencode_plus "${MOLD_API_RESPONSE_FORMAT}")"
}

build_signed_url() {
  local api_params="$1"
  python3 - "$MOLD_RESTORE_API_URL" "$api_params" "$ADMIN_APIKEY" "$ADMIN_SECRETKEY" <<'PY'
import base64
import hashlib
import hmac
import sys
from urllib.parse import parse_qsl, quote_plus

base_url, api_params, api_key, secret_key = sys.argv[1:]
params = [("apikey", api_key)] + parse_qsl(api_params, keep_blank_values=True)

def encode(value):
    # ApiServer.verifyRequest uses Java URLEncoder, then replaces spaces with %20.
    return quote_plus(value, safe="*").replace("~", "%7E").replace("+", "%20")

canonical = "&".join(f"{key}={encode(value)}" for key, value in sorted(params)).lower()
signature = base64.b64encode(hmac.new(secret_key.encode(), canonical.encode(), hashlib.sha256).digest()).decode()
print(f"{base_url}?{api_params}&apiKey={quote_plus(api_key)}&signature={quote_plus(signature)}", end="")
PY
}

invoke_mold_api() {
  local method="$1"
  local command_name="$2"
  local request_key="$3"
  local external_id="$4"
  local netbackup_job_id="${5:-}"
  local extra_params="${6:-}"
  local api_params signed_url response http_body http_code curl_exit

  log_line "RESTORE api-call command=${command_name} method=${method} externalid=${external_id} netbackup_jobid=${netbackup_job_id:-}"
  api_params="${request_key}=$(urlencode_plus "${external_id}")"
  if [[ -n "${netbackup_job_id}" ]]; then
    api_params="${api_params}&jobid=$(urlencode_plus "${netbackup_job_id}")"
  fi
  [[ -z "${extra_params}" ]] || api_params="${api_params}&${extra_params}"
  api_params="$(build_api_params "${command_name}" "${api_params}")"
  signed_url="$(build_signed_url "${api_params}")"
  # Ownership inventories for a VM with many disks can exceed the HTTP URI
  # limit. The already-signed parameters have the same API meaning in a POST
  # form body; never truncate a proof to fit the URL.
  if [[ "${method}" == "POST" && ${#signed_url} -gt 4096 ]]; then
    response="$(curl -sS -X POST \
      -H 'Accept: application/json' \
      -H 'Content-type: application/x-www-form-urlencoded' \
      --data-binary "${signed_url#*\?}" \
      -w '\n%{http_code}' \
      "${signed_url%%\?*}" 2>&1)"
  else
    response="$(curl -sS -X "${method}" \
      -H 'Accept: application/json' \
      -H 'Content-type: application/x-www-form-urlencoded' \
      -w '\n%{http_code}' \
      "${signed_url}" 2>&1)"
  fi
  curl_exit=$?
  http_body="${response%$'\n'*}"
  http_code="${response##*$'\n'}"
  if [[ ${curl_exit} -ne 0 || ! "${http_code}" =~ ^2[0-9][0-9]$ ]]; then
    fail "Mold API call failed: method=${method} command=${command_name} httpCode=${http_code} curlExit=${curl_exit} response=${http_body}"
  fi
  printf '%s' "${http_body}"
}

extract_json_value_by_key() {
  local payload="$1"
  local key_name="$2"

  python3 - "$payload" "$key_name" <<'PY'
import json
import sys

payload = sys.argv[1]
target_key = sys.argv[2].lower()

try:
    data = json.loads(payload)
except Exception:
    sys.exit(1)

def walk(node):
    if isinstance(node, dict):
        for key, value in node.items():
            if str(key).lower() == target_key:
                if isinstance(value, (dict, list)):
                    print(json.dumps(value), end="")
                elif value is None:
                    print("", end="")
                else:
                    print(str(value), end="")
                return True
            if walk(value):
                return True
    elif isinstance(node, list):
        for item in node:
            if walk(item):
                return True
    return False

if not walk(data):
    sys.exit(1)
PY
}

wait_for_mold_async_job() {
  local operation_name="$1"
  local job_id="$2"
  local request_key="$3"
  local request_value="$4"
  local start_time
  start_time="$(date +%s)"

  while true; do
    local response
    response="$(invoke_mold_api "${MOLD_RESTORE_API_METHOD}" "queryAsyncJobResult" "jobid" "${job_id}")" || \
      fail "Failed to query async job status for ${operation_name} jobId=${job_id}"

    local job_status=""
    job_status="$(extract_json_value_by_key "${response}" "jobstatus" 2>/dev/null || true)"
    log_line "RESTORE async-job-poll command=${operation_name} jobid=${job_id} status=${job_status:-0} ${request_key}=${request_value}"

    case "${job_status}" in
      1)
        local job_result=""
        job_result="$(extract_json_value_by_key "${response}" "jobresult" 2>/dev/null || true)"
        log_line "RESTORE async-job-success command=${operation_name} jobid=${job_id} status=1 result=${job_result}"
        printf '%s' "${response}"
        return 0
        ;;
      2)
        local error_text=""
        error_text="$(extract_json_value_by_key "${response}" "errortext" 2>/dev/null || true)"
        [[ -n "${error_text}" ]] || error_text="$(extract_json_value_by_key "${response}" "jobresult" 2>/dev/null || true)"
        log_line "RESTORE async-job-failed command=${operation_name} jobid=${job_id} status=2 error=${error_text:-unknown error}"
        fail "Mold async job failed for ${operation_name} jobId=${job_id}: ${error_text:-unknown error}"
        ;;
      0|"")
        ;;
      *)
        log_line "RESTORE async-job-unexpected command=${operation_name} jobid=${job_id} status=${job_status}"
        ;;
    esac

    if (( $(date +%s) - start_time >= MOLD_ASYNC_JOB_TIMEOUT )); then
      fail "Timed out waiting for Mold async job ${operation_name} jobId=${job_id} after ${MOLD_ASYNC_JOB_TIMEOUT}s"
    fi

    sleep "${MOLD_ASYNC_JOB_POLL_INTERVAL}"
  done
}

submit_volume_restore() {
  local external_id="$1" netbackup_job_id="$2" restore_params="provider=ablestack-netbackup"
  if [[ "${3:-false}" == true ]]; then
    restore_params+="&cleanupmetadataonly=true"
  fi
  if [[ -n "${MOLD_EXTERNAL_RESTORE_PROOF:-}" ]]; then
    restore_params+="&proof=$(urlencode_plus "${MOLD_EXTERNAL_RESTORE_PROOF}")"
  fi
  invoke_mold_api "${MOLD_RESTORE_API_METHOD}" "restoreBackupArtifact" "externalid" "${external_id}" "${netbackup_job_id}" "${restore_params}"
}

main() {
  if [[ $# -lt 2 ]]; then
    fail "usage: netbackup-host-restore-notify <program_name> <external_id> [operation] [netbackup_job_id]"
  fi

  local program_name="$1"
  local external_id="$2"
  local operation
  operation="$(printf '%s' "${3:-}" | tr '[:upper:]' '[:lower:]')"
  local netbackup_job_id="${4:-}"
  local request_key
  local response

  log_line "START script=netbackup-host-restore-notify args=$*"
  require_commands python3 openssl base64 od sed tr curl date mkdir sleep
  load_config
  load_secret
  log_line "RESTORE config-loaded program=${program_name} externalid=${external_id} operation=${operation} mold_url=${MOLD_RESTORE_API_URL} log_file=${LOG_FILE}"


  if [[ "${MOLD_RESTORE_MODE}" == "validate-only" ]]; then
    if looks_like_backup_id "${external_id}"; then
      request_key="backupid"
    else
      request_key="externalid"
    fi
    log_line "RESTORE validate-only command=restoreNetBackup ${request_key}=${external_id} operation=${operation} program=${program_name}"
    return 0
  fi

  if [[ "${operation}" == "report" ]]; then
    [[ -n "${netbackup_job_id}" ]] || fail "Selection diagnostics require a NetBackup Job ID"
    response="$(invoke_mold_api "POST" "reportBackupArtifactRestoreValidation" "validation" "${external_id}" "${netbackup_job_id}")" || return 1
    python3 -c 'import json,sys; value=json.load(sys.stdin).get("reportbackupartifactrestorevalidationresponse", {}); sys.exit(0 if str(value.get("success", "")).lower() == "true" else 1)' <<< "${response}" \
      || fail "Mold did not confirm the external restore selection report"
    printf '%s' "${response}"
    return 0
  fi

  if [[ -n "${operation}" && "${operation}" != "restore" && "${operation}" != "resolve" && "${operation}" != "cleanup" ]]; then
    log_line "RESTORE skip externalid=${external_id} operation=${operation} reason=unsupported-operation"
    return 0
  fi

  # Resolve volume-pipeline child artifacts by their catalog ID or original selection.
  # A metadata UI restore only triggers Mold; Mold reserves capacity and restores
  # every volume itself. Its own restore jobs must never re-enter this post hook.
  response="$(invoke_mold_api "${MOLD_RESTORE_API_METHOD}" "resolveBackupArtifact" "externalid" "${external_id}" "${netbackup_job_id}" "provider=ablestack-netbackup")" || return 1
  if [[ "${operation}" == "resolve" ]]; then
    printf '%s\n' "${response}"
    return 0
  fi
  if [[ "${operation}" == "cleanup" ]]; then
    [[ -n "${netbackup_job_id}" && -n "${MOLD_EXTERNAL_RESTORE_PROOF:-}" ]] || fail "Metadata cleanup requires the original external Job completion proof"
    response="$(submit_volume_restore "${external_id}" "${netbackup_job_id}" true)" || return 1
    local cleanup_job_id
    cleanup_job_id="$(extract_json_value_by_key "${response}" "jobid" 2>/dev/null || true)"
    [[ -n "${cleanup_job_id}" ]] || fail "Mold metadata cleanup reconciliation returned no async jobid: ${response}"
    printf 'SUBMITTED metadata cleanup jobid=%s\n' "${cleanup_job_id}"
    return 0
  fi
  local matched tracked allowed reason artifact_type rejected_success
  matched="$(extract_json_value_by_key "${response}" "matched" 2>/dev/null || true)"
  [[ -n "${matched}" ]] || fail "Mold resolveBackupArtifact returned no resolution: ${response}"
  if [[ "${matched,,}" == "true" ]]; then
    tracked="$(extract_json_value_by_key "${response}" "tracked" 2>/dev/null || true)"
    allowed="$(extract_json_value_by_key "${response}" "restoreallowed" 2>/dev/null || true)"
    reason="$(extract_json_value_by_key "${response}" "reason" 2>/dev/null || true)"
    if [[ "${tracked,,}" == "true" || "${allowed,,}" != "true" ]]; then
      artifact_type="$(extract_json_value_by_key "${response}" "artifacttype" 2>/dev/null || true)"
      if [[ "${tracked,,}" != "true" && "${artifact_type}" == "METADATA" ]]; then
        [[ -n "${netbackup_job_id}" && -n "${MOLD_EXTERNAL_RESTORE_PROOF:-}" ]] || fail "Rejected metadata requires an exact external Job completion proof; watcher will retry"
        response="$(invoke_mold_api "${MOLD_RESTORE_API_METHOD}" "rejectBackupArtifactRestore" "externalid" "${external_id}" "${netbackup_job_id}" \
          "provider=ablestack-netbackup&reason=$(urlencode_plus "${reason:-Metadata restore precheck declined}")&proof=$(urlencode_plus "${MOLD_EXTERNAL_RESTORE_PROOF}")")" || return 1
        rejected_success="$(extract_json_value_by_key "${response}" "success" 2>/dev/null || true)"
        [[ "${rejected_success,,}" == "true" ]] || fail "Mold did not confirm rejected metadata history and cleanup tracking"
      fi
      log_line "RESTORE volume-pipeline-skip externalid=${external_id} jobid=${netbackup_job_id} reason=${reason}"
      printf 'SKIPPED restoreBackupArtifact reason=%s\n' "${reason}"
      return 0
    fi
    [[ -n "${netbackup_job_id}" ]] || fail "Volume pipeline callback requires the exact NetBackup restore Job ID"
    response="$(submit_volume_restore "${external_id}" "${netbackup_job_id}")" || return 1
    local pipeline_job_id
    pipeline_job_id="$(extract_json_value_by_key "${response}" "jobid" 2>/dev/null || true)"
    [[ -n "${pipeline_job_id}" ]] || fail "Mold restoreBackupArtifact returned no async jobid: ${response}"
    log_line "RESTORE volume-pipeline-submitted externalid=${external_id} netbackup_jobid=${netbackup_job_id} mold_jobid=${pipeline_job_id}"
    printf 'SUBMITTED restoreBackupArtifact jobid=%s\n' "${pipeline_job_id}"
    return 0
  fi

  # Legacy VM-directory backups keep their existing restore coordinator.

  if looks_like_backup_id "${external_id}"; then
    request_key="backupid"
  else
    request_key="externalid"
  fi

  response="$(invoke_mold_api "${MOLD_RESTORE_API_METHOD}" "prepareNetBackupRestore" "${request_key}" "${external_id}" "${netbackup_job_id}")"
  should_restore="$(extract_json_value_by_key "${response}" "shouldrestore" 2>/dev/null || true)"
  skip_reason="$(extract_json_value_by_key "${response}" "skipreason" 2>/dev/null || true)"
  vm_id="$(extract_json_value_by_key "${response}" "vmid" 2>/dev/null || true)"
  vm_name="$(extract_json_value_by_key "${response}" "vmname" 2>/dev/null || true)"
  backup_uuid="$(extract_json_value_by_key "${response}" "backupuuid" 2>/dev/null || true)"
  log_line "RESTORE precheck-response command=prepareNetBackupRestore ${request_key}=${external_id} operation=${operation} shouldrestore=${should_restore:-} vmid=${vm_id:-} vmname=${vm_name:-} backupuuid=${backup_uuid:-} skipreason=${skip_reason:-} response=${response}"

  if [[ "${should_restore,,}" != "true" ]]; then
    log_line "RESTORE precheck-skip command=prepareNetBackupRestore ${request_key}=${external_id} operation=${operation} vmid=${vm_id:-} vmname=${vm_name:-} backupuuid=${backup_uuid:-} reason=${skip_reason:-precheck-declined}"
    printf 'SKIPPED prepareNetBackupRestore reason=%s\n' "${skip_reason:-precheck-declined}"
    return 0
  fi

  response="$(invoke_mold_api "${MOLD_RESTORE_API_METHOD}" "restoreNetBackup" "${request_key}" "${external_id}" "${netbackup_job_id}")"
  job_id="$(extract_json_value_by_key "${response}" "jobid" 2>/dev/null || true)"
  [[ -n "${job_id}" ]] || fail "Mold restoreNetBackup API did not return jobid for ${request_key}=${external_id}"

  log_line "RESTORE async-job-submitted command=restoreNetBackup jobid=${job_id} ${request_key}=${external_id} response=${response}"
  log_line "RESTORE async-job-detached command=restoreNetBackup jobid=${job_id} ${request_key}=${external_id}"
  printf 'SUBMITTED restoreNetBackup jobid=%s\n' "${job_id}"
  return 0
}

main "$@"
