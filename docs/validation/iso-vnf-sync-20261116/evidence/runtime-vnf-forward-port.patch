+export function vnfCredentialRows (vm = {}, allowPasswords = false) {
+  const d = vm.vnfdetails || {}
+  return [
+    ['username', '', 'label.username', d.username],
+    ['password', '', 'label.password.default', allowPasswords ? text(vm.password) || d.password : ''],
