import java.io.FileInputStream;
import java.util.Properties;
import com.cloud.utils.db.DbProperties;
import org.apache.cloudstack.ServerDaemon;

/** Runs the assembled management server on loopback against a disposable S5C database. */
public class EuropaManagementStartup {
    public static void main(String[] args) {
        try {
            Properties properties = new Properties();
            try (FileInputStream stream = new FileInputStream(args[0])) {
                properties.load(stream);
            }
            if (!properties.getProperty("db.cloud.host", "").startsWith("epic996-mysql-")) {
                throw new IllegalArgumentException("Only disposable S5C fixtures are permitted");
            }
            DbProperties.setDbProperties(properties);
            ServerDaemon daemon = new ServerDaemon();
            daemon.setBindInterface("127.0.0.1");
            daemon.setHttpPort(18996);
            daemon.setHttpEnable(true);
            daemon.setHttpsEnable(false);
            daemon.setMinThreads(10);
            daemon.setMaxThreads(100);
            daemon.setAccessLogFile("/tmp/epic996/management-access.log");
            Runtime.getRuntime().addShutdownHook(new Thread(() -> {
                try {
                    daemon.stop();
                    daemon.destroy();
                } catch (Exception ignored) {
                    // JVM shutdown still releases all connections owned by this fixture process.
                }
            }));
            daemon.start();
        } catch (Exception failure) {
            failure.printStackTrace();
            System.exit(1);
        }
    }
}
