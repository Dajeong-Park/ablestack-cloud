package com.cloud.upgrade.dao;

import java.lang.reflect.InvocationTargetException;
import java.lang.reflect.Proxy;
import java.nio.file.Files;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.SQLIntegrityConstraintViolationException;
import java.sql.Statement;
import java.util.concurrent.atomic.AtomicInteger;

/** Runs only on the task-owned disposable MySQL fixture. */
public class EuropaKmsDdlReplay {
    static void execute(Connection c, String sql) throws SQLException {
        try (Statement s = c.createStatement()) { s.execute(sql); }
    }
    static void reset(Connection c) throws Exception {
        execute(c, "DROP DATABASE IF EXISTS cloud");
        execute(c, "CREATE DATABASE cloud");
        execute(c, "USE cloud");
        for (String table : new String[]{"account", "domain", "data_center"}) {
            execute(c, "CREATE TABLE " + table + "(id BIGINT UNSIGNED PRIMARY KEY) ENGINE=InnoDB");
            execute(c, "INSERT INTO " + table + " VALUES(1)");
        }
        execute(c, "CREATE TABLE volumes(id BIGINT UNSIGNED PRIMARY KEY, passphrase_id BIGINT UNSIGNED, encrypt_format VARCHAR(32)) ENGINE=InnoDB");
        execute(c, "INSERT INTO volumes VALUES(1,17,'luks')");
        execute(c, "CREATE TABLE version(id INT PRIMARY KEY, version VARCHAR(40), step VARCHAR(40))");
        execute(c, "INSERT INTO version VALUES(1,'4.23.0.0','Complete')");
        execute(c, "CREATE TABLE ablestack_schema_migration(name VARCHAR(255) PRIMARY KEY,state VARCHAR(255),updated DATETIME)");
        execute(c, "INSERT INTO ablestack_schema_migration VALUES('europa-4.23-s4-v1','Complete','2026-01-01'),('europa-4.23-s5a-v1','Complete','2026-01-02'),('europa-4.23-s5b-v1','Complete','2026-01-03')");
        for (String name : new String[]{"column", "foreign_key"}) {
            String procedure = Files.readString(Path.of("engine/schema/src/main/resources/META-INF/db/procedures/cloud.idempotent_add_" + name + ".sql"));
            execute(c, procedure.substring(procedure.indexOf("CREATE PROCEDURE"), procedure.indexOf("END$$") + 3));
        }
    }
    static Connection faultAfter(Connection c, int failAt, AtomicInteger count) {
        return (Connection) Proxy.newProxyInstance(Connection.class.getClassLoader(), new Class[]{Connection.class}, (proxy, method, args) -> {
            try {
                Object result = method.invoke(c, args);
                if (!method.getName().equals("createStatement")) return result;
                Statement statement = (Statement) result;
                return Proxy.newProxyInstance(Statement.class.getClassLoader(), new Class[]{Statement.class}, (sp, sm, sa) -> {
                    try {
                        Object sr = sm.invoke(statement, sa);
                        if (sm.getName().equals("execute") && count.incrementAndGet() == failAt) {
                            throw new SQLException("Injected interruption AFTER committed DDL " + failAt);
                        }
                        return sr;
                    } catch (InvocationTargetException e) { throw e.getCause(); }
                });
            } catch (InvocationTargetException e) { throw e.getCause(); }
        });
    }
    static void verify(Connection c) throws SQLException {
        try (Statement st = c.createStatement(); ResultSet r = st.executeQuery("SELECT passphrase_id, encrypt_format, kms_key_id, kms_wrapped_key_id FROM volumes WHERE id=1")) {
            if (!r.next() || r.getLong(1)!=17 || !"luks".equals(r.getString(2)) || r.getObject(3)!=null || r.getObject(4)!=null) {
                throw new AssertionError("Legacy encrypted volume references changed");
            }
        }
        try (Statement st = c.createStatement(); ResultSet r = st.executeQuery("SELECT COUNT(*) FROM ablestack_schema_migration WHERE state='Complete' AND updated IN ('2026-01-01','2026-01-02','2026-01-03')")) {
            r.next(); if (r.getInt(1)!=3) throw new AssertionError("Prior checkpoint timestamps changed");
        }
        try (Statement st = c.createStatement(); ResultSet r = st.executeQuery("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='cloud' AND table_name LIKE 'kms_%'")) {
            r.next(); if (r.getInt(1)!=6) throw new AssertionError("KMS table missing");
        }
        for (String column : new String[]{"kms_key_id", "kms_wrapped_key_id"}) {
            try {
                execute(c, "UPDATE volumes SET " + column + "=999 WHERE id=1");
                throw new AssertionError("Foreign key accepted missing encryption key");
            } catch (SQLIntegrityConstraintViolationException expected) { }
        }
    }

    public static void main(String[] args) throws Exception {
        if (args.length!=1 || !args[0].equals("epic996-mysql-ddl")) throw new IllegalArgumentException("Task-owned fixture only");
        try (Connection c = DriverManager.getConnection("jdbc:mysql://"+args[0]+":3306/?allowPublicKeyRetrieval=true&useSSL=false", "root", "epic996-fixture-dummy")) {
            reset(c);
            AtomicInteger count = new AtomicInteger();
            EuropaKmsSchemaUpgrade.migrate(faultAfter(c, -1, count));
            int steps = count.get(); verify(c);
            for (int i=1;i<=steps;i++) {
                reset(c);
                EuropaSchemaUpgrade.begin(c, EuropaSchemaUpgrade.S5C);
                try { EuropaKmsSchemaUpgrade.migrate(faultAfter(c,i,new AtomicInteger())); throw new AssertionError("Failure not injected"); }
                catch (com.cloud.utils.exception.CloudRuntimeException expected) {
                    if (expected.getCause()==null || !expected.getCause().getMessage().startsWith("Injected")) throw expected;
                }
                if (!EuropaSchemaUpgrade.hasState(c, EuropaSchemaUpgrade.S5C,"Pending")) throw new AssertionError("False completed checkpoint");
                EuropaKmsSchemaUpgrade.migrate(c);
                EuropaSchemaUpgrade.complete(c, EuropaSchemaUpgrade.S5C);
                EuropaKmsSchemaUpgrade.migrate(c);
                verify(c);
            }
            System.out.println("PASS: S5C interruption/replay after all " + steps + " SQL boundaries, repeat, legacy key references, old journal timestamps and foreign keys");
        }
    }
}
