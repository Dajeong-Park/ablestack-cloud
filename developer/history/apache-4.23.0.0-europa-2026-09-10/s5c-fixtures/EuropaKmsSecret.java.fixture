import java.io.FileInputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.attribute.PosixFilePermissions;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.lang.reflect.Field;
import java.lang.reflect.Proxy;
import java.util.Properties;
import com.cloud.storage.Volume;
import com.cloud.storage.VolumeVO;
import com.cloud.storage.Storage;
import com.cloud.utils.db.DbProperties;
import org.apache.cloudstack.framework.kms.KeyPurpose;
import org.apache.cloudstack.framework.kms.WrappedKey;
import org.apache.cloudstack.kms.KMSManager;
import org.apache.cloudstack.kms.provider.DatabaseKMSProvider;
import org.apache.cloudstack.kms.provider.database.KMSDatabaseKekObjectVO;
import org.apache.cloudstack.kms.provider.database.dao.KMSDatabaseKekObjectDao;
import org.apache.cloudstack.storage.volume.VolumeObject;

/** Reads fixture-only wrapped material, uses real provider crypto and VolumeObject secret encoding. */
public class EuropaKmsSecret {
    static void set(Object target, String name, Object value) throws Exception {
        Field field = target.getClass().getDeclaredField(name);
        field.setAccessible(true);
        field.set(target, value);
    }
    public static void main(String[] args) throws Exception {
        if (args.length != 3 || !args[0].startsWith("/tmp/epic996/") || !args[2].startsWith("/tmp/epic996/")) {
            throw new IllegalArgumentException("Task-owned fixture paths only");
        }
        Properties properties = new Properties();
        try (FileInputStream in = new FileInputStream(args[0])) {
            properties.load(in);
        }
        String host = properties.getProperty("db.cloud.host");
        if (!host.equals("epic996-mysql-ddl")) {
            throw new IllegalArgumentException("Task-owned database only");
        }
        DbProperties.setDbProperties(properties);
        try (Connection c = DriverManager.getConnection("jdbc:mysql://" + host + "/cloud?allowPublicKeyRetrieval=true&useSSL=false",
                properties.getProperty("db.cloud.username"), properties.getProperty("db.cloud.password"));
                PreparedStatement st = c.prepareStatement("SELECT v.kms_wrapped_key_id,w.wrapped_blob,k.kek_label,o.key_material FROM volumes v "
                        + "JOIN kms_wrapped_key w ON v.kms_wrapped_key_id=w.id JOIN kms_kek_versions k ON w.kek_version_id=k.id "
                        + "JOIN kms_database_kek_objects o ON o.label=k.kek_label AND o.removed IS NULL WHERE v.uuid=?")) {
            st.setString(1, args[1]);
            try (ResultSet rows = st.executeQuery()) {
                if (!rows.next()) {
                    throw new AssertionError("Volume has no recoverable wrapped key");
                }
                long wrappedId = rows.getLong(1);
                WrappedKey wrapped = new WrappedKey(rows.getString(3), KeyPurpose.VOLUME_ENCRYPTION, "AES/GCM/NoPadding",
                        rows.getBytes(2), "database", null, null);
                KMSDatabaseKekObjectVO kek = new KMSDatabaseKekObjectVO(rows.getString(3), KeyPurpose.VOLUME_ENCRYPTION, 256, rows.getBytes(4));
                KMSDatabaseKekObjectDao dao = (KMSDatabaseKekObjectDao) Proxy.newProxyInstance(KMSDatabaseKekObjectDao.class.getClassLoader(),
                        new Class[]{KMSDatabaseKekObjectDao.class}, (proxy, method, arguments) -> {
                            if (method.getName().equals("findByLabel") && kek.getLabel().equals(arguments[0])) {
                                return kek;
                            }
                            throw new UnsupportedOperationException(method.getName());
                        });
                DatabaseKMSProvider provider = new DatabaseKMSProvider();
                set(provider, "kekObjectDao", dao);
                KMSManager manager = (KMSManager) Proxy.newProxyInstance(KMSManager.class.getClassLoader(), new Class[]{KMSManager.class},
                        (proxy, method, arguments) -> {
                            if (method.getName().equals("unwrapKey") && ((Long) arguments[0]) == wrappedId) {
                                return provider.unwrapKey(wrapped);
                            }
                            throw new UnsupportedOperationException(method.getName());
                        });
                VolumeVO volume = new VolumeVO(Volume.Type.DATADISK, "fixture", 1, 1, 2, 1, Storage.ProvisioningType.THIN, 1024, null, null, null);
                volume.setKmsWrappedKeyId(wrappedId);
                VolumeObject object = new VolumeObject();
                set(object, "volumeVO", volume);
                set(object, "kmsManager", manager);
                Path output = Path.of(args[2]);
                Files.write(output, object.getPassphrase());
                Files.setPosixFilePermissions(output, PosixFilePermissions.fromString("rw-------"));
                System.out.println("PASS: database-wrapped legacy DEK decoded through DatabaseKMSProvider and VolumeObject");
            }
        }
    }
}
