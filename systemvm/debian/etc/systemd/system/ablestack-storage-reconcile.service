[Unit]
Description=ABLESTACK Storage Service boot reconcile
After=local-fs.target cloud-early-config.service ablestack-storage-runtime-bootstrap.service ablestack-sharedfs-network.service network-online.target qemu-guest-agent.service rtslib-fb-targetctl.service
Requires=ablestack-storage-runtime-bootstrap.service
Wants=ablestack-sharedfs-network.service network-online.target
Before=ablestack-storage-monitor.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ablestack-storage-boot-reconcile
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
