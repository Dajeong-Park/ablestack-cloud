#!/bin/bash

set -euo pipefail

runtime_release="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

CACHE_DIR="${ABLESTACK_STORAGE_MONITOR_CACHE_DIR:-/run/ablestack-storage/monitor}"
INTERVAL="${ABLESTACK_STORAGE_MONITOR_INTERVAL:-10}"
STALE_AFTER="${ABLESTACK_STORAGE_MONITOR_STALE_AFTER:-30}"
STORAGECTL="${ABLESTACK_STORAGECTL:-${runtime_release}/ablestack-storagectl}"

write_json() {
  local scope="$1"
  local tmp
  local input
  input="$(mktemp "${CACHE_DIR}/.${scope}.input.XXXXXX")"
  tmp="$(mktemp "${CACHE_DIR}/.${scope}.XXXXXX")"
  cat > "$input"
  python3 - "$scope" "$STALE_AFTER" "$tmp" "$input" <<'PY'
import json
import sys
import time

scope, stale_after, output, input_path = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
try:
    with open(input_path, "r", encoding="utf-8") as handle:
        payload = json.load(handle)
except Exception as exc:
    payload = {
        "success": False,
        "status": "error",
        "errors": [{"collector": scope, "message": str(exc)}],
    }

SENSITIVE_KEYS = {
    "secrets",
    "secret",
    "password",
    "passwords",
    "key",
    "keys",
    "dhChapKey",
    "dhChapCtrlKey",
    "chapSecret",
    "mutualChapSecret",
}

def redact_sensitive(value):
    if isinstance(value, list):
        return [redact_sensitive(item) for item in value]
    if isinstance(value, dict):
        redacted = {}
        for key, item in value.items():
            lower_key = str(key).lower()
            if key in SENSITIVE_KEYS or "secret" in lower_key or "password" in lower_key or lower_key.endswith("key"):
                continue
            redacted[key] = redact_sensitive(item)
        return redacted
    return value

payload = redact_sensitive(payload)
payload.setdefault("schemaVersion", 1)
payload.setdefault("collector", scope)
payload.setdefault("generatedAt", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
payload["generatedEpoch"] = time.time()
payload["staleAfterSeconds"] = stale_after
with open(output, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, sort_keys=True)
    handle.write("\n")
PY
  rm -f "$input"
  mv "$tmp" "${CACHE_DIR}/${scope}.json"
}

reconcile_network_endpoints() {
  "$STORAGECTL" network endpoints reconcile >/dev/null 2>&1 || true
}

collect_scope() {
  local scope="$1"
  if ABLESTACK_STORAGECTL_CACHE=0 "$STORAGECTL" "$scope" 2>/dev/null | write_json "$scope"; then
    return 0
  fi
  printf '{"success":false,"status":"error","errors":[{"collector":"%s","message":"collector failed"}]}\n' "$scope" | write_json "$scope" || true
}

collect_capacity() {
  python3 - <<'PY' | write_json capacity
import json, os, subprocess, math

def read_json(args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=8, check=True)
    return json.loads(result.stdout)

def flatten(items):
    for item in items or []:
        yield item
        yield from flatten(item.get("children") or [])

# One device snapshot and one mount snapshot; no process or statvfs per alias.
devices = read_json(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,SIZE,SERIAL,WWN,FSTYPE,UUID,MAJ:MIN,PKNAME,MOUNTPOINT"]).get("blockdevices", [])
mounts = list(flatten(read_json(["findmnt", "-J", "-l", "-o", "TARGET,SOURCE,FSTYPE,UUID,FSROOT,MAJ:MIN"]).get("filesystems", [])))
metadata = {}
try:
    with open("/etc/ablestack-storage/nfs-export-aliases.json", encoding="utf-8") as handle:
        aliases = json.load(handle)
except (OSError, ValueError):
    aliases = {}
for alias in aliases.values() if isinstance(aliases, dict) else []:
    if not isinstance(alias, dict):
        continue
    for path, role, peer in ((alias.get("backingPath"), "backing", alias.get("aliasPath")),
                              (alias.get("aliasPath"), "alias", alias.get("backingPath"))):
        if path:
            metadata[path] = {"role": role, "exportName": alias.get("name"), "peerPath": peer}

samples, identities, usage = {}, {}, []
for mount in mounts:
    target = mount.get("target")
    if not target or mount.get("fstype") not in ("xfs", "ext4"):
        continue
    try:
        info = os.stat(target)
        identity = str(mount.get("uuid") or "") + ":" + str(info.st_dev)
        if not mount.get("uuid"):
            continue  # No guessed identity or alias total.
        if identity not in samples:
            fs = os.statvfs(target)
            total = fs.f_blocks * fs.f_frsize
            used = (fs.f_blocks - fs.f_bfree) * fs.f_frsize
            available = fs.f_bavail * fs.f_frsize
            source = str(mount.get("source") or "").split("[", 1)[0]
            samples[identity] = {"identity": identity, "uuid": mount["uuid"], "device": info.st_dev,
                "devicePath": os.path.realpath(source), "filesystem": mount["fstype"],
                "totalBytes": total, "usedBytes": used, "availableBytes": available, "mounts": []}
        sample = samples[identity]
        sample["mounts"].append({"target": target, "fsroot": mount.get("fsroot"), "inode": info.st_ino})
        identities[target] = identity
        if any(target == root or target.startswith(root + "/") for root in ("/srv/ablestack-storage", "/export")):
            percent = math.ceil(100 * sample["usedBytes"] / max(1, sample["usedBytes"] + sample["availableBytes"]))
            item = {"source": str(mount.get("source") or "").split("[", 1)[0],
                "runtimeSource": mount.get("source"), "sizeBytes": sample["totalBytes"], "usedBytes": sample["usedBytes"],
                "availableBytes": sample["availableBytes"], "usedPercent": str(percent) + "%",
                "target": target, "filesystem": mount["fstype"]}
            item.update(metadata.get(target, {}))
            usage.append(item)
    except OSError:
        # A disappearing mount is an unobserved filesystem, never fabricated zero.
        continue
with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as handle:
    boot_id = handle.read().strip()
print(json.dumps({"success": True, "status": "ok", "capacity": usage, "count": len(usage),
    "capacitySnapshotVersion": 1, "bootId": boot_id, "blockDevices": devices,
    "fileSystems": list(samples.values())}, sort_keys=True))
PY
}

collect_once() {
  mkdir -p "$CACHE_DIR"
  reconcile_network_endpoints
  collect_scope health || true
  collect_scope inventory || true
  collect_scope sessions || true
  collect_capacity || printf '{"success":false,"status":"error","errors":[{"collector":"capacity","message":"collector failed"}]}\n' | write_json capacity || true
}

if [[ "${1:-}" == "--once" ]]; then
  collect_once
  exit 0
fi

while true; do
  collect_once
  sleep "$INTERVAL"
done
