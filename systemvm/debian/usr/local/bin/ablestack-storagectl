    managed_files.add(export_file)
    path = export.get("path")
    state = export.get("state", "Ready")
    if enabled and path and state not in ("Disabled", "Destroyed", "Error"):
        export_config = effective_nfs_export_config(export.get("config") or {})
        backing_path = str(export_config.get("backingPath") or "").strip().rstrip("/")
        nested = path_bindings.get(export["uuid"])
        directory_created = nested["created"] if nested else bool(backing_path) and not os.path.exists(backing_path)
        exposed_path = ensure_export_alias(export)
        root_name = safe_export_root_name(export.get("exportPath") or export.get("name"), exposed_path)
        next_alias_state[uuid] = {
            "aliasPath": exposed_path,
            "backingPath": backing_path,
            "name": export.get("name"),
        }
        if not nested or directory_created:
            apply_posix_permissions(nested["anchor"] if nested else backing_path,
                                    nfs_posix_apply_config(dict(export, config=export_config), payload, directory_created))
        rendered_acl_keys = set()
        clients = []
        for acl in export.get("acls", []):
            acl_state = acl.get("state", "Ready")
            if acl_state in ("Disabled", "Destroyed", "Error"):
                continue
            principal = acl.get("principal")
            if not principal:
                continue
            rendered_principal = nfs_export_principal(principal)
            permission = acl.get("permission", "READ_ONLY")
            acl_config = acl.get("config") or {}
            read_write = "rw" if permission == "READ_WRITE" and not truth(export_config, "readOnly", False) else "ro"
            all_squash = truth(acl_config, "allSquash", truth(export_config, "allSquash", False))
            root_squash = "all_squash" if all_squash else ("root_squash" if truth(acl_config, "rootSquash", truth(export_config, "rootSquash", True)) else "no_root_squash")
            sync = "sync" if truth(acl_config, "sync", truth(export_config, "sync", True)) else "async"
            secure = "secure" if truth(acl_config, "secure", truth(export_config, "secure", True)) else "insecure"
            options = [read_write, sync, root_squash, secure, "no_subtree_check"]
            anon_uid = int_config(acl_config, "anonUid")
            anon_gid = int_config(acl_config, "anonGid")
            if anon_uid is None:
                anon_uid = int_config(export_config, "anonUid")
            if anon_gid is None:
                anon_gid = int_config(export_config, "anonGid")
            if anon_uid is not None:
                options.append(f"anonuid={anon_uid}")
            if anon_gid is not None:
                options.append(f"anongid={anon_gid}")
            options = ",".join(options)
            rendered_key = f"{exposed_path} {rendered_principal}"
            if rendered_key in rendered_acl_keys:
                continue
            rendered_acl_keys.add(rendered_key)
            clients.append({
                "clients": ganesha_clients(principal),
                "access": ganesha_access(permission, truth(export_config, "readOnly", False)),
                "squash": ganesha_squash(all_squash, truth(acl_config, "rootSquash", truth(export_config, "rootSquash", True))),
                "anonUid": anon_uid,
                "anonGid": anon_gid,
            })
        if not clients:
            anon_uid = int_config(export_config, "anonUid")
            anon_gid = int_config(export_config, "anonGid")
            clients.append({
                "clients": "*",
                "access": ganesha_access("READ_WRITE", truth(export_config, "readOnly", False)),
                "squash": ganesha_squash(truth(export_config, "allSquash", False), truth(export_config, "rootSquash", True)),
                "anonUid": anon_uid,
                "anonGid": anon_gid,
                "implicit": True,
            })
        rendered_export = {
            "uuid": uuid,
            "name": export.get("name"),
            "path": exposed_path,
            "pseudo": f"/{root_name}",
            "protocolMode": service_protocol_mode,
            "anonUid": int_config(export_config, "anonUid"),
            "anonGid": int_config(export_config, "anonGid"),
            "clients": clients,
        }
        for listener_port in nfs_export_listener_ports(export_config, default_port, service_protocol_mode):
            endpoint_exports.setdefault(("0.0.0.0", int(listener_port)), []).append(dict(rendered_export))
        if export.get("quotaBytes") is not None:
            quota_state[uuid] = {
                "path": path,
                "exportPath": exposed_path,
                "quotaBytes": export.get("quotaBytes"),
                "filesystem": export.get("filesystem"),
            }
    with open(export_file, "w", encoding="utf-8"):
        pass

if service_protocol_mode == "V3V4_DUAL":
    collapsed_exports = []
    seen_exports = set()
    for exports in endpoint_exports.values():
