apply_smb_shares() {
  local payload_file="$1"

  # A listener operation must not reapply users, ACLs or the shared service policy.
  if [[ "$(python3 -c 'import json,sys; print(1 if json.load(open(sys.argv[1])).get("listenerOnly") is True else 0)' "$payload_file")" == "1" ]]; then
    python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/configuration_transaction.py" smb-listeners apply "$payload_file"
    while read -r smb_port; do
      [[ -n "$smb_port" ]] && open_tcp_firewall_port "$smb_port"
    done < <(python3 -c 'import json,sys; print("\n".join(str(v) for v in sorted({int(x.get("port") or 445) for x in json.load(open(sys.argv[1])).get("listeners", [])})))' "$payload_file")
    return 0
  fi

  python3 - "$payload_file" <<'PY'
import json
import grp
import os
import pwd
import re
import shutil
import subprocess
import sys

sys.path.insert(0,os.environ.get("ABLESTACK_STORAGE_HELPER_ROOT","/usr/local/lib/ablestack-storage"))
import shared_directory_policy as directory_policy_module
from shared_directory_policy import DirectoryPolicies
directory_policies=DirectoryPolicies()
protected_paths=set()
payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)

def run(command, **kwargs):
    return subprocess.run(command, check=True, **kwargs)

def run_optional(command, **kwargs):
    try:
        return subprocess.run(command, check=True, **kwargs)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None

def truth(config, key, default):
    value = config.get(key, default) if isinstance(config, dict) else default
    return bool(value)

def safe_share_name(value):
    value = str(value or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", value):
        raise ValueError(f"invalid SMB share name: {value}")
    return value

def derive_ad_workgroup(domain_name, workgroup):
    value = str(workgroup or "").strip()
    if value and value.upper() != "WORKGROUP":
        return re.sub(r"[^A-Za-z0-9]", "", value)[:15].upper() or "WORKGROUP"
    domain = str(domain_name or "").strip()
    if domain:
        derived = re.sub(r"[^A-Za-z0-9]", "", domain.split(".", 1)[0])[:15].upper()
        if derived:
            return derived
    return "WORKGROUP"

def smb_identity(value):
    value = str(value or "")
    if not value:
        return ""
    if value.startswith("@"):
        return value
    return value.replace("/", "\\")

def smb_conf_quote(value):
    return chr(34) + str(value or '').replace(chr(34), "\\" + chr(34)) + chr(34)


def smb_group(value):
    value = smb_identity(value)
    if value.startswith('@'):
        value = value[1:]
    return '@' + smb_conf_quote(value)


def smb_user(value):
    return smb_conf_quote(smb_identity(value))

def ensure_local_group(group):
    if not group:
        return
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", group):
        raise ValueError(f"Invalid local SMB group name: {group}")
    try:
        grp.getgrnam(group)
    except KeyError:
        run(["groupadd", group])

def ensure_local_smb_user(user, password):
    if not user or not password:
        return
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", user):
        raise ValueError(f"Invalid local SMB user name: {user}")
    try:
        pwd.getpwnam(user)
    except KeyError:
        command = ["useradd", "-M", "-s", "/usr/sbin/nologin"]
        try:
            grp.getgrnam(user)
            command.extend(["-g", user])
        except KeyError:
            pass
        command.append(user)
        run(command)
    run(["smbpasswd", "-s", "-a", user], input=f"{password}\n{password}\n", text=True)
    run(["smbpasswd", "-e", user])

def safe_netbios_name(value, instance_uuid):
    raw = re.sub(r"[^A-Za-z0-9]", "", str(value or ""))
    if not raw:
        suffix = re.sub(r"[^A-Fa-f0-9]", "", str(instance_uuid or ""))[:10].ljust(10, "0")
        raw = f"STOR{suffix}"
    return raw[:15].upper()

def local_or_ad_name(principal_type, principal, workgroup, netbios_name):
    value = smb_identity(principal)
    if not value or "\\" in value:
        return value
    if principal_type in ("AD_USER", "AD_GROUP") and workgroup:
        return f"{workgroup}\\{value}"
    if principal_type in ("LOCAL_USER", "LOCAL_GROUP") and netbios_name:
        return f"{netbios_name}\\{value}"
    return value

def samba_principal(principal_type, principal, workgroup, netbios_name):
    name = local_or_ad_name(principal_type, principal, workgroup, netbios_name)
    return smb_group(name) if principal_type in ("LOCAL_GROUP", "AD_GROUP") else smb_user(name)

def identity_candidates(principal_type, principal):
    value = smb_identity(principal)
    candidates = []
    if value:
        candidates.append(value)
    if principal_type in ("AD_USER", "AD_GROUP") and value and "\\" not in value and workgroup:
        candidates.append(f"{workgroup}\\{value}")
    if principal_type in ("LOCAL_USER", "LOCAL_GROUP") and value and "\\" not in value and netbios_name:
        candidates.append(f"{netbios_name}\\{value}")
    seen = set()
    result = []
    for item in candidates:
        if item and item not in seen:
            result.append(item)
            seen.add(item)
    return result


def resolve_account_id(principal_type, principal):
    if principal_type == "LOCAL_USER":
        return "u", str(pwd.getpwnam(principal).pw_uid)
    if principal_type == "LOCAL_GROUP":
        return "g", str(grp.getgrnam(principal).gr_gid)
    if principal_type == "AD_USER":
        for candidate in identity_candidates(principal_type, principal):
            result = run_optional(["wbinfo", "--user-info", candidate], stdout=subprocess.PIPE, text=True)
            if result and result.stdout:
                parts = result.stdout.strip().split(":")
                if len(parts) > 2 and parts[2].isdigit():
                    return "u", parts[2]
            try:
                return "u", str(pwd.getpwnam(candidate).pw_uid)
            except KeyError:
                pass
    if principal_type == "AD_GROUP":
        for candidate in identity_candidates(principal_type, principal):
            result = run_optional(["wbinfo", "--group-info", candidate], stdout=subprocess.PIPE, text=True)
            if result and result.stdout:
                parts = result.stdout.strip().split(":")
                if len(parts) > 2 and parts[2].isdigit():
                    return "g", parts[2]
            try:
                return "g", str(grp.getgrnam(candidate).gr_gid)
            except KeyError:
                pass
    return None, None

def apply_posix_acl(path, principal_type, principal, permission):
    if not shutil.which("setfacl") or not principal:
        return False
    kind, account_id = resolve_account_id(principal_type, principal)
    if not kind or not account_id:
        return False
    bits = "r-x" if permission == "READ_ONLY" else "rwx"
    run_optional(["setfacl", "-m", f"{kind}:{account_id}:{bits}", path])
    run_optional(["setfacl", "-d", "-m", f"{kind}:{account_id}:{bits}", path])
    return True

def reset_directory_acl(path):
    if shutil.which("setfacl"):
        run_optional(["setfacl", "-b", path])
        run_optional(["setfacl", "-k", path])

def apply_directory_policy(path, config, cross_protocol):
    mode = str(config.get("directoryMode") or "0770")
    try:
        parsed_mode = int(mode, 8)
    except ValueError:
        parsed_mode = 0o770
    if not cross_protocol:
        reset_directory_acl(path)
        os.chmod(path, parsed_mode)
    return parsed_mode

identity = payload.get("identityDomain") or {}
identity_config = identity.get("config") or {}
domain_name = identity.get("domainName")
join_state = identity.get("joinState")
workgroup = derive_ad_workgroup(domain_name, identity_config.get("workgroup"))
ad_joined = bool(domain_name and join_state == "JOINED")
netbios_name = safe_netbios_name(payload.get("netbiosName") or identity_config.get("netbiosName"), payload.get("instanceUuid"))
listener_rows = [item for item in (payload.get("listeners") or []) if isinstance(item, dict)]
if not listener_rows:
    listener_rows = [{"listenIp": payload.get("listenIp") or "0.0.0.0", "port": payload.get("port") or 445}]
listener_ports = sorted({int(item.get("port") or 445) for item in listener_rows})
listener_ips = []
wildcard_listener = False
for item in listener_rows:
    listen_ip = str(item.get("listenIp") or "0.0.0.0").strip() or "0.0.0.0"
    if listen_ip == "0.0.0.0":
        wildcard_listener = True
    elif listen_ip not in listener_ips:
        listener_ips.append(listen_ip)

lines = [
    "[global]",
    "   server string = ABLESTACK Storage Service",
    f"   netbios name = {netbios_name}",
    "   smb ports = " + " ".join(str(port) for port in listener_ports),
    "   load printers = no",
    "   printing = bsd",
    "   disable spoolss = yes",
    "   map to guest = Bad User",
    "   passdb backend = tdbsam",
]
if listener_ips and not wildcard_listener:
    lines.extend([
        "   interfaces = lo " + " ".join(listener_ips),
        "   bind interfaces only = yes",
    ])
if ad_joined:
    lines.extend([
        f"   workgroup = {workgroup}",
        f"   realm = {domain_name.upper()}",
        "   security = ADS",
        "   kerberos method = secrets and keytab",
        "   winbind use default domain = yes",
        "   winbind enum users = yes",
        "   winbind enum groups = yes",
        "   idmap config * : backend = tdb",
        "   idmap config * : range = 10000-999999",
    ])
else:
    lines.extend([
        f"   workgroup = {workgroup}",
        "   security = user",
    ])

# Resolve and pin new-mode roots before any account, ownership or service mutation.
path_engine = directory_policy_module.FileSharePathBindings()
path_bindings = path_engine.prepare(payload.get("shares", []), "SMB")

# Validate new ownership policies before any directory/account mutation.
for candidate_share in payload.get("shares", []):
    if candidate_share.get("state") not in ("Disabled", "Destroyed", "Error"):
        directory_policy_module.validate_inheritance_share(candidate_share, payload)

# Validate modes before any ownership/account/ACL mutation.
for candidate_share in payload.get("shares", []):
    if candidate_share.get("state") not in ("Disabled", "Destroyed", "Error"):
        candidate_config = candidate_share.get("config") or {}
        directory_policy_module.smb_creation_modes(candidate_config)
        if directory_policy_module.smb_creation_custom(candidate_config) and not directory_policy_module.smb_creation_protected():
            raise directory_policy_module.PolicyError("SMB_CREATION_POLICY_PROTECTION_REQUIRED")

# Cold boot must establish AD NSS before ownership or ACL resolution.
directory_policy_module.prepare_smb_ad_resolution(payload, netbios_name)

quota_state = {}
access_state = {}
enabled = bool(payload.get("enabled", True))
for share in payload.get("shares", []):
    name = safe_share_name(share.get("name") or share.get("uuid"))
    display_path = share.get("displayPath") or share.get("display_path") or share.get("path")
    config = share.get("config") or {}
    path = share.get("path") or config.get("backingPath")
    if path and str(path).startswith("/export/") and config.get("backingPath"):
        path = config.get("backingPath")
    state = share.get("state", "Ready")
    if not enabled or not path or state in ("Disabled", "Destroyed", "Error"):
        continue
    if str(path).startswith("/export/"):
        raise RuntimeError(f"Refusing to render SMB share {name} on root export path {path}; expected a backing volume path")
    create_directory = truth(config, "createDirectory", True)
    cross_protocol = truth(config, "crossProtocol", False)
    if not os.path.isdir(path):
        if not create_directory:
            raise FileNotFoundError(f"SMB share backing directory does not exist: {path}")
        os.makedirs(path, exist_ok=True)
    common=directory_policies.protected(path,payload)
    nested = path_bindings.get(share["uuid"])
    if nested and not nested["created"] and not common and any(a.get("principal") and a.get("state") not in ("Disabled","Destroyed","Error") for a in share.get("acls",[])):
        raise directory_policy_module.PolicyError("DIRECTORY_POLICY_REQUIRED")
    directory_mode = (os.stat(path).st_mode & 0o7777) if common or nested and not nested["created"] else apply_directory_policy(path, config, cross_protocol)
    if common and not common.get("legacy"): protected_paths.add(str(__import__("pathlib").Path(path).resolve()))
    valid_users = []
    write_list = []
    admin_users = []
    applied_acl_count = 0
    configured_acl_count = 0
    for acl in share.get("acls", []):
        if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        principal = acl.get("principal")
        if not principal:
            continue
        configured_acl_count += 1
        principal_type = acl.get("principalType")
        if principal_type == "LOCAL_USER":
            ensure_local_smb_user(principal, acl.get("password"))
        elif principal_type == "LOCAL_GROUP":
            ensure_local_group(principal)
        smb_principal = samba_principal(principal_type, principal, workgroup, netbios_name)
        permission = acl.get("permission", "READ_ONLY")
        valid_users.append(smb_principal)
        if permission in ("READ_WRITE", "ADMIN"):
            write_list.append(smb_principal)
        if permission == "ADMIN":
            admin_users.append(smb_principal)
        if common and not common.get("legacy") or not common and apply_posix_acl(path, principal_type, principal, permission):
            applied_acl_count += 1

    guest_ok = truth(config, 'guestOk', False)
    if guest_ok and not cross_protocol and not common and (not nested or nested['created']):
        os.chmod(path, 0o777 if not truth(config, 'readOnly', False) else 0o755)
    access_state[str(share.get("uuid") or name)] = {
        "shareName": name,
        "path": path,
        "configuredAclCount": configured_acl_count,
        "appliedAclCount": applied_acl_count,
        "guestOk": guest_ok,
        "accessState": "open" if guest_ok else ("acl_applied" if applied_acl_count > 0 else "no_acl"),
        "directoryMode": oct(directory_mode),
        "aclSummary": [
            {
                "principalType": acl.get("principalType"),
                "principal": acl.get("principal"),
                "permission": acl.get("permission", "READ_ONLY"),
                "state": acl.get("state", "Ready"),
            }
            for acl in share.get("acls", [])
            if acl.get("state", "Ready") not in ("Disabled", "Destroyed", "Error") and acl.get("principal")
        ],
    }

    if nested and not guest_ok and not valid_users:
        continue  # new-mode roots are never published before an explicit ACL
    lines.extend([
        "",
        f"[{name}]",
        f"   path = {nested['anchor'] if nested else path}",
        f"   read only = {'yes' if truth(config, 'readOnly', False) else 'no'}",
        f"   browseable = {'yes' if truth(config, 'browseable', True) else 'no'}",
        f"   guest ok = {'yes' if guest_ok else 'no'}",
        "   create mask = " + directory_policy_module.smb_creation_modes(config)["createMask"],
        "   directory mask = " + directory_policy_module.smb_creation_modes(config)["directoryMask"],
        "   force create mode = " + directory_policy_module.smb_creation_modes(config)["forceCreateMode"],
        "   force directory mode = " + directory_policy_module.smb_creation_modes(config)["forceDirectoryMode"],
    ])
    if "inheritOwner" in config:
        lines.append("   inherit owner = " + ("yes" if directory_policy_module.inheritance_enabled(config) else "no"))
    if valid_users:
        lines.append("   valid users = " + " ".join(valid_users))
    if write_list:
        lines.append("   write list = " + " ".join(write_list))
    if admin_users:
        lines.append("   admin users = " + " ".join(admin_users))
    if share.get("quotaBytes") is not None:
        quota_state[str(share.get("uuid"))] = {
            "path": path,
            "displayPath": display_path,
            "quotaBytes": share.get("quotaBytes"),
            "filesystem": share.get("filesystem"),
        }

directory_policies.apply_acl_batch(payload.get("shares",[]),protected_paths)

import tempfile
candidate_fd, candidate_path = tempfile.mkstemp(prefix=".ablestack-candidate-", dir="/etc/samba")
try:
    with os.fdopen(candidate_fd, "w", encoding="utf-8") as smb_fp:
        smb_fp.write("\n".join(lines) + "\n")
        smb_fp.flush()
        os.fsync(smb_fp.fileno())
    os.chmod(candidate_path, 0o644)
    run(["testparm", "-s", candidate_path], stdout=subprocess.DEVNULL)
    os.replace(candidate_path, "/etc/samba/smb.conf")
finally:
    if os.path.exists(candidate_path):
        os.unlink(candidate_path)

with open(os.path.join(state_dir, "smb-quotas.json"), "w", encoding="utf-8") as quota_fp:
    json.dump(quota_state, quota_fp, sort_keys=True, indent=2)

with open(os.path.join(state_dir, "smb-access.json"), "w", encoding="utf-8") as access_fp:
    json.dump(access_state, access_fp, sort_keys=True, indent=2)

print(json.dumps({"success": True, "shares": len(payload.get("shares", [])), "quotas": len(quota_state), "adJoined": ad_joined, "netbiosName": netbios_name, "access": access_state}))
