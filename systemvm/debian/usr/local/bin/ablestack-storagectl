runtime_sessions() {
  local payload_file="${1:-}"
  emit_cached_runtime "sessions" "$payload_file" && return 0
  python3 - "$payload_file" <<'PY'
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, __import__("os").environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from session_auth import (  # noqa: E402
    classify_iscsi_auth_session,
    compatibility_authenticated,
    parse_targetcli_auth_observation,
)

def load_payload(path):
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}

def endpoint_host(value):
    if not value:
        return ""
    if value.startswith("[") and "]:" in value:
        value = value[1:value.index("]:")]
    else:
        value = value.rsplit(":", 1)[0]
    return normalize_ip(value)

def normalize_ip(value):
    value = str(value or "").strip()
    if value.startswith("[") and value.endswith("]"):
        value = value[1:-1]
    if value.lower().startswith("::ffff:"):
        return value.split(":", 3)[-1]
    return value

def endpoint_port(value):
    value = str(value or "").strip()
    if value.startswith("[") and "]:" in value:
        value = value.rsplit(":", 1)[-1]
    elif ":" in value:
        value = value.rsplit(":", 1)[-1]
    try:
        return int(value)
    except Exception:
        return None

def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return default

def store_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, path)

def read_text(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except Exception:
        return default

def nfs_protocol_mode_from_content(content):
    protocols = re.findall(r"Protocols\s*=\s*([^;\n]+)", content or "")
    joined = ",".join(protocols)
    return "V3V4_DUAL" if "3" in joined and "4" in joined else "V4_ONLY"

def nfs_export_name_from_pseudo(pseudo):
    name = str(pseudo or "").strip().strip("/")
    return name or ""

def configured_nfs_listener_exports():
    listeners = {}
    for path in sorted(glob.glob("/etc/ganesha/ablestack-storage/*.conf")):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                content = handle.read()
        except Exception:
            continue
        bind_match = re.search(r"Bind_addr\s*=\s*\"?([^\";\n]+)\"?", content)
        port_match = re.search(r"NFS_Port\s*=\s*(\d+)", content)
        listen_ip = normalize_ip(bind_match.group(1).strip() if bind_match else "0.0.0.0")
        port = int(port_match.group(1)) if port_match else 2049
        key = (listen_ip, port)
        entries = listeners.setdefault(key, [])
        for export_block in re.findall(r"EXPORT\s*\{(.*?)\n\}", content, re.S):
            pseudo_match = re.search(r"Pseudo\s*=\s*\"?([^\";\n]+)\"?", export_block)
            path_match = re.search(r"Path\s*=\s*\"?([^\";\n]+)\"?", export_block)
            pseudo = pseudo_match.group(1).strip() if pseudo_match else ""
            name = nfs_export_name_from_pseudo(pseudo)
            if not name:
                continue
            entries.append({
                "resourceName": name,
                "exportName": name,
                "clientPath": f"/{name}",
                "backingPath": path_match.group(1).strip() if path_match else "",
                "protocolMode": nfs_protocol_mode_from_content(export_block),
            })
    return listeners

def nfs_listener_ports():
    ports = {2049}
    for key, entries in configured_nfs_listener_exports().items():
        if entries:
            ports.add(key[1])
    return ports

def nfs_export_hint_for_session(local):
    listeners = configured_nfs_listener_exports()
    local_ip = endpoint_host(local)
    local_port = endpoint_port(local)
    if not local_port:
        return {}
    entries = list(listeners.get((local_ip, local_port), []))
    if not entries:
        entries = list(listeners.get(("0.0.0.0", local_port), []))
    if not entries:
        return {}
    if len(entries) == 1:
        return dict(entries[0])
    return {"possibleExports": entries, "resourceName": "", "exportName": ""}

def active_nvme_subsystems():
    state = load_json("/etc/ablestack-storage/nvmeof-subsystems.json", {})
    subsystems = []
    for subsystem in state.get("subsystems", []) if isinstance(state, dict) else []:
        name = subsystem.get("targetName") or subsystem.get("subsystemNqn")
        if name and subsystem.get("state", "Ready") not in ("Disabled", "Destroyed", "Error"):
            config = subsystem.get("config") if isinstance(subsystem.get("config"), dict) else {}
            namespace = str(subsystem.get("lunOrNamespace") or subsystem.get("lunornamespace") or subsystem.get("namespaceId") or subsystem.get("namespaceid") or config.get("namespaceId") or config.get("namespaceid") or "1")
            subsystems.append({
                "id": str(subsystem.get("id") or ""),
                "uuid": str(subsystem.get("uuid") or ""),
                "name": str(name),
                "subsystemNqn": str(name),
                "namespace": namespace,
                "namespaces": [namespace],
                "endpoint": f"{state.get('listenIp') or subsystem.get('listenIp') or ''}:{state.get('port') or subsystem.get('port') or 4420}".strip(":"),
            })
    return subsystems

def configfs_nvme_subsystem_details(name):
    root = os.path.join("/sys/kernel/config/nvmet/subsystems", str(name or ""))
    if not os.path.isdir(root):
        return {}
    namespaces = []
    namespaces_root = os.path.join(root, "namespaces")
    if os.path.isdir(namespaces_root):
        for entry in sorted(os.listdir(namespaces_root), key=lambda value: int(value) if str(value).isdigit() else str(value)):
            path = os.path.join(namespaces_root, entry)
            if not os.path.isdir(path):
                continue
            enabled = read_text(os.path.join(path, "enable"))
            device_path = read_text(os.path.join(path, "device_path"))
            namespaces.append({
                "id": str(entry),
                "enabled": enabled,
                "devicePath": device_path,
            })
    hosts = []
    hosts_root = os.path.join(root, "allowed_hosts")
    if os.path.isdir(hosts_root):
        for entry in sorted(os.listdir(hosts_root)):
            hosts.append(entry)
    allow_any_host = read_text(os.path.join(root, "attr_allow_any_host")) == "1"
    return {
        "subsystemNqn": str(name),
        "name": str(name),
        "namespaces": [namespace.get("id") for namespace in namespaces if namespace.get("id")],
        "namespaceDetails": namespaces,
        "namespaceCount": len([namespace for namespace in namespaces if namespace.get("enabled") == "1" or namespace.get("devicePath")]),
        "allowedHosts": hosts,
        "allowAnyHost": allow_any_host,
    }

def configfs_nvme_listeners():
    listeners = []
    root = "/sys/kernel/config/nvmet/ports"
    if not os.path.isdir(root):
        return listeners
    state_by_name = {item.get("name"): item for item in active_nvme_subsystems() if item.get("name")}
    for port_id in sorted(os.listdir(root), key=lambda value: int(value) if str(value).isdigit() else str(value)):
        port_root = os.path.join(root, port_id)
        if not os.path.isdir(port_root):
            continue
        listen_ip = normalize_ip(read_text(os.path.join(port_root, "addr_traddr"), ""))
        port = endpoint_port(read_text(os.path.join(port_root, "addr_trsvcid"), ""))
        transport = read_text(os.path.join(port_root, "addr_trtype"), "tcp") or "tcp"
        subsystem_root = os.path.join(port_root, "subsystems")
        subsystems = []
        if os.path.isdir(subsystem_root):
            for entry in sorted(os.listdir(subsystem_root)):
                detail = configfs_nvme_subsystem_details(entry)
                state_item = state_by_name.get(entry, {})
                if state_item:
                    for key, value in state_item.items():
                        if key in ("namespaces", "namespaceDetails", "namespaceCount", "allowedHosts", "allowAnyHost"):
                            continue
                        if value not in (None, "", []):
                            detail[key] = value
                    detail.setdefault("subsystemNqn", entry)
                    detail.setdefault("name", entry)
                if not detail:
                    detail = {"subsystemNqn": entry, "name": entry, "namespaces": [], "namespaceCount": 0}
                subsystems.append(detail)
        listeners.append({
            "portId": str(port_id),
            "listenIp": listen_ip,
            "port": port,
            "transport": transport,
            "subsystems": subsystems,
        })
    return listeners

def nvmeof_listener_ports():
    ports = {listener.get("port") for listener in configfs_nvme_listeners() if listener.get("port")}
    state = load_json("/etc/ablestack-storage/nvmeof-subsystems.json", {})
    if isinstance(state, dict):
        ports.update(normalize_port_values(state.get("port") or state.get("listenPort") or state.get("listenport")))
        for listener in state.get("listeners") or []:
            if isinstance(listener, dict):
                ports.update(normalize_port_values(listener.get("port") or listener.get("listenPort") or listener.get("listenport")))
        for subsystem in state.get("subsystems") or []:
            if isinstance(subsystem, dict):
                config = subsystem.get("config") if isinstance(subsystem.get("config"), dict) else {}
                ports.update(normalize_port_values(subsystem.get("listenerPorts") or subsystem.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports")))
    return ports or {4420}

def nvme_listener_matches_session(listener, local_ip, local_port):
    if listener.get("port") != local_port:
        return False
    listen_ip = normalize_ip(listener.get("listenIp"))
    return listen_ip in ("", "0.0.0.0", "::") or listen_ip == normalize_ip(local_ip)

def nvme_subsystem_candidates_for_session(local):
    local_ip = endpoint_host(local)
    local_port = endpoint_port(local)
    candidates = []
    if not local_port:
        return candidates
    for listener in configfs_nvme_listeners():
        if not nvme_listener_matches_session(listener, local_ip, local_port):
            continue
        for subsystem in listener.get("subsystems") or []:
            if subsystem.get("namespaceCount", 0) <= 0:
                continue
            item = dict(subsystem)
            item["listenerPort"] = listener.get("port")
            item["listenerIp"] = listener.get("listenIp")
            item["listenerPortId"] = listener.get("portId")
            candidates.append(item)
    return candidates

def nvme_subsystem_hint(filters):
    subsystems = active_nvme_subsystems()
    resource_id = str(filters.get("resourceId") or filters.get("resourceName") or "").strip()
    if resource_id:
        resource_id_lower = resource_id.lower()
        for subsystem in subsystems:
            candidates = (subsystem.get("id"), subsystem.get("uuid"), subsystem.get("name"))
            if any(resource_id_lower == str(candidate or "").lower() for candidate in candidates):
                return subsystem
    if len(subsystems) == 1:
        return subsystems[0]
    return {}

def active_iscsi_state():
    state = load_json("/etc/ablestack-storage/iscsi-targets.json", {})
    return state if isinstance(state, dict) else {}

def configfs_iscsi_listener_ports():
    ports = set()
    root = "/sys/kernel/config/target/iscsi"
    if not os.path.isdir(root):
        return ports
    for portals_root in glob.glob(os.path.join(root, "*", "tpgt_1", "np")):
        if not os.path.isdir(portals_root):
            continue
        for entry in os.listdir(portals_root):
            port = endpoint_port(entry)
            if port:
                ports.add(port)
    return ports

def normalize_port_values(value):
    ports = set()
    if isinstance(value, list):
        values = value
    elif isinstance(value, str):
        values = [part.strip() for part in value.split(",")]
    elif value is None:
        values = []
    else:
        values = [value]
    for item in values:
        try:
            port = int(item)
            if port > 0:
                ports.add(port)
        except Exception:
            pass
    return ports

def iscsi_listener_ports():
    state = active_iscsi_state()
    ports = set()
    ports.update(configfs_iscsi_listener_ports())
    for listener in state.get("listeners") or []:
        if isinstance(listener, dict):
            ports.update(normalize_port_values(listener.get("port") or listener.get("listenPort") or listener.get("listenport")))
    ports.update(normalize_port_values(state.get("port") or state.get("listenPort") or state.get("listenport")))
    for target in state.get("targets") or []:
        if not isinstance(target, dict):
            continue
        config = target.get("config") if isinstance(target.get("config"), dict) else {}
        ports.update(normalize_port_values(target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports")))
    return ports or {3260}

def target_listener_ports_from_state(target):
    config = target.get("config") if isinstance(target.get("config"), dict) else {}
    ports = normalize_port_values(target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports"))
    return ports or iscsi_listener_ports()

def active_iscsi_targets_for_port(local_port):
    state = active_iscsi_state()
    targets = []
    for target in state.get("targets") or []:
        if not isinstance(target, dict):
            continue
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        if local_port in target_listener_ports_from_state(target):
            targets.append(target)
    return targets

def target_name_value(target):
    return str(target.get("targetName") or target.get("targetname") or target.get("name") or "").strip()

def target_lun_value(target):
    return str(target.get("lunOrNamespace") or target.get("lunornamespace") or target.get("lun") or "0").strip()

def configfs_iscsi_acls_for_target(target_name):
    root = os.path.join("/sys/kernel/config/target/iscsi", str(target_name or ""), "tpgt_1", "acls")
    if not os.path.isdir(root):
        return []
    acls = []
    for name in sorted(os.listdir(root)):
        path = os.path.join(root, name)
        if os.path.isdir(path):
            acls.append({"principal": name, "state": "Ready", "source": "configfs"})
    return acls

def active_acls_for_target(target):
    acls = []
    raw_acls = target.get("acls", [])
    if not raw_acls:
        raw_acls = configfs_iscsi_acls_for_target(target_name_value(target))
    for acl in raw_acls:
        if not isinstance(acl, dict) or acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        principal = acl.get("principal") or acl.get("initiatorIqn") or acl.get("initiatoriqn")
        if not principal:
            continue
        acls.append(acl)
    return acls

def configfs_iscsi_lun_backstore_map():
    mapping = {}
    root = "/sys/kernel/config/target/iscsi"
    if not os.path.isdir(root):
        return mapping
    for target_name in sorted(os.listdir(root)):
        if target_name == "discovery_auth":
            continue
        lun_root = os.path.join(root, target_name, "tpgt_1", "lun")
        if not os.path.isdir(lun_root):
            continue
        for lun_dir_name in sorted(os.listdir(lun_root)):
            if not lun_dir_name.startswith("lun_"):
                continue
            lun_dir = os.path.join(lun_root, lun_dir_name)
            if not os.path.isdir(lun_dir):
                continue
            lun = lun_dir_name.split("_", 1)[1]
            for entry in os.listdir(lun_dir):
                path = os.path.join(lun_dir, entry)
                if not os.path.islink(path):
                    continue
                backstore = os.path.basename(os.path.realpath(path))
                if backstore:
                    mapping[backstore] = {"targetIqn": target_name, "lun": lun}
    return mapping

def targetcli_iscsi_session_details():
    if not shutil.which("targetcli"):
        return []
    result = subprocess.run(["targetcli", "sessions", "detail"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        return []
    lun_map = configfs_iscsi_lun_backstore_map()
    sessions = []
    current = None
    for line in result.stdout.splitlines():
        text = line.strip()
        if not text:
            continue
        if text.startswith("alias:"):
            if current:
                sessions.append(current)
            current = {"mappedLuns": []}
            sid_match = re.search(r"\bsid:\s*([^\s]+)", text)
            if sid_match:
                current["targetcliSid"] = sid_match.group(1)
            state_match = re.search(r"session-state:\s*([A-Z_]+)", text)
            if state_match:
                current["state"] = state_match.group(1)
            continue
        if current is None:
            continue
        if text.startswith("name:"):
            name_match = re.search(r"name:\s*([^\s]+)", text)
            if name_match:
                current["initiatorIqn"] = name_match.group(1)
            current["targetcliAuthObservation"] = parse_targetcli_auth_observation(text)
            continue
        if text.startswith("mapped-lun:"):
            lun_match = re.search(r"mapped-lun:\s*([^\s]+)", text)
            backstore_match = re.search(r"backstore:\s*[^/]+/([^\s]+)", text)
            mode_match = re.search(r"\bmode:\s*([^\s]+)", text)
            mapped = {}
            if lun_match:
                mapped["mappedLun"] = lun_match.group(1)
            if backstore_match:
                backstore = backstore_match.group(1)
                mapped["backstore"] = backstore
                mapped.update(lun_map.get(backstore, {}))
            if mode_match:
                mapped["mode"] = mode_match.group(1)
            current["mappedLuns"].append(mapped)
            continue
        if text.startswith("address:"):
            address_match = re.search(r"address:\s*([^\s]+)", text)
            if address_match:
                current["peerHost"] = normalize_ip(address_match.group(1))
            connection_match = re.search(r"connection-state:\s*([A-Z_]+)", text)
            if connection_match:
                current["connectionState"] = connection_match.group(1)
            continue
    if current:
        sessions.append(current)
    return sessions

def configfs_iscsi_target_portals(target_name):
    portals = []
    if not target_name:
        return portals
    np_root = os.path.join("/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "np")
    if not os.path.isdir(np_root):
        return portals
    for entry in sorted(os.listdir(np_root)):
        value = entry.strip()
        if value:
            portals.append(value)
    return portals

def active_iscsi_target_for_name(target_name):
    if not target_name:
        return {}
    for target in active_iscsi_state().get("targets", []) or []:
        if not isinstance(target, dict):
            continue
        if target_name_value(target) == target_name:
            return target
    return {}

def read_configfs_boolean(path):
    value = read_text(path, "").strip().lower()
    if value in ("1", "yes", "true", "on"):
        return True
    if value in ("0", "no", "false", "off"):
        return False
    return None

def configfs_iscsi_auth_required(target_name):
    if not target_name:
        return None
    return read_configfs_boolean(os.path.join(
        "/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "attrib", "authentication"))

def nonempty_auth_value(value):
    return str(value or "").strip().lower() not in ("", "null", "none")

def configfs_iscsi_acl_chap_configured(target_name, initiator_iqn):
    if not target_name or not initiator_iqn:
        return None
    auth_root = os.path.join(
        "/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "acls", initiator_iqn, "auth")
    if not os.path.isdir(auth_root):
        return None
    userid = read_text(os.path.join(auth_root, "userid"), "")
    password = read_text(os.path.join(auth_root, "password"), "")
    mutual_userid = read_text(os.path.join(auth_root, "mutual_userid"), "")
    mutual_password = read_text(os.path.join(auth_root, "mutual_password"), "")
    return ((nonempty_auth_value(userid) and nonempty_auth_value(password)) or
            (nonempty_auth_value(mutual_userid) and nonempty_auth_value(mutual_password)))

def desired_iscsi_acl_chap_configured(target, initiator_iqn):
    if not isinstance(target, dict) or not initiator_iqn:
        return None
    for acl in target.get("acls") or []:
        if not isinstance(acl, dict):
            continue
        principal = acl.get("principal") or acl.get("initiatorIqn") or acl.get("initiatoriqn")
        if str(principal or "") != str(initiator_iqn):
            continue
        config = acl.get("config") if isinstance(acl.get("config"), dict) else {}
        return bool(config.get("chapEnabled") or config.get("mutualChapEnabled"))
    return None

def iscsi_session_auth_contract(detail, target_name, target):
    initiator_iqn = detail.get("initiatorIqn")
    auth_required = configfs_iscsi_auth_required(target_name)
    desired_chap = desired_iscsi_acl_chap_configured(target, initiator_iqn)
    runtime_chap = configfs_iscsi_acl_chap_configured(target_name, initiator_iqn)
    chap_configured = True if True in (desired_chap, runtime_chap) else (
        False if desired_chap is False and runtime_chap is False else None)
    verification = classify_iscsi_auth_session(
        detail.get("connectionState") or detail.get("state"), auth_required, chap_configured)
    contract = {
        "sessionSchemaVersion": 2,
        "targetcliAuthObservation": detail.get("targetcliAuthObservation") or "UNSPECIFIED",
        "authVerification": verification,
    }
    if auth_required is not None:
        contract["authRequired"] = auth_required
    if chap_configured is not None:
        contract["chapConfigured"] = chap_configured
    authenticated = compatibility_authenticated(verification)
    if authenticated is not None:
        contract["authenticated"] = authenticated
    return contract

def targetcli_iscsi_session_rows():
    rows = []
    for detail in targetcli_iscsi_session_details():
        target_map = {}
        for mapped in detail.get("mappedLuns") or []:
            target_name = mapped.get("targetIqn")
            if not target_name:
                continue
            lun = str(mapped.get("lun") or mapped.get("mappedLun") or "").strip()
            item = target_map.setdefault(target_name, {"luns": set(), "mapped": []})
            if lun:
                item["luns"].add(lun)
            item["mapped"].append(mapped)
        if not target_map:
            continue
        for target_name, item in sorted(target_map.items()):
            target = active_iscsi_target_for_name(target_name)
            luns = ",".join(sort_lun_values(item.get("luns") or []))
            portals = configfs_iscsi_target_portals(target_name)
            ports = target_listener_ports_from_state(target) if target else sorted({endpoint_port(portal) for portal in portals if endpoint_port(portal)})
            exact_endpoint = len(portals) == 1
            local = portals[0] if exact_endpoint else ""
            peer_host = detail.get("peerHost") or ""
            session_id = hashlib.sha256(
                f"ISCSI|{detail.get('targetcliSid')}|{target_name}|{luns}|{detail.get('initiatorIqn')}|{peer_host}".encode("utf-8")
            ).hexdigest()[:20]
            state = "ESTAB" if str(detail.get("connectionState") or "").upper() == "LOGGED_IN" else (detail.get("connectionState") or detail.get("state") or "UNKNOWN")
            row = {
                "sessionId": session_id,
                "protocol": "ISCSI",
                "state": state,
                "connectionState": detail.get("connectionState") or detail.get("state"),
                "peer": peer_host,
                "client": peer_host,
                "initiatorIqn": detail.get("initiatorIqn"),
                "targetcliSid": detail.get("targetcliSid"),
                "resourceId": target.get("uuid") or target.get("id") if target else None,
                "resourceName": target_name,
                "targetName": target_name,
                "targetIqn": target_name,
                "targetiqn": target_name,
                "targetGroupKey": target_name,
                "targetLuns": luns,
                "lun": luns,
                "lunOrNamespace": luns,
                "mappingStatus": "exact",
                "endpointMappingStatus": "exact" if exact_endpoint else "candidate",
                "local": local,
                "possibleEndpoints": portals,
                "listenerPorts": ",".join(str(port) for port in ports) if ports else "",
            }
            row.update(iscsi_session_auth_contract(detail, target_name, target))
            if not exact_endpoint:
                row["mappingWarning"] = "Target/LUN attribution is exact from targetcli; endpoint is candidate because the target has multiple portals or shared listeners."
            rows.append({k: v for k, v in row.items() if v not in (None, "")})
    return rows

def sort_lun_values(values):
    return sorted(values, key=lambda value: int(value) if str(value).isdigit() else str(value))

def exact_iscsi_session_hint(local, peer=None):
    local_port = endpoint_port(local)
    peer_host = normalize_ip(endpoint_host(peer or ""))
    if not local_port or not peer_host:
        return {}
    targets_by_name = {target_name_value(target): target for target in active_iscsi_state().get("targets", []) if isinstance(target, dict)}
    candidates = []
    for session in targetcli_iscsi_session_details():
        if normalize_ip(session.get("peerHost")) != peer_host:
            continue
        target_map = {}
        for mapped in session.get("mappedLuns") or []:
            target_name = mapped.get("targetIqn")
            lun = str(mapped.get("lun") or mapped.get("mappedLun") or "").strip()
            if not target_name:
                continue
            target_map.setdefault(target_name, set())
            if lun:
                target_map[target_name].add(lun)
        for target_name, luns in target_map.items():
            target = targets_by_name.get(target_name)
            if target and local_port not in target_listener_ports_from_state(target):
                continue
            lun_list = ",".join(sort_lun_values(luns))
            candidates.append({
                "resourceId": target.get("uuid") or target.get("id") if target else None,
                "targetIqn": target_name,
                "targetiqn": target_name,
                "targetName": target_name,
                "resourceName": target_name,
                "targetGroupKey": target_name,
                "targetLuns": lun_list,
                "lun": lun_list,
                "lunOrNamespace": lun_list,
                "initiatorIqn": session.get("initiatorIqn"),
                "targetcliSid": session.get("targetcliSid"),
                "connectionState": session.get("connectionState"),
            })
    if not candidates:
        return {}
    if len(candidates) == 1:
        hint = dict(candidates[0])
        hint["mappingStatus"] = "exact"
        return {k: v for k, v in hint.items() if v not in (None, "")}
    return {
        "mappingStatus": "candidate",
        "possibleTargets": [{"targetIqn": item.get("targetIqn"), "lun": item.get("lun")} for item in candidates],
        "possibleInitiators": sorted({item.get("initiatorIqn") for item in candidates if item.get("initiatorIqn")}),
        "mappingWarning": "Multiple active iSCSI target sessions match this client and listener; target/LUN attribution is candidate-based.",
    }

def iscsi_session_hint(local, peer=None):
    exact_hint = exact_iscsi_session_hint(local, peer)
    if exact_hint:
        return exact_hint
    port = endpoint_port(local)
    if not port:
        return {}
    targets = active_iscsi_targets_for_port(port)
    if not targets:
        return {"mappingStatus": "unmapped", "mappingWarning": f"No active iSCSI target uses listener port {port}"}
    target_names = sorted({target_name_value(target) for target in targets if target_name_value(target)})
    if not target_names:
        return {"mappingStatus": "unmapped", "mappingWarning": f"No iSCSI target IQN was found for listener port {port}"}
    exact = len(target_names) == 1
    target_name = target_names[0] if exact else ", ".join(target_names)
    group_targets = [target for target in targets if exact and target_name_value(target) == target_name] if exact else targets
    luns = []
    acls = []
    seen_acl = set()
    for target in group_targets:
        lun = target_lun_value(target)
        if lun not in luns:
            luns.append(lun)
        for acl in active_acls_for_target(target):
            principal = acl.get("principal") or acl.get("initiatorIqn") or acl.get("initiatoriqn")
            if principal in seen_acl:
                continue
            seen_acl.add(principal)
            acls.append(acl)
    target = group_targets[0]
    hint = {
        "resourceId": target.get("uuid") or target.get("id"),
        "resourceName": target_name,
        "targetName": target_name,
        "targetIqn": target_name,
        "targetiqn": target_name,
        "targetGroupKey": target_name,
        "targetLuns": ",".join(luns),
        "lun": ",".join(luns),
        "lunOrNamespace": ",".join(luns),
        "mappingStatus": "exact" if exact else "candidate",
    }
    if len(acls) == 1:
        hint["initiatorIqn"] = acls[0].get("principal") or acls[0].get("initiatorIqn") or acls[0].get("initiatoriqn")
    elif len(acls) > 1:
        hint["possibleInitiators"] = sorted(seen_acl)
    if not exact:
        hint["possibleTargets"] = [
            {
                "targetIqn": target_name_value(target),
                "lun": target_lun_value(target),
                "resourceId": target.get("uuid") or target.get("id"),
            }
            for target in group_targets if target_name_value(target)
        ]
        hint["mappingWarning"] = "Multiple iSCSI targets share this listener port; target/LUN attribution is candidate-based."
    return {k: v for k, v in hint.items() if v not in (None, "")}

def smbstatus_sessions():
    if not shutil.which("smbstatus"):
        return []
    result = subprocess.run(["smbstatus", "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return []
    try:
        data = json.loads(result.stdout)
    except Exception:
        return []
    sessions = data.get("sessions") if isinstance(data, dict) else {}
    tcons = data.get("tcons") if isinstance(data, dict) else {}
    if not isinstance(sessions, dict) or not isinstance(tcons, dict):
        return []
    rows = []
    for tree_id, tree in tcons.items():
        if not isinstance(tree, dict):
            continue
        service = str(tree.get("service") or "")
        if not service or service == "IPC$":
            continue
        session_id = str(tree.get("session_id") or "")
        session = sessions.get(session_id, {}) if session_id else {}
        if not isinstance(session, dict):
            session = {}
        hostname = str(session.get("hostname") or "")
        remote_machine = str(session.get("remote_machine") or tree.get("machine") or "")
        peer = hostname.replace("ipv4:", "").replace("ipv6:", "") if hostname else remote_machine
        dialect = session.get("session_dialect")
        row = {
            "sessionId": f"smb-{session_id}-{tree_id}" if session_id else f"smb-{tree_id}",
            "sambaSessionId": session_id,
            "treeId": str(tree_id),
            "protocol": "SMB",
            "state": "ESTAB",
            "peer": peer,
            "client": remote_machine or endpoint_host(peer),
            "user": session.get("username"),
            "username": session.get("username"),
            "group": session.get("groupname"),
            "resourceName": service,
            "shareName": service,
            "dialect": dialect,
            "protocolVersion": dialect,
            "connectedAt": tree.get("connected_at"),
        }
        rows.append({k: v for k, v in row.items() if v not in (None, "")})
    return rows

def tcp_socket_rows():
    if not shutil.which("ss"):
        return []
    result = subprocess.run(["ss", "-H", "-tn"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    rows = []
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        local = parts[-2]
        peer = parts[-1]
        rows.append({
            "state": parts[0],
            "local": local,
            "peer": peer,
            "line": line,
            "localPort": endpoint_port(local),
        })
    return rows

def observed_iscsi_tcp_count():
    ports = iscsi_listener_ports()
    return len([row for row in tcp_socket_rows() if row.get("localPort") in ports])

def observed_nvmeof_tcp_count():
    ports = nvmeof_listener_ports()
    return len([row for row in tcp_socket_rows() if row.get("localPort") in ports])

def nvme_tcp_sessions(rows, filters):
    ports = nvmeof_listener_ports()
    grouped = {}
    for row in rows:
        if row.get("localPort") not in ports:
            continue
        local = row.get("local") or ""
        peer = row.get("peer") or ""
        client = endpoint_host(peer)
        key = (local, client)
        grouped.setdefault(key, []).append(row)
    sessions = []
    resource_id = str(filters.get("resourceId") or filters.get("resourceName") or "").strip().lower()
    for (local, client), group_rows in sorted(grouped.items(), key=lambda item: f"{item[0][0]}|{item[0][1]}"):
        peer_ports = sorted({endpoint_port(row.get("peer")) for row in group_rows if endpoint_port(row.get("peer"))})
        candidates = nvme_subsystem_candidates_for_session(local)
        if resource_id:
            candidates = [
                candidate for candidate in candidates
                if resource_id in {
                    str(candidate.get("id") or "").lower(),
                    str(candidate.get("uuid") or "").lower(),
                    str(candidate.get("name") or "").lower(),
                    str(candidate.get("subsystemNqn") or "").lower(),
                }
            ]
        state_values = {str(row.get("state") or "").upper() for row in group_rows}
        state = "ESTAB" if "ESTAB" in state_values else (next(iter(state_values), "UNKNOWN") or "UNKNOWN")
        transport_session_id = hashlib.sha256(f"NVME_OF|{local}|{client}".encode("utf-8")).hexdigest()[:20]
        possible_namespaces = []
        for candidate in candidates:
            subsystem_nqn = candidate.get("subsystemNqn") or candidate.get("name")
            for namespace_id in candidate.get("namespaces") or []:
                possible_namespaces.append({
                    "subsystemNqn": subsystem_nqn,
                    "namespaceId": str(namespace_id),
                })
        session = {
            "sessionId": transport_session_id,
            "transportSessionId": transport_session_id,
            "sessionKind": "TRANSPORT_AGGREGATE",
            "protocol": "NVME_OF",
            "state": state,
            "local": local,
            "peer": client,
            "client": client,
            "queueCount": len(group_rows),
            "peerPorts": peer_ports,
            "listenerPort": endpoint_port(local),
            "listenerPorts": str(endpoint_port(local) or ""),
            "possibleSubsystems": candidates,
            "possibleNamespaces": possible_namespaces,
            "canDisconnect": False,
            "disconnectDisabledReason": "The kernel exposes transport queues but no stable logical NVMe controller handle for this connection.",
        }
        if len(candidates) == 1:
            candidate = candidates[0]
            hosts = candidate.get("allowedHosts") or []
            session.update({
                "configuredHostNqns": hosts,
                "allowAnyHost": candidate.get("allowAnyHost"),
                "hostPolicy": "ALLOW_ANY" if candidate.get("allowAnyHost") else ("EXPLICIT_ACL" if hosts else "DENY_ALL"),
                "mappingStatus": "CANDIDATE",
                "endpointMappingStatus": "EXACT",
                "mappingWarning": "One configured subsystem is exposed on this transport endpoint, but the kernel does not expose a durable controller-to-subsystem identity for this TCP aggregate.",
            })
        elif candidates:
            session.update({
                "mappingStatus": "AMBIGUOUS",
                "endpointMappingStatus": "EXACT",
                "mappingWarning": "Multiple NVMe-oF subsystems with namespaces are exposed on this listener; subsystem attribution is candidate-based.",
            })
        else:
            session.update({
                "mappingStatus": "UNMAPPED",
                "endpointMappingStatus": "UNMAPPED",
                "mappingWarning": f"No active NVMe-oF subsystem namespace is linked to listener {local}.",
            })
        sessions.append({k: v for k, v in session.items() if v not in (None, "", [])})
    return sessions

def tcp_sessions(filters):
    rows = tcp_socket_rows()
    nfs_ports = nfs_listener_ports()
    nvme_ports = nvmeof_listener_ports()
    sessions = []
    for row in rows:
        local = row.get("local") or ""
        peer = row.get("peer") or ""
        local_port = row.get("localPort")
        protocol = None
        if local_port in nfs_ports:
            protocol = "NFS"
        elif local.endswith(":445") or local.endswith(":139"):
            protocol = "SMB"
        elif local_port in nvme_ports:
            continue
        if protocol:
            session_id = hashlib.sha256(f"{protocol}|{row.get('state')}|{local}|{peer}".encode("utf-8")).hexdigest()[:20]
            session = {"sessionId": session_id, "protocol": protocol, "state": row.get("state"), "local": local, "peer": peer, "client": endpoint_host(peer)}
            if protocol == "NFS":
                hint = nfs_export_hint_for_session(local)
                if hint:
                    session.update(hint)
            sessions.append(session)
    sessions.extend(nvme_tcp_sessions(rows, filters))
    return sessions

def ss_sessions(filters):
    tcp_rows = tcp_sessions(filters)
    smb_rows = smbstatus_sessions()
    iscsi_rows = targetcli_iscsi_session_rows()
    base_rows = [session for session in tcp_rows if session.get("protocol") != "ISCSI"]
    if not smb_rows:
        return base_rows + iscsi_rows
    result = [session for session in base_rows if session.get("protocol") != "SMB"]
    smb_tcp_rows = [session for session in base_rows if session.get("protocol") == "SMB"]
    for smb in smb_rows:
        client = smb.get("client") or endpoint_host(smb.get("peer"))
        match = next((tcp for tcp in smb_tcp_rows if client and client == tcp.get("client")), None)
        if match:
            smb.setdefault("local", match.get("local"))
            smb.setdefault("peer", match.get("peer"))
            smb.setdefault("state", match.get("state"))
        result.append(smb)
    return result + iscsi_rows

payload = load_payload(sys.argv[1] if len(sys.argv) > 1 else "")
protocol_filter = str(payload.get("protocol", "")).upper()
client_filter = str(payload.get("client", "")).strip()
state_filter = str(payload.get("state", "")).upper()
sessions = []
now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
session_state_path = "/run/ablestack-storage/monitor/session-state.json"
session_state = load_json(session_state_path, {})
next_state = {}
raw_sessions = ss_sessions(payload)
observed_iscsi = observed_iscsi_tcp_count()
observed_nvmeof = observed_nvmeof_tcp_count()
warnings = []
for session in raw_sessions:
    if protocol_filter and session.get("protocol") != protocol_filter:
        continue
    if client_filter and client_filter not in session.get("peer", "") and client_filter not in session.get("client", ""):
        continue
    if state_filter and session.get("state", "").upper() != state_filter:
        continue
    saved = session_state.get(session["sessionId"], {}) if isinstance(session_state, dict) else {}
    session["connectedAt"] = saved.get("connectedAt") or session.get("connectedAt") or now
    session["lastSeen"] = now
    next_state[session["sessionId"]] = {
        "connectedAt": session["connectedAt"],
        "lastSeen": now,
        "protocol": session.get("protocol"),
        "peer": session.get("peer"),
        "local": session.get("local"),
        "client": session.get("client"),
        "user": session.get("user"),
        "username": session.get("username"),
        "group": session.get("group"),
        "resourceId": session.get("resourceId"),
        "resourceName": session.get("resourceName"),
        "shareName": session.get("shareName"),
        "dialect": session.get("dialect"),
        "protocolVersion": session.get("protocolVersion"),
        "sambaSessionId": session.get("sambaSessionId"),
        "treeId": session.get("treeId"),
        "subsystemNqn": session.get("subsystemNqn"),
        "targetName": session.get("targetName"),
        "targetIqn": session.get("targetIqn"),
        "targetGroupKey": session.get("targetGroupKey"),
        "targetLuns": session.get("targetLuns"),
        "initiatorIqn": session.get("initiatorIqn"),
        "possibleInitiators": session.get("possibleInitiators"),
        "possibleTargets": session.get("possibleTargets"),
        "mappingStatus": session.get("mappingStatus"),
        "endpointMappingStatus": session.get("endpointMappingStatus"),
        "mappingWarning": session.get("mappingWarning"),
        "possibleEndpoints": session.get("possibleEndpoints"),
        "listenerPorts": session.get("listenerPorts"),
        "connectionState": session.get("connectionState"),
        "authenticated": session.get("authenticated"),
        "sessionSchemaVersion": session.get("sessionSchemaVersion"),
        "targetcliAuthObservation": session.get("targetcliAuthObservation"),
        "authVerification": session.get("authVerification"),
        "authRequired": session.get("authRequired"),
        "chapConfigured": session.get("chapConfigured"),
        "lun": session.get("lun"),
        "lunOrNamespace": session.get("lunOrNamespace"),
        "namespaceId": session.get("namespaceId"),
        "namespaceCount": session.get("namespaceCount"),
        "hostNqn": session.get("hostNqn"),
        "allowedHosts": session.get("allowedHosts"),
        "allowAnyHost": session.get("allowAnyHost"),
        "possibleSubsystems": session.get("possibleSubsystems"),
        "queueCount": session.get("queueCount"),
        "peerPorts": session.get("peerPorts"),
        "listenerPort": session.get("listenerPort"),
    }
    if session.get("mappingWarning"):
        warnings.append(session.get("mappingWarning"))
    sessions.append(session)
store_json(session_state_path, next_state)
status = "ok"
if observed_iscsi and not any(session.get("protocol") == "ISCSI" for session in sessions):
    status = "degraded"
    warnings.append("iSCSI TCP sessions were observed but no iSCSI session rows matched the current filters.")
elif any(session.get("protocol") == "ISCSI" and str(session.get("mappingStatus", "")).upper() == "UNMAPPED" for session in sessions):
    status = "degraded"
if observed_nvmeof and not any(session.get("protocol") == "NVME_OF" for session in sessions):
    status = "degraded"
    warnings.append("NVMe-oF TCP queues were observed but no NVMe-oF logical session rows matched the current filters.")
elif any(session.get("protocol") == "NVME_OF" and str(session.get("mappingStatus", "")).upper() == "UNMAPPED" for session in sessions):
    status = "degraded"
print(json.dumps({
    "success": True,
    "status": status,
    "sessionSchemaVersion": 2,
    "sessions": sessions,
    "count": len(sessions),
    "observedTcpCount": len(raw_sessions),
    "observedIscsiTcpCount": observed_iscsi,
    "observedNvmeofTcpCount": observed_nvmeof,
    "observedNvmeofSessionCount": len([session for session in sessions if session.get("protocol") == "NVME_OF"]),
    "warnings": sorted(set([warning for warning in warnings if warning])),
}, sort_keys=True))
PY
}

session_disconnect() {
  local payload_file="$1"
  python3 - "$payload_file" <<'PY'
import json
import re
import shutil
import subprocess
import sys

PORTS = {"NFS": "2049", "SMB": "445", "ISCSI": "3260", "NVME_OF": "4420"}

def load_payload(path):
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)

def endpoint_host(value):
    if not value:
        return ""
    if value.startswith("[") and "]:" in value:
        return value[1:value.index("]:")]
    return value.rsplit(":", 1)[0]

def endpoint_port(value):
    value = str(value or "").strip()
    if value.startswith("[") and "]:" in value:
        value = value.rsplit(":", 1)[-1]
    elif ":" in value:
        value = value.rsplit(":", 1)[-1]
    try:
        return int(value)
    except Exception:
        return None

payload = load_payload(sys.argv[1])
protocol = str(payload.get("protocol", "")).upper()
peer = payload.get("peer", "")
local = payload.get("local", "")
client = endpoint_host(peer)
port = str(endpoint_port(local) or PORTS.get(protocol) or "")
if not protocol or not port or not client:
    print(json.dumps({"success": False, "status": "INVALID_REQUEST", "details": "protocol and peer endpoint are required"}))
    sys.exit(1)
if not shutil.which("ss"):
    print(json.dumps({"success": False, "status": "UNSUPPORTED", "details": "ss command is not available"}))
    sys.exit(1)

commands = [
    ["ss", "-K", "dst", client, "dport", "=", f":{port}"],
    ["ss", "-K", "src", client, "sport", "=", f":{port}"],
]
results = []
success = False
for command in commands:
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    results.append({"command": " ".join(command), "exitCode": result.returncode, "stdout": result.stdout.strip(), "stderr": result.stderr.strip()})
    if result.returncode == 0:
        success = True
print(json.dumps({"success": success, "status": "ok" if success else "best_effort", "protocol": protocol, "peer": peer, "local": local, "commands": results}, sort_keys=True))
PY
}

volume_attach_inspect() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

sys.path.insert(0, __import__("os").environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from volume_identity import VolumeIdentityError, resolve_volume_device  # noqa: E402

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

preparation = None
if payload.get("preparationOperationId"):
    from volume_preparation import PreparationContext
    preparation = PreparationContext(payload)

def run(args):
    if preparation:
        return preparation.run(args)
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)

def lsblk():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"])
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "lsblk failed")
    return json.loads(result.stdout).get("blockdevices", [])

def walk(devices, parent_disk_path=None, parent_path=None):
    for dev in devices:
        dev["_parentDiskPath"] = dev.get("path") if dev.get("type") == "disk" else parent_disk_path
        dev["_parentPath"] = parent_path
        yield dev
        for child in dev.get("children") or []:
            yield from walk([child], dev.get("_parentDiskPath"), dev.get("path"))

def compact(value):
    return "".join(ch for ch in str(value or "").lower() if ch.isalnum())

def token_matches(value, tokens):
    candidate = compact(value)
    if not candidate:
        return False
    for token in tokens:
        if len(token) >= 8 and (token in candidate or candidate in token):
            return True
    return False

def parse_size(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0

def size_matches(dev, expected_size):
    if expected_size <= 0:
        return False
    actual_size = parse_size(dev.get("size"))
    if actual_size <= 0:
        return False
    tolerance = max(1024 * 1024, expected_size // 100)
    return abs(actual_size - expected_size) <= tolerance

devices = list(walk(lsblk()))
device_by_path = {dev.get("path"): dev for dev in devices if dev.get("path")}
import_mode = str(payload.get("importMode") or "MOUNT_EXISTING").upper()
format_modes = {"FORMAT_EMPTY", "FORMAT_IF_EMPTY"}
expected_size = parse_size(payload.get("volumeSizeBytes"))
identity_tokens = [compact(v) for v in (payload.get("volumeUuid"), payload.get("volumeName")) if compact(v)]
root_disk_paths = {
    dev.get("_parentDiskPath")
    for dev in devices
    if dev.get("_parentDiskPath") and (dev.get("mountpoint") in ("/", "/boot", "/boot/efi") or dev.get("fstype") == "swap")
}

def is_root_disk_tree(dev):
    return dev.get("_parentDiskPath") in root_disk_paths

def has_child_filesystem_or_mount(dev):
    path = dev.get("path")
    if not path:
        return False
    for child in devices:
        if child.get("_parentDiskPath") == path and child.get("path") != path and (child.get("fstype") or child.get("mountpoint")):
            return True
    return False

def device_matches_identity(dev):
    if not identity_tokens:
        return False
    return any(token_matches(dev.get(key), identity_tokens) for key in ("name", "path", "serial", "uuid"))

def safe_candidate(dev, allow_mounted_match=False):
    if not dev or not dev.get("path"):
        return False
    if dev.get("type") not in ("disk", "part"):
        return False
    if is_root_disk_tree(dev):
        return False
    if dev.get("mountpoint") and not (allow_mounted_match and device_matches_identity(dev)):
        return False
    if import_mode in format_modes:
        return dev.get("type") == "disk" and not dev.get("fstype") and not dev.get("mountpoint") and not has_child_filesystem_or_mount(dev)
    return True

def select_single(candidates, reason):
    unique = []
    seen = set()
    for dev in candidates:
        path = dev.get("path")
        if path and path not in seen:
            unique.append(dev)
            seen.add(path)
    if len(unique) == 1:
        return unique[0].get("path")
    if len(unique) > 1:
        paths = ", ".join(dev.get("path") for dev in unique)
        raise SystemExit(f"Ambiguous Storage Service volume device candidates for {reason}: {paths}")
    return None

config = payload.get("config") or {}
inspection = config.get("lastInspection") or config.get("lastinspection") or {}
configured_mount_path = config.get("volumeMountPath") or payload.get("mountPath")
mounted_source = None
if configured_mount_path:
    mounted = run(["findmnt", "-n", "-o", "SOURCE", "--target", configured_mount_path])
    if mounted.returncode == 0 and mounted.stdout.strip():
        mounted_source = mounted.stdout.strip().splitlines()[0]
try:
    resolved_device = resolve_volume_device(
        lsblk(),
        volume_uuid=payload.get("volumeUuid"),
        volume_name=payload.get("volumeName"),
        filesystem_uuid=(inspection.get("filesystemUuid") or inspection.get("fsUuid")
                         or config.get("filesystemUuid") or config.get("fsUuid")),
        mount_source=mounted_source,
        expected_size=expected_size,
        allow_blank_size_fallback=import_mode in format_modes and preparation is None,
    )
except VolumeIdentityError as error:
    raise SystemExit(str(error))
device = resolved_device["devicePath"]
device_info = next((dev for dev in devices if dev.get("path") == device), {})
existing_filesystem = device_info.get("fstype")
requested_filesystem = str(payload.get("filesystem") or existing_filesystem or "xfs").lower()
filesystem = existing_filesystem or requested_filesystem
supported_filesystems = {"xfs", "ext4"}
mount_path = config.get("volumeMountPath") or payload.get("mountPath") or f"/srv/ablestack-storage/volumes/{payload.get('volumeUuid') or payload.get('shareUuid')}"
relative_share_path = str(config.get("relativeSharePath") or payload.get("path") or "").strip().strip("/")
create_directory = bool(config.get("createDirectory", True))
share_uuid = str(payload.get("shareUuid") or payload.get("shareId") or payload.get("volumeUuid") or "unknown")
managed_marker = f"ablestack-storage:{share_uuid}:backing"

def fstab_escape(value):
    return str(value).replace("\\", "\\\\").replace(" ", "\\040").replace("\t", "\\011")

def update_fstab(marker, entry=None):
    fstab_path = "/etc/fstab"
    lines = []
    if os.path.exists(fstab_path):
        with open(fstab_path, "r", encoding="utf-8") as fstab_fp:
            for line in fstab_fp:
                if marker not in line:
                    lines.append(line)
    if entry:
        lines.append(entry.rstrip("\n") + "\n")
    directory = os.path.dirname(fstab_path)
    fd, tmp_path = tempfile.mkstemp(prefix=".fstab.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as tmp_fp:
            tmp_fp.writelines(lines)
        os.replace(tmp_path, fstab_path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)

def daemon_reload():
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)

def blkid_value(path, field):
    result = run(["blkid", "-s", field, "-o", "value", path])
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().splitlines()[0]
    return ""

def persist_backing_mount(device, target_path, fs):
    fs_uuid = blkid_value(device, "UUID")
    if not fs_uuid:
        raise SystemExit(f"Unable to resolve filesystem UUID for Storage Service backing volume {device}")
    fstype = fs or blkid_value(device, "TYPE") or "auto"
    options = "defaults,nofail,x-systemd.device-timeout=30"
    entry = f"UUID={fstab_escape(fs_uuid)} {fstab_escape(target_path)} {fstab_escape(fstype)} {options} 0 2 # {managed_marker}"
    update_fstab(managed_marker, entry)
    daemon_reload()
    return fs_uuid

def format_empty_device():
    fs = str(requested_filesystem or "xfs").lower()
    allowed = {"xfs", "ext4"}
    if fs not in allowed:
        raise SystemExit(f"Unsupported filesystem for empty backing volume format: {fs}")
    tool = f"mkfs.{fs}"
    if not shutil.which(tool):
        raise SystemExit(f"Missing filesystem formatter: {tool}")
    if preparation:
        preparation.before_format(device, fs)
    result = run([tool, "-f", device] if fs == "xfs" else [tool, "-F", device])
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"failed to format {device} as {fs}")
    if preparation:
        preparation.verify_formatted(device, fs)
    return fs

if import_mode != "INSPECT_ONLY":
    if existing_filesystem and import_mode == "FORMAT_EMPTY":
        raise SystemExit(f"Refusing to format {device}: filesystem {existing_filesystem} already exists")
    if existing_filesystem and existing_filesystem not in supported_filesystems:
        raise SystemExit(f"Unsupported filesystem for existing Storage Service backing volume: {existing_filesystem}. Supported filesystems: xfs, ext4")
    if not existing_filesystem and import_mode in format_modes:
        filesystem = format_empty_device()
    elif not filesystem:
        raise SystemExit(f"No filesystem was detected on {device}; format workflows are not part of existing-volume import")
    if filesystem and filesystem not in supported_filesystems:
        raise SystemExit(f"Unsupported filesystem for Storage Service backing volume: {filesystem}. Supported filesystems: xfs, ext4")
    if preparation:
        preparation.stage("MOUNTING")
    os.makedirs(mount_path, exist_ok=True)
    target = run(["findmnt", "-n", "-o", "SOURCE", "--mountpoint", mount_path])
    if target.returncode == 0 and target.stdout.strip():
        mounted_source = target.stdout.strip().splitlines()[0]
        if os.path.realpath(mounted_source) != os.path.realpath(device):
            raise SystemExit(f"Mount path {mount_path} is already used by another device: {mounted_source}")
    desired_mount_path = mount_path
    current = run(["findmnt", "-n", "-o", "TARGET", "--source", device])
    current_targets = [line.strip() for line in current.stdout.splitlines() if line.strip()] if current.returncode == 0 else []
    if desired_mount_path in current_targets:
        mount_path = desired_mount_path
    else:
        mount_result = run(["mount", device, mount_path])
        if mount_result.returncode != 0:
            raise SystemExit(mount_result.stderr.strip() or f"failed to mount {device}")
        mount_path = desired_mount_path
    if preparation:
        preparation.stage("PERSISTING_MOUNT")
    fs_uuid = persist_backing_mount(device, mount_path, filesystem)
else:
    if existing_filesystem and existing_filesystem not in supported_filesystems:
        raise SystemExit(f"Unsupported filesystem for existing Storage Service backing volume: {existing_filesystem}. Supported filesystems: xfs, ext4")
    fs_uuid = blkid_value(device, "UUID")

def resolve_backing_path(volume_mount_path, relative_path, create_missing):
    if not relative_path:
        return volume_mount_path
    cleaned = relative_path.strip().strip("/")
    if not cleaned or cleaned == "." or cleaned.startswith("..") or "/../" in f"/{cleaned}/":
        raise SystemExit(f"Invalid backing volume relative share path: {relative_path}")
    if cleaned == "export":
        raise SystemExit("The legacy /export root cannot be used as a share backing directory")
    if cleaned.startswith("export/") and cleaned.count("/") != 1:
        raise SystemExit(f"Storage Service share path must be a direct child of /export: /{cleaned}")
    root = os.path.realpath(volume_mount_path)
    target = os.path.realpath(os.path.join(volume_mount_path, cleaned))
    if target != root and not target.startswith(root + os.sep):
        raise SystemExit(f"Backing volume relative share path escapes the mounted volume: {relative_path}")
    if os.path.exists(target) and not os.path.isdir(target):
        raise SystemExit(f"Backing volume relative share path exists and is not a directory: {relative_path}")
    if not os.path.exists(target):
        if not create_missing:
            raise SystemExit(f"Backing volume relative share path does not exist: {relative_path}")
        os.makedirs(target, exist_ok=True)
    return target

directory_existed = os.path.isdir(os.path.join(mount_path, relative_share_path.strip("/")))
backing_path = resolve_backing_path(mount_path, relative_share_path, create_directory)

print(json.dumps({
    "success": True,
    "status": "ok",
    "schemaVersion": 2,
    "volumeUuid": payload.get("volumeUuid"),
    "devicePath": device,
    "observedDevicePath": device,
    "matchedBy": resolved_device.get("matchedBy"),
    "serial": resolved_device.get("serial"),
    "filesystem": filesystem,
    "filesystemSupported": filesystem in supported_filesystems,
    "supportsInitialPosixPreservation": True,
    "fsUuid": fs_uuid,
    "filesystemUuid": fs_uuid,
    "observedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    "bootId": open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8").read().strip() if os.path.exists("/proc/sys/kernel/random/boot_id") else "",
    "mountPath": mount_path,
    "volumeMountPath": mount_path,
    "relativeSharePath": relative_share_path,
    "directoryCreated": not directory_existed,
    "configurationOperationId": payload.get("configurationOperationId"),
    "backingPath": backing_path,
    "persistentMount": import_mode != "INSPECT_ONLY",
    "importMode": import_mode,
}, sort_keys=True))
PY
}

volume_detach_prepare() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys
import tempfile

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

volume_uuid = str(payload.get("volumeUuid") or "").strip()
mount_path = str(payload.get("mountPath") or "").strip()

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)

def is_mountpoint(path):
    return bool(path) and run(["findmnt", "-n", "--mountpoint", path]).returncode == 0

def update_fstab(markers):
    fstab_path = "/etc/fstab"
    lines = []
    if os.path.exists(fstab_path):
        with open(fstab_path, "r", encoding="utf-8") as fstab_fp:
            for line in fstab_fp:
                if any(marker and marker in line for marker in markers):
                    continue
                lines.append(line)
    directory = os.path.dirname(fstab_path)
    fd, tmp_path = tempfile.mkstemp(prefix=".fstab.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as tmp_fp:
            tmp_fp.writelines(lines)
        os.replace(tmp_path, fstab_path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)

def daemon_reload():
    if os.path.exists("/bin/systemctl") or os.path.exists("/usr/bin/systemctl"):
        subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)

if mount_path:
    current = run(["findmnt", "-R", "-n", "-o", "TARGET", "--target", mount_path])
    targets = sorted([line.strip() for line in current.stdout.splitlines() if line.strip()], key=len, reverse=True) if current.returncode == 0 else []
    for target in targets:
        unmount = run(["umount", target])
        if unmount.returncode != 0:
            raise SystemExit(unmount.stderr.strip() or f"failed to unmount {target}")

markers = []
if volume_uuid:
    markers.append(volume_uuid)
if mount_path:
    markers.append(mount_path)
update_fstab(markers)
daemon_reload()
print(json.dumps({
    "success": True,
    "status": "ok",
    "volumeUuid": volume_uuid,
    "mountPath": mount_path,
    "detachedInGuest": True,
    "dataDeleted": False
}, sort_keys=True))
PY
}

volume_rescan() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

sys.path.insert(0, __import__("os").environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from volume_identity import VolumeIdentityError, resolve_volume_device  # noqa: E402

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

def run(args, timeout=60):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)

def settle():
    if os.path.exists("/usr/bin/udevadm") or os.path.exists("/bin/udevadm"):
        subprocess.run(["udevadm", "settle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=60)

def lsblk():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"], timeout=30)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "lsblk failed")
    return json.loads(result.stdout).get("blockdevices", [])

def walk(devices, parent_disk=None):
    for dev in devices:
        disk = dev if dev.get("type") == "disk" else parent_disk
        dev["_parentDisk"] = disk
        yield dev
        for child in dev.get("children") or []:
            yield from walk([child], disk)

def compact(value):
    return "".join(ch for ch in str(value or "").lower() if ch.isalnum())

def token_matches(value, tokens):
    candidate = compact(value)
    if not candidate:
        return False
    for token in tokens:
        if len(token) >= 8 and (token in candidate or candidate in token):
            return True
    return False

def resolve_disk(device_path):
    devices = list(walk(lsblk()))
    identities = [
        ("volumeUuid", compact(payload.get("volumeUuid"))),
        ("volumeName", compact(payload.get("volumeName")))
    ]
    identities = [(kind, token) for kind, token in identities if token]
    root_disks = {
        dev.get("_parentDisk", {}).get("name")
        for dev in devices
        if dev.get("_parentDisk") and (dev.get("mountpoint") in ("/", "/boot", "/boot/efi") or dev.get("fstype") == "swap")
    }
    if device_path:
        real_path = os.path.realpath(device_path)
        for dev in devices:
            if os.path.realpath(dev.get("path") or "") == real_path and dev.get("_parentDisk"):
                disk = dev["_parentDisk"]
                if disk.get("name") not in root_disks:
                    return {
                        "name": disk.get("name"),
                        "path": disk.get("path") or f"/dev/{disk.get('name')}",
                        "matchedBy": "devicePath"
                    }
    candidates = {}
    for dev in devices:
        disk = dev.get("_parentDisk") or dev
        name = disk.get("name")
        if not name or name in root_disks or disk.get("type") != "disk":
            continue
        for identity_kind, token in identities:
            if any(token_matches(dev.get(key), [token]) for key in ("name", "path", "serial", "uuid")):
                candidates[name] = {
                    "name": name,
                    "path": disk.get("path") or f"/dev/{name}",
                    "matchedBy": identity_kind
                }
                break
    if not candidates:
        raise SystemExit(
            "Unable to identify the exact attached Storage Service volume device for "
            f"{payload.get('volumeUuid') or payload.get('volumeName') or 'unknown volume'}"
        )
    if len(candidates) != 1:
        raise SystemExit("Ambiguous attached Storage Service volume mapping: " + ", ".join(sorted(candidates)))
    return next(iter(candidates.values()))

def rescan_disk(target):
    name = target.get("name")
    rescan_path = f"/sys/block/{name}/device/rescan"
    if not name or not os.path.exists(rescan_path):
        raise SystemExit(f"Rescan path is unavailable for the resolved Storage Service volume device: {name}")
    with open(rescan_path, "w", encoding="utf-8") as rescan_fp:
        rescan_fp.write("1\n")
    return {"disk": name, "devicePath": target.get("path"), "matchedBy": target.get("matchedBy"), "rescanned": True}

settle()
config = payload.get("config") or {}
inspection = config.get("lastInspection") or config.get("lastinspection") or {}
mount_path = payload.get("mountPath") or config.get("volumeMountPath") or inspection.get("volumeMountPath")
mount_source = None
if mount_path:
    mounted = run(["findmnt", "-n", "-o", "SOURCE", "--target", mount_path], timeout=10)
    if mounted.returncode == 0 and mounted.stdout.strip():
        mount_source = mounted.stdout.strip().splitlines()[0]
try:
    resolved = resolve_volume_device(
        lsblk(),
        volume_uuid=payload.get("volumeUuid"),
        volume_name=payload.get("volumeName"),
        filesystem_uuid=(inspection.get("filesystemUuid") or inspection.get("fsUuid")
                         or config.get("filesystemUuid") or config.get("fsUuid")),
        mount_source=mount_source,
    )
except VolumeIdentityError as error:
    raise SystemExit(str(error))
target = {
    "name": resolved.get("diskName"),
    "path": resolved.get("diskPath"),
    "matchedBy": resolved.get("matchedBy"),
}
result = rescan_disk(target)
settle()
expected_size = int(payload.get("volumeSizeBytes") or 0)
actual_size = 0
deadline = time.time() + 30
while time.time() < deadline:
    observed = run(["blockdev", "--getsize64", target.get("path")], timeout=10)
    if observed.returncode == 0 and observed.stdout.strip().isdigit():
        actual_size = int(observed.stdout.strip())
        if expected_size <= 0 or actual_size >= expected_size:
            break
    time.sleep(1)
    settle()
if expected_size > 0 and actual_size < expected_size:
    raise SystemExit(
        f"Storage Service volume rescan did not expose the requested size on {target.get('path')}: "
        f"expected at least {expected_size} bytes, observed {actual_size} bytes"
    )

print(json.dumps({
    "success": True,
    "status": "ok",
    "volumeUuid": payload.get("volumeUuid"),
    "volumeName": payload.get("volumeName"),
    "volumeSizeBytes": expected_size,
    "actualSizeBytes": actual_size,
    "devicePath": target.get("path"),
    "observedDevicePath": target.get("path"),
    "matchedBy": target.get("matchedBy"),
    "observedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    "bootId": open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8").read().strip() if os.path.exists("/proc/sys/kernel/random/boot_id") else "",
    "rescans": [result]
}, sort_keys=True))
PY
}

filesystem_resize() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import datetime
import json
import os
import subprocess
import sys

sys.path.insert(0, __import__("os").environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from volume_identity import VolumeIdentityError, resolve_volume_device  # noqa: E402

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)

def lsblk():
    result = run(["lsblk", "-J", "-b", "-o", "NAME,KNAME,PATH,TYPE,SIZE,FSTYPE,UUID,SERIAL,MOUNTPOINT"])
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "Unable to inspect attached Storage Service volumes")
    return json.loads(result.stdout).get("blockdevices") or []

mount_path = payload.get("path")
config = payload.get("config") or {}
inspection = config.get("lastInspection") or {}
filesystem = payload.get("filesystem") or inspection.get("filesystem")
mount_source = None

if mount_path:
    source_result = run(["findmnt", "-n", "-o", "SOURCE,FSTYPE", "--target", mount_path])
    if source_result.returncode == 0 and source_result.stdout.strip():
        parts = source_result.stdout.strip().split()
        if parts:
            mount_source = parts[0]
        if len(parts) > 1:
            filesystem = filesystem or parts[1]

try:
    resolved = resolve_volume_device(
        lsblk(),
        volume_uuid=payload.get("volumeUuid"),
        volume_name=payload.get("volumeName"),
        filesystem_uuid=(inspection.get("filesystemUuid") or inspection.get("fsUuid")
                         or config.get("filesystemUuid") or config.get("fsUuid")),
        mount_source=mount_source,
        expected_size=payload.get("volumeSizeBytes"),
        allow_blank_size_fallback=False,
    )
except VolumeIdentityError as exc:
    raise SystemExit(str(exc))

device = resolved.get("devicePath")
filesystem = filesystem or resolved.get("filesystem")
if not device:
    raise SystemExit("Unable to resolve the exact mounted device for filesystem resize")

if filesystem == "xfs":
    if not mount_path:
        raise SystemExit("XFS resize requires a mounted path")
    result = run(["xfs_growfs", mount_path])
elif filesystem in ("ext2", "ext3", "ext4"):
    result = run(["resize2fs", device])
else:
    raise SystemExit(f"Unsupported filesystem for resize: {filesystem}")

if result.returncode != 0:
    raise SystemExit(result.stderr.strip() or result.stdout.strip() or "filesystem resize failed")

print(json.dumps({
    "success": True,
    "status": "ok",
    "observedDevicePath": device,
    "matchedBy": resolved.get("matchedBy"),
    "observedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "bootId": open("/proc/sys/kernel/random/boot_id", "r", encoding="utf-8").read().strip()
        if os.path.exists("/proc/sys/kernel/random/boot_id") else "",
    "filesystem": filesystem,
    "filesystemUuid": resolved.get("filesystemUuid"),
    "mountPath": mount_path,
    "quotaBytes": payload.get("quotaBytes"),
    "volumeSizeGb": payload.get("volumeSizeGb"),
}, sort_keys=True))
PY
}

nvmeof_prepare() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import shutil
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

engine = str(payload.get("engine") or "KERNEL_NVMET").upper()
transport = str(payload.get("transport") or "tcp").lower()
if engine == "SPDK":
    print(json.dumps({
        "success": False,
        "status": "PREPARATION_REQUIRED",
        "engine": engine,
        "transport": transport,
        "vmRuntimeCapabilityRequired": True,
    }, sort_keys=True))
    raise SystemExit(1)
if engine != "KERNEL_NVMET":
    raise SystemExit(f"Unsupported NVMe-oF engine: {engine}")
if transport != "tcp":
    raise SystemExit(f"Unsupported NVMe-oF transport: {transport}")

for module in ("configfs", "nvmet", "nvmet-tcp"):
    subprocess.run(["modprobe", module], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

commands = {
    "nvme": shutil.which("nvme") is not None,
    "nvmetcli": shutil.which("nvmetcli") is not None,
}
modules = {
    "configfs": os.path.isdir("/sys/kernel/config"),
    "nvmet": os.path.isdir("/sys/kernel/config/nvmet"),
}
status = "ok" if modules["configfs"] and modules["nvmet"] else "missing_prerequisites"
print(json.dumps({
    "success": status == "ok",
    "status": status,
    "engine": engine,
    "transport": transport,
    "commands": commands,
    "modules": modules,
    "validateOnly": bool(payload.get("validateOnly")),
}, sort_keys=True))
if status != "ok":
    raise SystemExit(1)
PY
}

apply_nfs_exports() {
  local payload_file="$1"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now nfs-server >/dev/null 2>&1 || systemctl disable --now nfs-kernel-server >/dev/null 2>&1 || true
    systemctl disable --now nfs-ganesha.service >/dev/null 2>&1 || true
    systemctl reset-failed nfs-ganesha.service >/dev/null 2>&1 || true
  fi
  exportfs -ua >/dev/null 2>&1 || true

  python3 - "$payload_file" <<'PY'
import json
import ipaddress
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import socket
import zlib

sys.path.insert(0, os.environ.get("ABLESTACK_STORAGE_HELPER_ROOT", "/usr/local/lib/ablestack-storage"))
from configuration_transaction import nfs_posix_apply_config, NfsIdentityMapping
payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

exports_dir = "/etc/exports.d"
quota_dir = "/etc/ablestack-storage"
alias_state_path = os.path.join(quota_dir, "nfs-export-aliases.json")
ganesha_conf_dir = "/etc/ganesha/ablestack-storage"
ganesha_run_dir = "/run/ablestack-storage/ganesha"
ganesha_default_run_dir = "/run/ganesha"
ganesha_default_pid_path = os.path.join(ganesha_default_run_dir, "ganesha.pid")
nfs_probe_root = "/run/ablestack-storage/nfs-probe"
os.makedirs(exports_dir, exist_ok=True)
os.makedirs(quota_dir, exist_ok=True)
os.makedirs(ganesha_conf_dir, exist_ok=True)
os.makedirs(ganesha_run_dir, exist_ok=True)
os.makedirs(ganesha_default_run_dir, exist_ok=True)
os.makedirs(nfs_probe_root, exist_ok=True)

def remove_legacy_root_export():
    exports_path = "/etc/exports"
    if not os.path.exists(exports_path):
        return
    kept = []
    changed = False
    with open(exports_path, "r", encoding="utf-8") as exports_fp:
        for line in exports_fp:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and stripped.split()[0].rstrip("/") == "/export":
                changed = True
                continue
            kept.append(line)
    if changed:
        with open(exports_path, "w", encoding="utf-8") as exports_fp:
            exports_fp.writelines(kept)

def truth(config, key, default):
    value = config.get(key, default) if isinstance(config, dict) else default
    return bool(value)

def int_config(config, key):
    if not isinstance(config, dict) or config.get(key) in (None, ""):
        return None
    try:
        value = int(config.get(key))
    except Exception as exc:
        raise ValueError(f"invalid integer NFS option {key}: {config.get(key)}") from exc
    if value < 0 or value > 65535:
        raise ValueError(f"NFS option {key} must be between 0 and 65535")
    return value

def mode_config(config):
    if not isinstance(config, dict) or not config.get("mode"):
        return None
    value = str(config.get("mode")).strip()
    if not re.match(r"^0?[0-7]{3,4}$", value):
        raise ValueError(f"invalid NFS directory mode: {value}")
    return int(value, 8)

def effective_nfs_export_config(config):
    result = dict(config or {})
    read_only = truth(result, "readOnly", False)
    root_squash = truth(result, "rootSquash", True)
    if read_only or not root_squash:
        return result
    if result.get("anonUid") in (None, ""):
        result["anonUid"] = 65534
    if result.get("anonGid") in (None, ""):
        result["anonGid"] = 65534
    if result.get("posixPolicy") == "PRESERVE_EXISTING_INITIAL":
        return result
    if result.get("ownerUid") in (None, ""):
        result["ownerUid"] = result.get("anonUid")
    if result.get("ownerGid") in (None, ""):
        result["ownerGid"] = result.get("anonGid")
    if result.get("mode") in (None, ""):
        result["mode"] = "0775"
    if result.get("recursivePermission") in (None, ""):
        result["recursivePermission"] = False
    if result.get("posixPolicy") in (None, ""):
        result["posixPolicy"] = "ANONYMOUS_WRITE"
    return result

def safe_uuid(value):
    value = str(value or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", value):
        raise ValueError(f"invalid export uuid: {value}")
    return value

def safe_export_root_name(value, path):
    value = str(value or "").strip().strip("/")
    if not value and path:
        value = os.path.basename(str(path).rstrip("/"))
    if not value or value in (".", ".."):
        raise ValueError("NFS export name is required")
    value = re.sub(r"[^A-Za-z0-9_.-]+", "-", value)
    value = value.strip(".-")
    if not value:
        raise ValueError("NFS export name is invalid")
    return value

def nfs_export_principal(value):
    value = str(value or "").strip()
    if value in ("0.0.0.0/0", "::/0"):
        return "*"
    if any(ch.isspace() for ch in value):
        raise ValueError(f"invalid NFS export principal: {value}")
    return value

def ganesha_clients(value):
    rendered = nfs_export_principal(value)
    return "*" if rendered == "*" else rendered

def ganesha_squash(all_squash, root_squash):
    if all_squash:
        return "All_Squash"
    return "Root_Squash" if root_squash else "No_Root_Squash"

def ganesha_access(permission, read_only):
    return "RW" if permission == "READ_WRITE" and not read_only else "RO"

def quote_ganesha(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'

def ganesha_raw_literal(value, label):
    token = str(value or "").strip()
    if not token:
        raise ValueError(f"{label} is required")
    if re.search(r"\s", token) or any(ch in token for ch in ['"', "'", ";", "{", "}"]):
        raise ValueError(f"invalid {label}: {token}")
    return token


def ganesha_bind_addr(value):
    return ganesha_raw_literal(value or "0.0.0.0", "Ganesha bind address")


def ganesha_client_list(value):
    rendered = ganesha_clients(value)
    tokens = [item.strip() for item in str(rendered).split(",") if item.strip()]
    if not tokens:
        raise ValueError("Ganesha client list is required")
    return ", ".join(ganesha_raw_literal(item, "Ganesha client") for item in tokens)

def nfs_protocols_for_mode(protocol_mode):
    mode = str(protocol_mode or "V4_ONLY").strip().upper()
    return "3,4" if mode == "V3V4_DUAL" else "4"

def nfs_protocol_mode_from_content(content):
    if not content:
        return "V4_ONLY"
    for match in re.finditer(r"Protocols\s*=\s*([^;]+);", content, re.I):
        value = re.sub(r"\s+", "", match.group(1))
        if "3" in value and "4" in value:
            return "V3V4_DUAL"
        if value == "4":
            return "V4_ONLY"
    return "V4_ONLY"

GANESHA_EXPORT_ID_MIN = 1000
GANESHA_EXPORT_ID_MAX = 65535

def export_id(value):
    span = GANESHA_EXPORT_ID_MAX - GANESHA_EXPORT_ID_MIN + 1
    return GANESHA_EXPORT_ID_MIN + (zlib.crc32(str(value).encode("utf-8")) % span)

def assign_ganesha_export_ids(exports):
    span = GANESHA_EXPORT_ID_MAX - GANESHA_EXPORT_ID_MIN + 1
    used = set()
    assigned = []
    for index, export in enumerate(exports or []):
        rendered = dict(export)
        source = rendered.get("uuid") or rendered.get("name") or rendered.get("path") or index
        candidate = export_id(source)
        for _ in range(span):
            if candidate not in used:
                used.add(candidate)
                rendered["id"] = candidate
                assigned.append(rendered)
                break
            candidate += 1
            if candidate > GANESHA_EXPORT_ID_MAX:
                candidate = GANESHA_EXPORT_ID_MIN
        else:
            raise RuntimeError("No available Ganesha Export_Id values for Storage Service NFS endpoint")
    return assigned

def endpoint_key(ip, port):
    safe_ip = re.sub(r"[^A-Za-z0-9_.-]+", "_", str(ip or "0.0.0.0"))
    return f"{safe_ip}_{int(port)}"

def rpcbind_active():
    if not shutil.which("systemctl"):
        return False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "is-active", "--quiet", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return True
        except Exception:
            continue
    return False

def ensure_rpcbind_started():
    if not shutil.which("systemctl"):
        return False
    started = False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "start", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            started = started or result.returncode == 0
        except Exception:
            continue
    return rpcbind_active() or started

def nfs_export_endpoint_ips(export_config, default_ip):
    mode = str(export_config.get("endpointMode") or export_config.get("endpointmode") or "").strip().upper()
    raw_ips = export_config.get("listenIps") if "listenIps" in export_config else export_config.get("listenips")
    if isinstance(raw_ips, list):
        ips = [str(item).strip() for item in raw_ips if str(item).strip()]
    elif raw_ips:
        ips = [str(item).strip() for item in str(raw_ips).split(",") if str(item).strip()]
    else:
        ips = []
    if mode == "SELECTED":
        if not ips:
            return [default_ip or "0.0.0.0"]
        return ips
    if not mode and ips:
        return ips
    return [default_ip or "0.0.0.0"]

def nfs_export_listener_ports(export_config, default_port, protocol_mode):
    if str(protocol_mode or "V4_ONLY").strip().upper() == "V3V4_DUAL":
        return [2049]
    raw_ports = None
    for key in ("listenerGroupPorts", "listenergroupports", "listenerPorts", "listenerports"):
        if key in export_config:
            raw_ports = export_config.get(key)
            break
    if isinstance(raw_ports, list):
        values = raw_ports
    elif raw_ports is None or str(raw_ports).strip() == "":
        values = []
    else:
        values = str(raw_ports).split(",")
    ports = []
    seen = set()
    for value in values:
        try:
            port = int(str(value).strip())
        except Exception:
            continue
        if 1 <= port <= 65535 and port not in seen:
            seen.add(port)
            ports.append(port)
    if not ports:
        try:
            fallback = int(default_port or 2049)
        except Exception:
            fallback = 2049
        ports.append(fallback)
    return ports

def cleanup_legacy_kernel_exports(managed_files):
    for name in os.listdir(exports_dir):
        if name.startswith("ablestack-") and name.endswith(".exports"):
            full_path = os.path.join(exports_dir, name)
            if full_path not in managed_files:
                managed_files.add(full_path)
            with open(full_path, "w", encoding="utf-8"):
                pass

def process_cmdline(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as cmd_fp:
            return cmd_fp.read().replace(b"\x00", b" ").decode("utf-8", "replace").strip()
    except Exception:
        return ""


def process_exists(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except Exception:
        return False


def managed_ganesha_process(pid):
    cmdline = process_cmdline(pid)
    return "ganesha.nfsd" in cmdline and ganesha_conf_dir in cmdline


def tail_file(path, limit=20):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fp:
            lines = fp.readlines()
        return "".join(lines[-limit:]).strip()
    except Exception:
        return ""



def cleanup_default_ganesha_pid(stale_only=True):
    try:
        with open(ganesha_default_pid_path, "r", encoding="utf-8") as pid_fp:
            pid = int(pid_fp.read().strip())
    except FileNotFoundError:
        return
    except Exception:
        try:
            os.unlink(ganesha_default_pid_path)
        except Exception:
            pass
        return
    if process_exists(pid):
        if stale_only:
            return
        cmdline = process_cmdline(pid)
        if "ganesha.nfsd" in cmdline and ganesha_conf_dir not in cmdline:
            try:
                os.kill(pid, 15)
            except Exception:
                return
        else:
            return
    deadline = time.time() + 5
    while process_exists(pid) and time.time() < deadline:
        time.sleep(0.2)
    if not process_exists(pid):
        try:
            os.unlink(ganesha_default_pid_path)
        except FileNotFoundError:
            pass
        except Exception:
            pass


def ensure_ganesha_runtime_dirs():
    os.makedirs(ganesha_conf_dir, exist_ok=True)
    os.makedirs(ganesha_run_dir, exist_ok=True)
    os.makedirs(ganesha_default_run_dir, exist_ok=True)
    cleanup_default_ganesha_pid(stale_only=True)


def terminate_pid(pid):
    try:
        pid = int(pid)
    except Exception:
        return
    if not managed_ganesha_process(pid):
        return
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        return
    except Exception:
        return
    deadline = time.time() + 5
    while time.time() < deadline:
        if not os.path.exists(f"/proc/{pid}"):
            return
        time.sleep(0.2)
    try:
        os.kill(pid, 9)
    except Exception:
        pass


def stop_default_ganesha_service():
    if shutil.which("systemctl"):
        for unit in ("nfs-ganesha.service",):
            subprocess.run(["systemctl", "disable", "--now", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)
            subprocess.run(["systemctl", "reset-failed", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)
    try:
        with open(ganesha_default_pid_path, "r", encoding="utf-8") as pid_fp:
            pid = int(pid_fp.read().strip())
        cmdline = process_cmdline(pid)
        if "ganesha.nfsd" in cmdline and ganesha_conf_dir not in cmdline:
            cleanup_default_ganesha_pid(stale_only=False)
    except Exception:
        cleanup_default_ganesha_pid(stale_only=True)



def stop_ganesha_endpoints(active_keys=None):
    active_keys = set(active_keys or [])
    unit_prefix = "ablestack-storage-ganesha@"
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        try:
            proc = subprocess.run(["systemctl", "list-units", "--all", "--plain", "--no-legend", f"{unit_prefix}*.service"],
                                  text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False, timeout=20)
            for line in proc.stdout.splitlines():
                unit = line.split()[0] if line.split() else ""
                if not unit.startswith(unit_prefix) or not unit.endswith(".service"):
                    continue
                key = unit[len(unit_prefix):-len(".service")]
                if key in active_keys:
                    continue
                subprocess.run(["systemctl", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=30)
                subprocess.run(["systemctl", "reset-failed", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=20)
        except Exception:
            pass
    for name in os.listdir(ganesha_run_dir):
        if not name.endswith(".pid"):
            continue
        pid_path = os.path.join(ganesha_run_dir, name)
        key = name[:-4]
        if key in active_keys:
            continue
        try:
            with open(pid_path, "r", encoding="utf-8") as pid_fp:
                pid = int(pid_fp.read().strip())
            terminate_pid(pid)
        except Exception:
            pass
        try:
            os.unlink(pid_path)
        except Exception:
            pass

def render_ganesha_export(rendered):
    protocol_mode = str(rendered.get('protocolMode') or 'V4_ONLY').strip().upper()
    anonymous_uid = rendered.get("anonUid")
    anonymous_gid = rendered.get("anonGid")
    lines = [
        "EXPORT {",
        f"    Export_Id = {rendered['id']};",
        f"    Path = {quote_ganesha(rendered['path'])};",
        f"    Pseudo = {quote_ganesha(rendered['pseudo'])};",
        f"    Protocols = {nfs_protocols_for_mode(protocol_mode)};",
        "    Transports = TCP;",
        "    Access_Type = None;",
        "    Squash = Root_Squash;",
        "    SecType = sys;",
        "    FSAL {",
        "        Name = VFS;",
        "    }",
    ]
    if anonymous_uid is not None:
        lines.append(f"    Anonymous_uid = {int(anonymous_uid)};")
    if anonymous_gid is not None:
        lines.append(f"    Anonymous_gid = {int(anonymous_gid)};")
    for client in rendered["clients"]:
        lines.extend([
            "    CLIENT {",
            f"        Clients = {ganesha_client_list(client['clients'])};",
            f"        Access_Type = {client['access']};",
            f"        Squash = {client['squash']};",
        ])
        if client.get("anonUid") is not None:
            lines.append(f"        Anonymous_uid = {int(client['anonUid'])};")
        if client.get("anonGid") is not None:
            lines.append(f"        Anonymous_gid = {int(client['anonGid'])};")
        lines.append("    }")
    lines.append("}")
    return "\n".join(lines)

def write_ganesha_configs(endpoint_exports, port):
    configs = []
    staged = []
    for (ip, endpoint_port), exports in sorted(endpoint_exports.items()):
        if not exports:
            continue
        endpoint_mode = "V3V4_DUAL" if any(str(export.get("protocolMode") or "V4_ONLY").strip().upper() == "V3V4_DUAL" for export in exports) else "V4_ONLY"
        key = endpoint_key(ip, endpoint_port)
        conf_path = os.path.join(ganesha_conf_dir, f"{key}.conf")
        content = [
            "NFS_Core_Param {",
            f"    NFS_Port = {int(endpoint_port)};",
            f"    Bind_addr = {ganesha_bind_addr(ip)};",
            f"    Protocols = {nfs_protocols_for_mode(endpoint_mode)};",
        ]
        if endpoint_mode == "V3V4_DUAL":
            content.append("    mount_path_pseudo = true;")
        else:
            content.extend([
                "    Transports = TCP;",
                "    Enable_NLM = false;",
                "    Enable_RQUOTA = false;",
            ])
        content.extend([
            "}",
            "NFSV4 {",
            "    Grace_Period = 5;",
            *NfsIdentityMapping.lines(payload),
            "}",
            "EXPORT_DEFAULTS {",
            "    Access_Type = None;",
            f"    Protocols = {nfs_protocols_for_mode(endpoint_mode)};",
            "    Transports = TCP;",
            "    SecType = sys;",
            "}",
        ])
        rendered_exports = assign_ganesha_export_ids(exports)
        content.extend(render_ganesha_export(export) for export in rendered_exports)
        staged.append((conf_path, "\n\n".join(content) + "\n"))
        configs.append((key, conf_path, ip, endpoint_port, endpoint_mode))
    staged_paths = []
    try:
        for conf_path, content in staged:
            fd, tmp_path = tempfile.mkstemp(prefix=".candidate-", dir=ganesha_conf_dir)
            with os.fdopen(fd, "w", encoding="utf-8") as conf_fp:
                conf_fp.write(content)
                conf_fp.flush()
                os.fsync(conf_fp.fileno())
            staged_paths.append((tmp_path, conf_path))
        for tmp_path, conf_path in staged_paths:
            os.replace(tmp_path, conf_path)
        desired_paths = {path for path, _ in staged}
        for name in os.listdir(ganesha_conf_dir):
            path = os.path.join(ganesha_conf_dir, name)
            if name.endswith(".conf") and path not in desired_paths:
                os.unlink(path)
    finally:
        for tmp_path, _ in staged_paths:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
    return configs


def start_ganesha_endpoints(configs):
    stop_default_ganesha_service()
    if not configs:
        stop_ganesha_endpoints()
        NfsIdentityMapping().complete([], payload)
        return []
    ensure_ganesha_runtime_dirs()
    ganesha = shutil.which("ganesha.nfsd")
    if not ganesha:
        raise RuntimeError("nfs-ganesha is required for Storage Service NFS endpoint isolation")
    if not ensure_rpcbind_started():
        raise RuntimeError("rpcbind is required for Storage Service NFS Ganesha runtime")
    active_keys = {key for key, _conf_path, _ip, _port, _mode in configs}
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=30)
    stop_ganesha_endpoints(active_keys=active_keys)
    ensure_ganesha_runtime_dirs()
    started = []
    for key, conf_path, ip, port, mode in configs:
        log_path = os.path.join(ganesha_run_dir, f"{key}.log")
        pid_path = os.path.join(ganesha_run_dir, f"{key}.pid")
        try:
            if os.path.exists(pid_path):
                os.unlink(pid_path)
        except Exception:
            pass
        try:
            open(log_path, "ab").close()
        except Exception:
            pass
        if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
            unit = f"ablestack-storage-ganesha@{key}.service"
            result = subprocess.run(["systemctl", "restart", unit], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=30)
            if result.returncode != 0:
                item_tail = tail_file(log_path, 80)
                raise RuntimeError(f"failed to start {unit}: {(result.stderr or result.stdout).strip()}{': ' + item_tail if item_tail else ''}")
            pid = 0
            deadline_pid = time.time() + 10
            while time.time() < deadline_pid:
                show = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", unit], text=True,
                                      stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False, timeout=10)
                try:
                    pid = int(show.stdout.strip() or "0")
                except Exception:
                    pid = 0
                if pid > 0:
                    try:
                        with open(pid_path, "w", encoding="utf-8") as pid_fp:
                            pid_fp.write(str(pid))
                    except Exception:
                        pass
                    break
                time.sleep(0.2)
            started.append((key, conf_path, ip, int(port), mode, pid, log_path))
        else:
            log_fp = open(log_path, "wb")
            proc = subprocess.Popen([ganesha, "-F", "-p", pid_path, "-L", log_path, "-f", conf_path],
                                    stdin=subprocess.DEVNULL, stdout=log_fp, stderr=log_fp,
                                    start_new_session=True, close_fds=True)
            with open(pid_path, "w", encoding="utf-8") as pid_fp:
                pid_fp.write(str(proc.pid))
            started.append((key, conf_path, ip, int(port), mode, proc.pid, log_path))
    runtime = []
    deadline = time.time() + 15
    for key, conf_path, ip, port, mode, pid, log_path in started:
        item = {
            "key": key,
            "listenIp": ip,
            "port": port,
            "protocolMode": mode,
            "pid": pid,
            "logPath": log_path,
            "processRunning": managed_ganesha_process(pid) if pid else False,
            "listening": False,
        }
        candidate_ip = str(ip or "127.0.0.1").strip()
        if candidate_ip in ("0.0.0.0", "::"):
            candidate_ip = "127.0.0.1"
        last_error = ""
        while time.time() < deadline:
            item["processRunning"] = managed_ganesha_process(pid) if pid else False
            if pid and not process_exists(pid):
                item["error"] = "managed ganesha process exited"
                failed_conf_path = conf_path + ".failed"
                try:
                    shutil.copyfile(conf_path, failed_conf_path)
                    item["failedConfPath"] = failed_conf_path
                    conf_tail = tail_file(failed_conf_path, 80)
                    if conf_tail:
                        item["confTail"] = conf_tail
                except Exception:
                    pass
                log_tail = tail_file(log_path, 80)
                if log_tail:
                    item["logTail"] = log_tail
                break
            try:
                with socket.create_connection((candidate_ip, port), timeout=1.0):
                    item["listening"] = True
                    break
            except Exception as exc:
                last_error = str(exc)
                time.sleep(0.5)
        if item.get("listening"):
            managed_deadline = time.time() + 3
            while pid and not managed_ganesha_process(pid) and process_exists(pid) and time.time() < managed_deadline:
                time.sleep(0.2)
            item["processRunning"] = managed_ganesha_process(pid) if pid else False
            try:
                with open(conf_path, "r", encoding="utf-8", errors="replace") as conf_fp:
                    conf_body = conf_fp.read()
            except Exception:
                conf_body = ""
            if "EXPORT {" in conf_body:
                log_tail = tail_file(log_path, 80)
                rejection_markers = (
                    "No export entries found",
                    "out of range",
                    "invalid param value",
                    "errors found block EXPORT",
                    "Expected an IP address",
                    "Could not parse",
                    "Error while parsing",
                )
                if any(marker in log_tail for marker in rejection_markers):
                    item["listening"] = False
                    item["error"] = "managed ganesha config was rejected"
                    item["logTail"] = log_tail
                    failed_conf_path = conf_path + ".failed"
                    try:
                        shutil.copyfile(conf_path, failed_conf_path)
                        item["failedConfPath"] = failed_conf_path
                    except Exception:
                        pass
        if item.get("listening") and not item.get("processRunning"):
            item["listening"] = False
            item["processRunning"] = False
            item["error"] = "endpoint port is open but the managed ganesha process is not confirmed"
        if not item["listening"]:
            item["error"] = item.get("error") or last_error or "endpoint did not begin listening"
            log_tail = tail_file(log_path, 80)
            if log_tail:
                item["logTail"] = log_tail
        runtime.append(item)
    failures = [item for item in runtime if not item.get("listening")]
    if failures:
        stop_ganesha_endpoints()
        details = ", ".join(f"{item.get('listenIp')}:{item.get('port')} ({item.get('error') or 'not listening'}{': ' + item.get('logTail') if item.get('logTail') else ''})" for item in failures)
        raise RuntimeError(f"nfs-ganesha endpoints failed to start: {details}")
    for item in runtime:
        NfsIdentityMapping().publish(item["key"], os.path.join(ganesha_conf_dir, item["key"] + ".conf"), item["pid"], payload)
    NfsIdentityMapping().complete([item["key"] for item in runtime], payload)
    return runtime

def probe_nfs_export_visibility(runtime, endpoint_exports):
    def local_global_ipv4_addresses():
        proc = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
        addresses = []
        if proc.returncode != 0:
            raise RuntimeError("NFS_LOCAL_ADDRESS_OBSERVATION_UNAVAILABLE")
        for line in proc.stdout.splitlines():
            parts = line.split()
            if "inet" not in parts:
                continue
            try:
                inet_value = parts[parts.index("inet") + 1]
                address = str(ipaddress.ip_interface(inet_value).ip)
            except Exception:
                continue
            if address not in addresses:
                addresses.append(address)
        if not addresses:
            raise RuntimeError("NFS_LOCAL_ADDRESS_OBSERVATION_UNAVAILABLE")
        return addresses

    def client_tokens(export):
        tokens = []
        for client in export.get("clients") or []:
            for token in str(client.get("clients") or "").split(","):
                token = token.strip()
                if token:
                    tokens.append(token)
        return tokens

    def address_matches_client(address, client):
        client = str(client or "").strip()
        if client in ("*", "0.0.0.0/0", "::/0"):
            return True
        try:
            probe_address = ipaddress.ip_address(address)
        except Exception:
            return False
        try:
            if "/" in client:
                return probe_address in ipaddress.ip_network(client, strict=False)
            return probe_address == ipaddress.ip_address(client)
        except Exception:
            return False

    def address_allowed_by_export(address, export):
        tokens = client_tokens(export)
        if not tokens:
            return False
        return any(address_matches_client(address, token) for token in tokens)

    def select_mount_host(listen_ip, export, local_addresses):
        host = str(listen_ip or "").strip()
        if host not in ("", "0.0.0.0", "::") and address_allowed_by_export(host, export):
            return host, None
        for address in local_addresses:
            if host not in ("", "0.0.0.0", "::") and address != host:
                continue
            if address_allowed_by_export(address, export):
                return address, None
        if any(token in ("*", "0.0.0.0/0", "::/0") for token in client_tokens(export)):
            return "127.0.0.1", None
        clients = ", ".join(client_tokens(export)) or "none"
        return None, f"no local IPv4 address is allowed by export clients: {clients}"

    def ip_clients_only(export):
        tokens = client_tokens(export)
        if not tokens:
            return False
        try:
            for token in tokens:
                ipaddress.ip_network(token, strict=False)
            return True
        except ValueError:
            return False

    failures = []
    local_addresses = local_global_ipv4_addresses()
    for endpoint in runtime:
        listen_ip = str(endpoint.get("listenIp") or "").strip()
        port = int(endpoint.get("port") or 0)
        exports = endpoint_exports.get((listen_ip, port), []) or []
        endpoint["probeSuccess"] = True
        endpoint["exportsVisible"] = True
        endpoint["probeResults"] = []
        endpoint["probeComplete"] = True
        if not exports:
            continue

        endpoint_success = True
        for export in exports:
            export_mode = str(export.get("protocolMode") or "V4_ONLY").strip().upper()
            export_name = str(export.get("name") or export.get("path") or "export").strip() or "export"
            host, host_error = select_mount_host(listen_ip, export, local_addresses)
            probe_specs = []
            if export_mode == "V3V4_DUAL":
                probe_specs.append({
                    "mode": "NFSv4",
                    "mountType": "nfs4",
                    "target": f"{host}:{export.get('pseudo')}",
                    "options": f"vers=4.1,proto=tcp,port={port},ro,soft,timeo=1,retrans=1",
                })
                probe_specs.append({
                    "mode": "NFSv3",
                    "mountType": "nfs",
                    "target": f"{host}:{export.get('pseudo')}",
                    "options": f"vers=3,proto=tcp,port={port},nolock,ro,soft,timeo=1,retrans=1",
                })
            else:
                probe_specs.append({
                    "mode": "NFSv4",
                    "mountType": "nfs4",
                    "target": f"{host}:{export.get('pseudo')}",
                    "options": f"vers=4.1,proto=tcp,port={port},ro,soft,timeo=1,retrans=1",
                })

            export_result = {
                "exportUuid": export.get("uuid"),
                "exportName": export_name,
                "protocolMode": export_mode,
                "targetPath": export.get("path"),
                "pseudoPath": export.get("pseudo"),
                "success": True,
                "probes": [],
            }
            if host_error and ip_clients_only(export):
                # Service identity/render/listener checks have already run. A server
                # excluded by its own ACL cannot prove remote-client visibility.
                # Do not grant it access or mistake this policy for a failed service.
                export_result.update(success=None, status="EXTERNAL_CLIENT_REQUIRED",
                                     reason="LOCAL_ADDRESS_EXCLUDED_BY_ACL")
                export_result["probes"].append({"mode": "host-selection", "success": None,
                    "status": "NOT_APPLICABLE_LOCAL_ACL", "reason": "LOCAL_ADDRESS_EXCLUDED_BY_ACL"})
                endpoint["probeComplete"] = False
                endpoint["probeResults"].append(export_result)
                continue
            if host_error:
                export_result["success"] = False
                export_result["error"] = host_error
                export_result["probes"].append({
                    "mode": "host-selection",
                    "mountType": "nfs",
                    "target": export.get("pseudo") or export.get("path"),
                    "options": "",
                    "success": False,
                    "error": host_error,
                })
                endpoint["probeResults"].append(export_result)
                endpoint_success = False
                break
            for spec in probe_specs:
                probe_dir = tempfile.mkdtemp(prefix=f"nfs-probe-{endpoint_key(listen_ip, port)}-", dir=nfs_probe_root)
                try:
                    cmd = [
                        "mount",
                        "-t",
                        spec["mountType"],
                        "-o",
                        spec["options"],
                        spec["target"],
                        probe_dir,
                    ]
                    proc = subprocess.run(cmd, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15)
                    success = proc.returncode == 0
                    error = None
                    if success:
                        umount = subprocess.run(["umount", probe_dir], check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10)
                        if umount.returncode != 0:
                            success = False
                            error = umount.stderr.strip() or umount.stdout.strip() or "failed to unmount probe mountpoint"
                    else:
                        error = proc.stderr.strip() or proc.stdout.strip() or "mount probe failed"
                    probe_info = {
                        "mode": spec["mode"],
                        "mountType": spec["mountType"],
                        "target": spec["target"],
                        "options": spec["options"],
                        "success": success,
                    }
                    if error:
                        probe_info["error"] = error
                    export_result["probes"].append(probe_info)
                    if not success:
                        export_result["success"] = False
                        export_result["error"] = error or "mount probe failed"
                        endpoint_success = False
                        break
                finally:
                    shutil.rmtree(probe_dir, ignore_errors=True)

            export_result["status"] = "MOUNT_VERIFIED" if export_result["success"] else "FAILED"
            endpoint["probeResults"].append(export_result)
            if not export_result["success"]:
                endpoint_success = False
                break

        endpoint["probeSuccess"] = endpoint_success
        endpoint["exportsVisible"] = endpoint_success if endpoint["probeComplete"] or not endpoint_success else None
        if not endpoint_success:
            failures.append(endpoint)
    return failures

def run(command):
    return subprocess.run(command, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

def fstab_escape(value):
    return str(value).replace("\\", "\\\\").replace(" ", "\\040").replace("\t", "\\011")

def update_fstab(marker, entry=None):
    fstab_path = "/etc/fstab"
    lines = []
    if os.path.exists(fstab_path):
        with open(fstab_path, "r", encoding="utf-8") as fstab_fp:
            for line in fstab_fp:
                if marker not in line:
                    lines.append(line)
    if entry:
        lines.append(entry.rstrip("\n") + "\n")
    fd, tmp_path = tempfile.mkstemp(prefix=".fstab.", dir=os.path.dirname(fstab_path), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as tmp_fp:
            tmp_fp.writelines(lines)
        os.replace(tmp_path, fstab_path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)

def daemon_reload():
    if os.path.exists("/run/systemd/system"):
        subprocess.run(["systemctl", "daemon-reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)

def ipv4_to_int(value):
    parts = [int(part) for part in str(value).split(".")]
    if len(parts) != 4 or any(part < 0 or part > 255 for part in parts):
        raise ValueError(f"invalid IPv4 address: {value}")
    result = 0
    for part in parts:
        result = (result << 8) + part
    return result

def same_ipv4_cidr(left, right, prefix):
    mask = 0 if int(prefix) == 0 else (0xffffffff << (32 - int(prefix))) & 0xffffffff
    return (ipv4_to_int(left) & mask) == (ipv4_to_int(right) & mask)

def ensure_listen_ip():
    listen_ip = str(payload.get("listenIp") or "").strip()
    if not listen_ip or listen_ip in ("0.0.0.0", "::"):
        return
    ip_state = run(["ip", "-o", "-4", "addr", "show"])
    if ip_state.returncode != 0:
        raise RuntimeError(f"failed to inspect IPv4 addresses: {ip_state.stderr.strip()}")
    candidates = []
    for line in ip_state.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4 or parts[2] != "inet":
            continue
        iface = parts[1]
        address, prefix = parts[3].split("/", 1)
        if address == listen_ip:
            return
        try:
            if same_ipv4_cidr(listen_ip, address, int(prefix)):
                candidates.append((iface, prefix))
        except Exception:
            continue
    if not candidates:
        raise ValueError(f"listen IP {listen_ip} is not in the same CIDR as any Storage Service NIC")
    iface, prefix = candidates[0]
    add_ip = run(["ip", "addr", "add", f"{listen_ip}/{prefix}", "dev", iface])
    if add_ip.returncode != 0 and "File exists" not in add_ip.stderr:
        raise RuntimeError(f"failed to add listen IP {listen_ip}/{prefix} to {iface}: {add_ip.stderr.strip()}")

def remove_listen_ip():
    listen_ip = str(payload.get("removeListenIp") or "").strip()
    if not listen_ip or listen_ip in ("0.0.0.0", "::"):
        return
    ip_state = run(["ip", "-o", "-4", "addr", "show"])
    if ip_state.returncode != 0:
        raise RuntimeError(f"failed to inspect IPv4 addresses before endpoint removal: {ip_state.stderr.strip()}")
    for line in ip_state.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4 or parts[2] != "inet":
            continue
        iface = parts[1]
        address, prefix = parts[3].split("/", 1)
        if address != listen_ip:
            continue
        delete_ip = run(["ip", "addr", "del", f"{listen_ip}/{prefix}", "dev", iface])
        if delete_ip.returncode != 0 and "Cannot assign requested address" not in delete_ip.stderr:
            raise RuntimeError(f"failed to remove listen IP {listen_ip}/{prefix} from {iface}: {delete_ip.stderr.strip()}")
        return

def is_mountpoint(path):
    return run(["findmnt", "-n", "--mountpoint", path]).returncode == 0

def is_path_on_mount(path, mount_path):
    if not path or not mount_path:
        return False
    path_real = os.path.realpath(path)
    mount_real = os.path.realpath(mount_path)
    return path_real == mount_real or path_real.startswith(mount_real.rstrip("/") + "/")

def ensure_export_alias(export):
    export_config = effective_nfs_export_config(export.get("config") or {})
    backing_path = str(export_config.get("backingPath") or "").strip().rstrip("/")
    volume_mount_path = str(export_config.get("volumeMountPath") or "").strip().rstrip("/")
    uuid = safe_uuid(export.get("uuid"))
    exposed_path = str(export.get("path") or "").strip().rstrip("/")
    root_name = safe_export_root_name(export.get("exportPath") or export.get("name"), exposed_path)
    expected_path = f"/export/{root_name}"
    if exposed_path != expected_path:
        raise ValueError(f"NFS export path must be {expected_path}")
    if not backing_path:
        raise ValueError(f"NFS export {uuid} is missing config.backingPath; refusing to export a root filesystem directory")
    if not volume_mount_path:
        raise ValueError(f"NFS export {uuid} is missing config.volumeMountPath; refusing to export a root filesystem directory")
    if backing_path in ("/", "/export") or backing_path.startswith("/export/"):
        raise ValueError(f"NFS export {uuid} backingPath must be a managed data-volume path, not {backing_path}")
    if not volume_mount_path.startswith("/srv/ablestack-storage/volumes/"):
        raise ValueError(f"NFS export {uuid} volumeMountPath is outside the managed Storage Service volume area: {volume_mount_path}")
    if not is_mountpoint(volume_mount_path):
        raise RuntimeError(f"NFS export {uuid} backing volume is not mounted at {volume_mount_path}")
    if not is_path_on_mount(backing_path, volume_mount_path):
        raise ValueError(f"NFS export {uuid} backingPath {backing_path} is not under mounted volume {volume_mount_path}")
    nested = path_bindings.get(export["uuid"])
    if nested:
        backing_path = nested["anchor"]
    create_directory = truth(export_config, "createDirectory", True)
    if not os.path.exists(backing_path):
        if not create_directory:
            raise RuntimeError(f"NFS export {uuid} backing directory does not exist: {backing_path}")
        os.makedirs(backing_path, exist_ok=True)
    if not os.path.isdir(backing_path):
        raise ValueError(f"NFS export {uuid} backingPath is not a directory: {backing_path}")
    if os.path.exists(exposed_path) and not os.path.isdir(exposed_path):
        raise ValueError(f"NFS export alias path exists and is not a directory: {exposed_path}")
    os.makedirs(exposed_path, exist_ok=True)
    if not is_mountpoint(exposed_path) and os.listdir(exposed_path):
        raise RuntimeError(f"refusing to hide non-empty root filesystem NFS export alias: {exposed_path}")
    if is_mountpoint(exposed_path):
        try:
            same_target = os.path.samefile(exposed_path, backing_path)
        except Exception:
            same_target = False
        if not same_target:
            unmount = run(["umount", exposed_path])
            if unmount.returncode != 0:
                raise RuntimeError(f"failed to unmount stale NFS export alias {exposed_path}: {unmount.stderr.strip()}")
    if not is_mountpoint(exposed_path):
        mount = run(["mount", "--bind", backing_path, exposed_path])
        if mount.returncode != 0:
            raise RuntimeError(f"failed to bind NFS export alias {exposed_path} to {backing_path}: {mount.stderr.strip()}")
    if not is_mountpoint(exposed_path):
        raise RuntimeError(f"NFS export alias {exposed_path} is not a bind mount after mount operation")
    marker = f"ablestack-storage:{uuid}:alias"
    if nested:
        update_fstab(marker, None)
        daemon_reload()
        return exposed_path
    options = f"bind,nofail,x-systemd.requires-mounts-for={fstab_escape(backing_path)}"
    entry = f"{fstab_escape(backing_path)} {fstab_escape(exposed_path)} none {options} 0 0 # {marker}"
    update_fstab(marker, entry)
    daemon_reload()
    return exposed_path

def apply_posix_permissions(backing_path, export_config):
    owner_uid = int_config(export_config, "ownerUid")
    owner_gid = int_config(export_config, "ownerGid")
    mode = mode_config(export_config)
    recursive = truth(export_config, "recursivePermission", False)
    if owner_uid is None and owner_gid is None and mode is None:
        return
    uid = owner_uid if owner_uid is not None else -1
    gid = owner_gid if owner_gid is not None else -1
    paths = [backing_path]
    if recursive:
        for root, dirs, files in os.walk(backing_path):
            paths.append(root)
            paths.extend(os.path.join(root, name) for name in dirs)
            paths.extend(os.path.join(root, name) for name in files)
    seen = set()
    for item in paths:
        if item in seen or not os.path.exists(item):
            continue
        seen.add(item)
        if owner_uid is not None or owner_gid is not None:
            os.chown(item, uid, gid)
        if mode is not None:
            os.chmod(item, mode)

def load_alias_state():
    try:
        with open(alias_state_path, "r", encoding="utf-8") as state_fp:
            return json.load(state_fp)
    except Exception:
        return {}

