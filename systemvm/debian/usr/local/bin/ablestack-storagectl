def effective_backing_size(path):
    if not path or not os.path.exists(path):
        return None
    try:
        result = run(["blockdev", "--getsize64", path])
        if result.returncode == 0 and result.stdout.strip().isdigit():
            return int(result.stdout.strip())
    except Exception:
        pass
    try:
        return os.path.getsize(path)
    except Exception:
        return None

def configfs_iscsi_acls(target_name):
    if not target_name:
        return []
    acl_root = os.path.join("/sys/kernel/config/target/iscsi", target_name, "tpgt_1", "acls")
    try:
        return sorted(name for name in os.listdir(acl_root) if name)
    except Exception:
        return []

def targetcli_iscsi_runtime_snapshot():
    observed_at, boot_id = runtime_metadata()
    snapshot = {
        "available": False,
        "observedAt": observed_at,
        "bootId": boot_id,
        "observations": [],
    }
    if not shutil.which("targetcli"):
        snapshot["error"] = "targetcli is not installed"
        return snapshot
    result = run(["targetcli", "ls", "/iscsi"])
    if result.returncode != 0:
        snapshot["error"] = (result.stderr or "targetcli inventory failed").strip()
        return snapshot
    runtime = []
    current_target = None
    for raw_line in result.stdout.splitlines():
        line = raw_line.strip()
        target_match = re.match(r"o-\s+((?:iqn|eui|naa)\.[^\s]+|nqn\.[^\s]+)", line)
        if target_match and "TPGs:" in line:
            current_target = {"targetName": target_match.group(1), "acls": []}
            runtime.append(current_target)
            continue
        lun_match = re.match(r"o-\s+lun([^\s]*)\s+.*\[([^/\]]+)/[^\]]+\]\s+\(([^)]+)\)", line)
        if current_target and lun_match:
            try:
                lun_id = lun_match.group(1) or "0"
                backing_path = lun_match.group(3)
                backstore_type = lun_match.group(2)
                lun_runtime = {
                    "lunOrNamespace": lun_id,
                    "lun": lun_id,
                    "backingPath": backing_path,
                    "backstoreType": backstore_type,
                }
                size = effective_backing_size(backing_path)
                if size is not None:
                    lun_runtime["effectiveSizeBytes"] = size
                current_target.setdefault("luns", []).append(lun_runtime)
                if "backingPath" not in current_target:
                    current_target["backingPath"] = backing_path
                    current_target["backstoreType"] = backstore_type
                    if size is not None:
                        current_target["effectiveSizeBytes"] = size
            except Exception:
                pass
            continue
        acl_match = re.match(r"o-\s+((?:iqn|eui|naa)\.[^\s]+|nqn\.[^\s]+)", line)
        if current_target and acl_match and "Mapped LUNs:" in line:
            current_target.setdefault("acls", []).append(acl_match.group(1))
    for target in runtime:
        if not target.get("acls"):
            target["acls"] = configfs_iscsi_acls(target.get("targetName"))
        target["observedAt"] = observed_at
        target["bootId"] = boot_id
    snapshot["available"] = True
    snapshot["observations"] = runtime
    return snapshot

def enrich_iscsi_targets(desired, runtime_snapshot=None):
    if not isinstance(desired, dict):
        return desired
    runtime_snapshot = runtime_snapshot or targetcli_iscsi_runtime_snapshot()
    runtime_by_name = {item.get("targetName"): item for item in runtime_snapshot.get("observations", [])}
    enriched = json.loads(json.dumps(desired))
    for target in enriched.get("targets", []):
        config = target.get("config") or {}
        runtime = runtime_by_name.get(target.get("targetName")) or {}
        if runtime:
            target_lun = str(target.get("lunOrNamespace") or target.get("lunornamespace") or target.get("lun") or "0")
            runtime_lun = {}
            for item in runtime.get("luns", []) or []:
                if str(item.get("lunOrNamespace") or item.get("lun") or "0") == target_lun:
                    runtime_lun = item
                    break
            target["runtime"] = dict(runtime)
            if runtime_lun:
                target["runtime"].update(runtime_lun)
            for key in ("backingPath", "backstoreType", "effectiveSizeBytes"):
                value = runtime_lun.get(key) if runtime_lun else runtime.get(key)
                if value is not None:
                    target[key] = value
        if config.get("lunSizeBytes") is not None:
            target["lunSizeBytes"] = config.get("lunSizeBytes")
        if target.get("effectiveSizeBytes") is None:
            target["effectiveSizeBytes"] = target.get("lunSizeBytes") or target.get("volumeSizeBytes")
    return enriched

def read_runtime_text(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except Exception:
        return default

def nvme_namespace_device_size(path):
    if not path:
        return None
    result = run(["blockdev", "--getsize64", path])
    value = result.stdout.strip()
    if result.returncode == 0 and value.isdigit():
        return int(value)
    result = run(["lsblk", "-b", "-dn", "-o", "SIZE", path])
    value = result.stdout.strip()
    return int(value) if result.returncode == 0 and value.isdigit() else None

def nvme_namespace_device_identity(path):
    identity = {"backingPath": path, "resolvedBackingPath": os.path.realpath(path) if path else ""}
    if not path:
        return identity
    for field, key in (("UUID", "filesystemUuid"), ("SERIAL", "serial"), ("WWN", "wwn")):
        result = run(["lsblk", "-dn", "-o", field, path])
        value = result.stdout.strip()
        if result.returncode == 0 and value:
            identity[key] = value
    return identity

def enrich_nvmeof_subsystems(desired):
    if not isinstance(desired, dict):
        return desired
    enriched = json.loads(json.dumps(desired))
    for subsystem in enriched.get("subsystems", []) or []:
        nqn = str(subsystem.get("targetName") or subsystem.get("subsystemNqn") or "")
        subsystem_root = os.path.join("/sys/kernel/config/nvmet/subsystems", nqn)
        subsystem_runtime = {
            "subsystemNqn": nqn,
            "configfsPresent": bool(nqn and os.path.isdir(subsystem_root)),
            "allowAnyHost": read_runtime_text(os.path.join(subsystem_root, "attr_allow_any_host")) == "1",
        }
        allowed_hosts_root = os.path.join(subsystem_root, "allowed_hosts")
        subsystem_runtime["allowedHosts"] = sorted(os.listdir(allowed_hosts_root)) if os.path.isdir(allowed_hosts_root) else []
        runtime_namespaces = []
        for namespace in subsystem.get("namespaces", []) or []:
            nsid = str(namespace.get("lunOrNamespace") or namespace.get("namespaceId") or "1")
            namespace_root = os.path.join(subsystem_root, "namespaces", nsid)
            backing_path = read_runtime_text(os.path.join(namespace_root, "device_path"))
            enabled = read_runtime_text(os.path.join(namespace_root, "enable")) == "1"
            actual_size = nvme_namespace_device_size(backing_path)
            config = namespace.get("config") if isinstance(namespace.get("config"), dict) else {}
            configured_size = config.get("namespaceSizeBytes") or namespace.get("namespaceSizeBytes")
            runtime = {
                "subsystemNqn": nqn,
                "namespaceId": nsid,
                "configfsPresent": os.path.isdir(namespace_root),
                "enabled": enabled,
                "runtimeState": "READY" if enabled and backing_path else "ERROR",
                "namespaceSizeBytes": configured_size,
                "actualSizeBytes": actual_size,
                "effectiveSizeBytes": actual_size,
                "volumeUuid": namespace.get("volumeUuid") or config.get("volumeUuid"),
                "volumeName": namespace.get("volumeName") or config.get("volumeName"),
            }
            runtime.update(nvme_namespace_device_identity(backing_path))
            runtime = {key: value for key, value in runtime.items() if value not in (None, "")}
            namespace["runtime"] = runtime
            namespace.update({
                "namespaceSizeBytes": configured_size,
                "effectiveSizeBytes": actual_size,
                "backingPath": backing_path,
                "runtimeState": runtime.get("runtimeState"),
            })
            runtime_namespaces.append(runtime)
        subsystem_runtime["namespaces"] = runtime_namespaces
        subsystem_runtime["namespaceCount"] = len([item for item in runtime_namespaces if item.get("enabled")])
        subsystem["runtime"] = subsystem_runtime
    return enriched

def desired_iscsi_ports(state):
    ports = set()
    if isinstance(state, dict):
        for listener in state.get("listeners") or []:
            if isinstance(listener, dict):
                try:
                    ports.add(int(listener.get("port") or 3260))
                except Exception:
                    pass
        if not ports and state.get("port"):
            try:
                ports.add(int(state.get("port")))
            except Exception:
                pass
        for target in state.get("targets") or []:
            config = target.get("config") or {}
            raw = target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports")
            if isinstance(raw, list):
                for value in raw:
                    try:
                        ports.add(int(value))
                    except Exception:
                        pass
            elif isinstance(raw, str):
                for value in re.split(r"[,\s]+", raw):
                    if not value:
                        continue
                    try:
                        ports.add(int(value))
                    except Exception:
                        pass
    if not ports:
        ports.add(3260)
    return sorted(ports)

def desired_nvmeof_ports(state):
    ports = set()
    if isinstance(state, dict):
        for listener in state.get("listeners") or []:
            if not isinstance(listener, dict):
                continue
            try:
                ports.add(int(listener.get("port") or listener.get("listenPort") or listener.get("listenport") or state.get("port") or 4420))
            except Exception:
                pass
        has_namespace = False
        has_subsystem = bool(state.get("subsystems"))
        if not ports:
            for subsystem in state.get("subsystems") or []:
                for namespace in subsystem.get("namespaces") or []:
                    has_namespace = True
                    config = namespace.get("config") or {}
                    raw = namespace.get("listenerPorts") or namespace.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports")
                    if isinstance(raw, list):
                        for value in raw:
                            try:
                                ports.add(int(value))
                            except Exception:
                                pass
                    elif isinstance(raw, str):
                        for value in re.split(r"[,\s]+", raw):
                            if not value:
                                continue
                            try:
                                ports.add(int(value))
                            except Exception:
                                pass
        if not ports and (has_namespace or has_subsystem):
            try:
                ports.add(int(state.get("port") or 4420))
            except Exception:
                ports.add(4420)
    return sorted(ports)

def nvmeof_namespace_ports(namespace):
    ports = set()
    if not isinstance(namespace, dict):
        return ports
    config = namespace.get("config") or {}
    raw = namespace.get("listenerPorts") or namespace.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports")
    if isinstance(raw, list):
        values = raw
    elif isinstance(raw, str):
        values = re.split(r"[,\s]+", raw)
    else:
        values = []
    for value in values:
        if value in (None, ""):
            continue
        try:
            ports.add(int(value))
        except Exception:
            pass
    return ports

def nvmeof_linked_ports(state):
    ports = set()
    if not isinstance(state, dict):
        return ports
    default_port = int(state.get("port") or 4420)
    for subsystem in state.get("subsystems") or []:
        if not isinstance(subsystem, dict) or str(subsystem.get("state", "Ready")) in ("Disabled", "Destroyed", "Error"):
            continue
        for namespace in subsystem.get("namespaces") or []:
            if not isinstance(namespace, dict) or str(namespace.get("state", "Ready")) in ("Disabled", "Destroyed", "Error"):
                continue
            ports.update(nvmeof_namespace_ports(namespace) or {default_port})
    return ports

def nvmeof_port_runtime(state):
    configured_ports = set(desired_nvmeof_ports(state))
    linked_ports = nvmeof_linked_ports(state)
    configured_ports.update(linked_ports)
    if not configured_ports and isinstance(state, dict) and state.get("subsystems"):
        configured_ports.add(int(state.get("port") or 4420))
    runtime = {}
    for port in sorted(configured_ports):
        listening = port_listening(port)
        linked = port in linked_ports
        if linked and listening:
            port_state = "LISTENING"
        elif linked:
            port_state = "ERROR"
        else:
            port_state = "UNUSED"
        runtime[str(port)] = {
            "configured": True,
            "linked": linked,
            "listening": listening,
            "state": port_state,
        }
    return runtime

