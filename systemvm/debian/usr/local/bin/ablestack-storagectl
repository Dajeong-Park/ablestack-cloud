smb_domain_join() {
  local payload_file="$1"

  if [[ "${ABLESTACK_STORAGE_AD_MEMBERSHIP_ONLY:-0}" != "1" ]] && python3 -c 'import json,sys;sys.exit(0 if "smbDesiredState" in json.load(open(sys.argv[1])) else 1)' "$payload_file"; then
    python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/configuration_transaction.py" ad-domain join "$payload_file"
    return $?
  fi
  python3 - "$payload_file" <<'PY'
import json
import os
import re
import subprocess
import sys
import time
import tempfile, atexit, shutil
from pathlib import Path

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
state_path = os.path.join(state_dir, "smb-domain.json")
private_join = os.environ.get("ABLESTACK_STORAGE_AD_MEMBERSHIP_ONLY") == "1" or Path(state_dir, "smb-listeners.json").is_file()
join_dir = Path(tempfile.mkdtemp(prefix="ablestack-ad-member-", dir="/run")) if private_join else None
if join_dir:
    join_dir.chmod(0o700)
    atexit.register(shutil.rmtree, join_dir)
join_conf = str(join_dir / "smb.conf") if join_dir else "/etc/samba/smb.conf"

error_path = os.path.join(state_dir, "smb-domain-error.json")

def write_join_error(phase, message):
    with open(error_path, "w", encoding="utf-8") as error_fp:
        json.dump({
            "state": "JOIN_FAILED",
            "phase": phase,
            "message": str(message),
            "domainName": payload.get("domainName"),
            "workgroup": payload.get("workgroup") or (payload.get("config") or {}).get("workgroup"),
            "updatedAt": int(time.time()),
        }, error_fp, sort_keys=True, indent=2)

def command_label(args):
    cleaned = []
    for item in args:
        value = str(item)
        if "%" in value and "-U" not in value:
            value = value.split("%", 1)[0] + "%<redacted>"
        cleaned.append(value)
    return " ".join(cleaned)

def run_checked(phase, args, input_text=None):
    result = subprocess.run(args, input=input_text, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "command failed").strip()
        if input_text:
            detail = detail.replace(input_text.strip(), "<redacted>")
        if not detail:
            detail = command_label(args) + " failed"
        write_join_error(phase, detail)
        raise SystemExit(detail)
    return result

def derive_ad_workgroup(domain_name, workgroup):
    value = str(workgroup or "").strip()
    if value and value.upper() != "WORKGROUP":
        return re.sub(r"[^A-Za-z0-9]", "", value)[:15].upper() or "WORKGROUP"
    domain_value = str(domain_name or "").strip()
    if domain_value:
        derived = re.sub(r"[^A-Za-z0-9]", "", domain_value.split(".", 1)[0])[:15].upper()
        if derived:
            return derived
    return "WORKGROUP"

def normalize_realm(domain_name):
    return str(domain_name or "").strip().upper()

def kerberos_principal(username, realm):
    value = str(username or "").strip()
    if "@" in value:
        return value
    if "\\" in value:
        value = value.split("\\", 1)[1]
    return f"{value}@{realm}"

def write_smb_conf(workgroup_name):
    lines = [
        "[global]",
        "   server string = ABLESTACK Storage Service",
        f"   netbios name = {netbios_name}",
        f"   workgroup = {workgroup_name}",
        f"   realm = {realm}",
        "   security = ADS",
        "   kerberos method = secrets and keytab",
        "   winbind use default domain = yes",
        "   winbind enum users = yes",
        "   winbind enum groups = yes",
        "   idmap config * : backend = tdb",
        "   idmap config * : range = 10000-999999",
        "   load printers = no",
        "   printing = bsd",
        "   disable spoolss = yes",
        "   map to guest = Bad User",
    ]
    with open(join_conf, "w", encoding="utf-8") as smb_fp:
        smb_fp.write("\n".join(lines) + "\n")

domain = payload.get("domainName")
username = payload.get("username")
password = payload.get("password")
ou = payload.get("organizationalUnit")
dns_servers = payload.get("dnsServers")
config = payload.get("config") or {}
realm = normalize_realm(domain)
workgroup = derive_ad_workgroup(domain, config.get("workgroup"))
netbios_name = re.sub(r"[^A-Za-z0-9]", "", str(payload.get("netbiosName") or config.get("netbiosName") or ""))[:15].upper()
if not netbios_name:
    netbios_name = "STORAGEVM"

if not domain or not username or not password:
    write_join_error("validate", "domainName, username, and password are required for SMB domain join")
    raise SystemExit("domainName, username, and password are required for SMB domain join")

if os.path.exists(error_path):
    os.remove(error_path)

if dns_servers:
    with open(os.path.join(state_dir, "smb-dns-servers"), "w", encoding="utf-8") as dns_fp:
        dns_fp.write(str(dns_servers) + "\n")
    backup_path = os.path.join(state_dir, "resolv.conf.storage-backup")
    if os.path.exists("/etc/resolv.conf") and not os.path.exists(backup_path):
        with open("/etc/resolv.conf", "r", encoding="utf-8", errors="ignore") as source_fp, open(backup_path, "w", encoding="utf-8") as backup_fp:
            backup_fp.write(source_fp.read())
    with open("/etc/resolv.conf", "w", encoding="utf-8") as resolv_fp:
        resolv_fp.write(f"search {domain}\n")
        for server in re.split(r"[,\\s]+", str(dns_servers)):
            if server:
                resolv_fp.write(f"nameserver {server}\n")

with open("/etc/krb5.conf", "w", encoding="utf-8") as krb_fp:
    krb_fp.write("[libdefaults]\n")
    krb_fp.write(f" default_realm = {realm}\n")
    krb_fp.write(" dns_lookup_realm = false\n dns_lookup_kdc = true\n rdns = false\n")

write_smb_conf(workgroup)
run_checked("testparm", ["testparm", "-s", join_conf])
lookup = subprocess.run(["net", "--configfile="+join_conf, "ads", "lookup", "-S", domain], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
if lookup.returncode == 0:
    for line in lookup.stdout.splitlines():
        if "Pre-Win2k Domain:" in line:
            discovered = line.split(":", 1)[1].strip()
            if discovered:
                workgroup = derive_ad_workgroup(domain, discovered)
                write_smb_conf(workgroup)
            break

previous = {}
if os.path.isfile(state_path):
    with open(state_path, encoding="utf-8") as handle:
        previous = json.load(handle)
same_identity = (private_join and payload.get("reuseExistingMembership") is True
                 and previous.get("domainName", "").lower() == str(domain).lower()
                 and previous.get("netbiosName") == netbios_name
                 and (previous.get("organizationalUnit") or "") == (ou or ""))
already_joined = same_identity and subprocess.run(
    ["net", "--configfile="+join_conf, "ads", "testjoin"],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
if not already_joined:
    kinit_principal = kerberos_principal(username, realm)
    run_checked("kinit", ["kinit", kinit_principal], input_text=f"{password}\n")
    cmd = ["net", "--configfile="+join_conf, "ads", "join", "-k"]
    if ou:
        cmd.append(f"createcomputer={ou}")
    try:
        run_checked("join", cmd)
    finally:
        subprocess.run(["kdestroy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if private_join:
    run_checked("testjoin", ["net", "--configfile="+join_conf, "ads", "testjoin"])

with open(state_path, "w", encoding="utf-8") as state_fp:
    json.dump({
        "domainName": domain,
        "organizationalUnit": ou,
        "dnsServers": dns_servers,
        "workgroup": workgroup,
        "realm": realm,
        "netbiosName": netbios_name,
        "state": "JOINED",
        "membershipOnly": private_join,
        "trustVerified": private_join,
    }, state_fp, sort_keys=True, indent=2)

print(json.dumps({"success": True, "domainName": domain, "alreadyJoined": already_joined}))
PY

  if [[ "${ABLESTACK_STORAGE_AD_MEMBERSHIP_ONLY:-0}" == "1" || -f /etc/ablestack-storage/smb-listeners.json ]]; then return 0; fi

  if [[ "${ABLESTACK_STORAGE_AD_MEMBERSHIP_ONLY:-0}" != "1" && ! -f /etc/ablestack-storage/smb-listeners.json ]] && command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now smbd >/dev/null 2>&1 || true
    systemctl enable --now nmbd >/dev/null 2>&1 || true
    systemctl enable --now winbind >/dev/null 2>&1 || true
    systemctl restart smbd >/dev/null 2>&1 || true
    systemctl restart nmbd >/dev/null 2>&1 || true
    systemctl restart winbind >/dev/null 2>&1 || true
  fi
  net cache flush >/dev/null 2>&1 || true

  local verify_error=""
  if ! verify_error="$(net ads testjoin 2>&1)"; then
    python3 - "$verify_error" <<'PY'
import json
import os
import sys
import time
state_dir = "/etc/ablestack-storage"
with open(os.path.join(state_dir, "smb-domain-error.json"), "w", encoding="utf-8") as fp:
    json.dump({"state": "JOIN_FAILED", "phase": "testjoin", "message": sys.argv[1], "updatedAt": int(time.time())}, fp, sort_keys=True, indent=2)
PY
    echo "$verify_error" >&2
    return 1
  fi
  local verify_workgroup
  verify_workgroup="$(python3 - <<'PY'
import json
import os
state_path = "/etc/ablestack-storage/smb-domain.json"
try:
    with open(state_path, "r", encoding="utf-8") as fp:
        data = json.load(fp)
    print(data.get("workgroup") or "")
except Exception:
    print("")
PY
)"
  if [[ -z "$verify_workgroup" ]]; then
    verify_error="Unable to determine AD workgroup for winbind verification"
    python3 - "$verify_error" <<'PY'
import json
import os
import sys
import time
state_dir = "/etc/ablestack-storage"
with open(os.path.join(state_dir, "smb-domain-error.json"), "w", encoding="utf-8") as fp:
    json.dump({"state": "JOIN_FAILED", "phase": "wbinfo", "message": sys.argv[1], "updatedAt": int(time.time())}, fp, sort_keys=True, indent=2)
PY
    echo "$verify_error" >&2
    return 1
  fi
  if ! verify_error="$(wbinfo --domain="$verify_workgroup" -t 2>&1)"; then
    python3 - "$verify_error" <<'PY'
import json
import os
import sys
import time
state_dir = "/etc/ablestack-storage"
with open(os.path.join(state_dir, "smb-domain-error.json"), "w", encoding="utf-8") as fp:
    json.dump({"state": "JOIN_FAILED", "phase": "wbinfo", "message": sys.argv[1], "updatedAt": int(time.time())}, fp, sort_keys=True, indent=2)
PY
    echo "$verify_error" >&2
    return 1
  fi
  python3 - <<'PY'
import json
import os
import time
state_dir = "/etc/ablestack-storage"
state_path = os.path.join(state_dir, "smb-domain.json")
error_path = os.path.join(state_dir, "smb-domain-error.json")
data = {}
if os.path.exists(state_path):
    with open(state_path, "r", encoding="utf-8") as fp:
        data = json.load(fp)
data["state"] = "JOINED"
data["trustVerified"] = True
data["verifiedAt"] = int(time.time())
with open(state_path, "w", encoding="utf-8") as fp:
    json.dump(data, fp, sort_keys=True, indent=2)
if os.path.exists(error_path):
    os.remove(error_path)
PY
}

smb_domain_leave() {
  local payload_file="$1"

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

username = payload.get("username")
password = payload.get("password")
cmd = ["net", "ads", "leave"]
if username and password:
    cmd.extend(["-U", f"{username}%{password}"])
subprocess.run(cmd, check=True)

domain_state = "/etc/ablestack-storage/smb-domain.json"
if os.path.exists(domain_state):
    os.remove(domain_state)

print(json.dumps({"success": True}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart smbd >/dev/null 2>&1 || true
    systemctl restart winbind >/dev/null 2>&1 || true
  fi
}

apply_iscsi_targets() {
  local payload_file="$1"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now target >/dev/null 2>&1 || systemctl enable --now rtslib-fb-targetctl >/dev/null 2>&1 || true
  fi

  python3 - "$payload_file" <<'PY'
import glob
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
state_file = os.path.join(state_dir, "iscsi-targets.json")
secret_dir = os.path.join(state_dir, "secrets")
secret_file = os.path.join(secret_dir, "iscsi-acl-secrets.json")

previous_payload = {}
try:
    with open(state_file, "r", encoding="utf-8") as previous_state_fp:
        previous_payload = json.load(previous_state_fp)
except Exception:
    previous_payload = {}

SENSITIVE_KEYS = {"secrets", "chapSecret", "mutualChapSecret", "secret", "password"}

def load_secret_store():
    try:
        with open(secret_file, "r", encoding="utf-8") as secret_fp:
            value = json.load(secret_fp)
            return value if isinstance(value, dict) else {}
    except Exception:
        return {}

def write_secret_store(value):
    os.makedirs(secret_dir, mode=0o700, exist_ok=True)
    tmp_fd, tmp_path = tempfile.mkstemp(prefix=".iscsi-acl-secrets.", dir=secret_dir)
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as tmp_fp:
            json.dump(value, tmp_fp, sort_keys=True, indent=2)
            tmp_fp.write("\n")
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, secret_file)
    finally:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass

def acl_secret_key(target, acl):
    return f"{target.get('targetName') or ''}|{acl.get('principal') or ''}"

def merge_and_persist_iscsi_secrets(value):
    store = load_secret_store()
    next_store = {}
    for target in value.get("targets", []) or []:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        for acl in target.get("acls", []) or []:
            if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            config = acl.get("config") or {}
            needs_chap = bool(config.get("chapEnabled")) or bool(config.get("mutualChapEnabled"))
            if not needs_chap:
                continue
            key = acl_secret_key(target, acl)
            secrets = acl.setdefault("secrets", {})
            saved = store.get(key) or {}
            for name in ("chapSecret", "mutualChapSecret"):
                if secrets.get(name):
                    saved[name] = secrets.get(name)
                elif saved.get(name):
                    secrets[name] = saved.get(name)
            if saved:
                next_store[key] = saved
    write_secret_store(next_store)

merge_and_persist_iscsi_secrets(payload)

def sanitized(value):
    if isinstance(value, dict):
        return {k: sanitized(v) for k, v in value.items() if k not in SENSITIVE_KEYS}
    if isinstance(value, list):
        return [sanitized(v) for v in value]
    return value

with open(state_file, "w", encoding="utf-8") as state_fp:
    json.dump(sanitized(payload), state_fp, sort_keys=True, indent=2)

def run(args, timeout=20):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)

def run_targetcli(*args):
    return run(["targetcli", *args])

def ok_or_exists(result):
    text = f"{result.stdout}\n{result.stderr}".lower()
    return result.returncode == 0 or "exists" in text or "already" in text

def require_targetcli(*args):
    result = run_targetcli(*args)
    if not ok_or_exists(result):
        raise SystemExit((result.stderr or result.stdout or f"targetcli failed: {' '.join(args)}").strip())
    return result

def command_exists(name):
    return shutil.which(name) is not None

def resolve_existing_path(path):
    if os.path.islink(path):
        target = os.readlink(path)
        if os.path.isabs(target):
            return target
        return os.path.normpath(os.path.join(os.path.dirname(path), target))
    return path

def has_elf_header(path):
    try:
        with open(resolve_existing_path(path), "rb") as fp:
            return fp.read(4) == b"\x7fELF"
    except Exception:
        return False

def has_text_prefix(path, prefix):
    try:
        with open(path, "rb") as fp:
            return fp.read(len(prefix)) == prefix.encode("utf-8")
    except Exception:
        return False

def ensure_iscsi_runtime_dependencies():
    failures = []
    python_path = shutil.which("python3") or "/usr/bin/python3"
    if not command_exists("targetcli"):
        failures.append("targetcli is missing")
    if not has_elf_header(python_path):
        failures.append(f"python3 has an invalid ELF header: {python_path}")
    if not has_elf_header("/usr/lib/python3/dist-packages/gi/_gi.cpython-311-x86_64-linux-gnu.so"):
        failures.append("python3-gi has an invalid ELF header")
    if not has_elf_header("/lib/x86_64-linux-gnu/libmagic.so.1"):
        failures.append("libmagic has an invalid ELF header")
    if not has_text_prefix("/var/lib/dpkg/status", "Package:"):
        failures.append("dpkg status database is unreadable")
    if not failures:
        result = run(["python3", "-c", "import gi"], timeout=10)
        if result.returncode != 0:
            failures.append((result.stderr or result.stdout or "python3-gi cannot be loaded").strip())
    if failures:
        raise SystemExit(
            "SystemVM iSCSI runtime dependency is broken: "
            + "; ".join(failures)
            + ". Rebuild and register a valid Storage Service SystemVM template."
        )

def service_action(action):
    if not command_exists("systemctl"):
        return
    for name in ("target", "rtslib-fb-targetctl"):
        result = run(["systemctl", action, name], timeout=30)
        if result.returncode == 0:
            return

def best_effort_firewall(port):
    if command_exists("firewall-cmd"):
        run(["firewall-cmd", "--add-port", f"{port}/tcp"], timeout=15)
        run(["firewall-cmd", "--permanent", "--add-port", f"{port}/tcp"], timeout=15)
    if command_exists("iptables"):
        check = run(["iptables", "-C", "INPUT", "-p", "tcp", "--dport", str(port), "-j", "ACCEPT"], timeout=10)
        if check.returncode != 0:
            run(["iptables", "-I", "INPUT", "-p", "tcp", "--dport", str(port), "-j", "ACCEPT"], timeout=10)

def lsblk_devices():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"], timeout=20)
    if result.returncode != 0:
        return []
    try:
        return json.loads(result.stdout).get("blockdevices", [])
    except Exception:
        return []

def walk_devices(devices):
    for dev in devices:
        yield dev
        for child in dev.get("children") or []:
            yield from walk_devices([child])

def mounted(dev):
    if dev.get("mountpoint"):
        return True
    return any(mounted(child) for child in dev.get("children") or [])

def normalize_token(value):
    return str(value or "").replace("-", "").replace("_", "").lower()

def matchable_tokens(target):
    candidates = [
        target.get("volumeUuid"),
        target.get("volumeName"),
        target.get("volumePath"),
        target.get("expectedSerialPrefix"),
    ]
    config = target.get("config") or {}
    candidates.extend([
        config.get("volumeUuid"),
        config.get("volumeName"),
        config.get("volumeSerial"),
        config.get("volumePath"),
        config.get("expectedSerialPrefix"),
    ])
    tokens = []
    for candidate in candidates:
        token = normalize_token(candidate)
        if len(token) >= 8 and not token.isdigit():
            tokens.append(token)
    return tokens

def match_by_id(tokens):
    tokens = [normalize_token(token) for token in tokens if token]
    if not tokens:
        return None
    for path in glob.glob("/dev/disk/by-id/*"):
        text = normalize_token(os.path.basename(path))
        if any(token_matches_text(token, text) for token in tokens):
            return os.path.realpath(path)
    return None

def token_matches_text(token, text):
    if not token or not text:
        return False
    return token in text or text in token or (len(token) >= 16 and token[:16] in text)

def try_find_backing_path(target):
    config = target.get("config") or {}
    configured = config.get("backingPath")
    if configured and os.path.exists(configured):
        return configured
    tokens = matchable_tokens(target)
    matched = match_by_id(tokens)
    if matched:
        return matched
    devices = lsblk_devices()
    for dev in walk_devices(devices):
        fields = [normalize_token(dev.get(key)) for key in ("name", "path", "serial", "uuid")]
        if any(token_matches_text(token, field) for token in tokens for field in fields):
            return dev.get("path")
    return None

def find_backing_path(target):
    deadline = time.time() + int(target.get("deviceSettleSeconds") or payload.get("deviceSettleSeconds") or 90)
    last_tokens = matchable_tokens(target)
    while True:
        path = try_find_backing_path(target)
        if path:
            return path
        if time.time() >= deadline:
            break
        if command_exists("udevadm"):
            run(["udevadm", "settle"], timeout=10)
        time.sleep(2)
    raise SystemExit(f"unable to resolve backing block device for iSCSI target {target.get('targetName') or target.get('uuid')}; volumeUuid or volumeName did not match any guest disk")

def mountpoint_for_device(path):
    result = run(["findmnt", "-n", "-o", "TARGET", "--source", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().splitlines()[0]
    return ""

def device_size_bytes(path):
    result = run(["lsblk", "-b", "-dn", "-o", "SIZE", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip().isdigit():
        return int(result.stdout.strip())
    if os.path.exists(path):
        return os.path.getsize(path)
    raise SystemExit(f"unable to determine backing size for {path}")

def target_size_bytes(target, backing_path):
    config = target.get("config") or {}
    if normalize_backstore_type(target) == "BLOCK":
        return device_size_bytes(backing_path)
    value = config.get("lunSizeBytes") or target.get("lunSizeBytes") or target.get("effectiveSizeBytes") or target.get("volumeSizeBytes")
    if value:
        return int(value)
    return device_size_bytes(backing_path)

def normalize_backstore_type(target):
    config = target.get("config") or {}
    value = target.get("backstoreType") or target.get("backstoretype") or config.get("backstoreType") or config.get("backstoretype") or "BLOCK"
    value = str(value).strip().upper()
    if value != "BLOCK":
        raise SystemExit("iSCSI targets support block backstores only; file-backed LUNs are not supported")
    return value

def device_tree_for_path(path):
    real = os.path.realpath(path)
    for dev in walk_devices(lsblk_devices()):
        dev_path = dev.get("path")
        if dev_path and os.path.realpath(dev_path) == real:
            return dev
    return None

def device_has_mounted_or_swap_descendant(dev):
    if not dev:
        return False
    mountpoint = str(dev.get("mountpoint") or "")
    fstype = str(dev.get("fstype") or "").lower()
    if mountpoint or fstype == "swap":
        return True
    return any(device_has_mounted_or_swap_descendant(child) for child in dev.get("children") or [])

def validate_block_backstore_device(path):
    dev = device_tree_for_path(path)
    if not dev:
        raise SystemExit(f"unable to inspect backing block device {path}; refusing unsafe iSCSI BLOCK backstore")
    dev_type = str(dev.get("type") or "")
    if dev_type not in ("disk", "part", "lvm", "mpath"):
        raise SystemExit(f"backing device {path} has unsupported block type {dev_type}; refusing iSCSI BLOCK backstore")
    if device_has_mounted_or_swap_descendant(dev):
        raise SystemExit(f"backing device {path} or one of its partitions is mounted or swap; refusing iSCSI BLOCK backstore")

def resolve_backstore(target, backstore_name):
    path = find_backing_path(target)
    backstore_type = normalize_backstore_type(target)
    mountpoint = mountpoint_for_device(path)
    if mountpoint:
        raise SystemExit(f"backing device {path} is mounted at {mountpoint}; refusing iSCSI BLOCK backstore")
    validate_block_backstore_device(path)
    from rtslib_fb import BlockStorageObject, RTSRoot
    existing = next((item for item in RTSRoot().storage_objects
                     if item.plugin == "block" and item.name == backstore_name), None)
    if existing is not None:
        if os.path.realpath(existing.udev_path) != os.path.realpath(path):
            if os.environ.get("ABLESTACK_STORAGE_CONFIGURATION_TRANSACTION") != "1":
                raise SystemExit("existing iSCSI backstore identity differs from the requested DATA")
            from rtslib_fb import RTSRoot
            if list(RTSRoot().sessions):
                raise SystemExit("active iSCSI sessions prevent a backing change")
            old_wwn = existing.wwn
            for attached in list(existing.attached_luns):
                if attached.parent_tpg.parent_target.wwn != target.get("targetName"):
                    raise SystemExit("iSCSI backstore has an unexpected target owner")
            for attached in list(existing.attached_luns):
                attached.delete()
            existing.delete()
            require_targetcli("/backstores/block", "create", backstore_name, path)
            BlockStorageObject(backstore_name).wwn = old_wwn
    else:
        require_targetcli("/backstores/block", "create", backstore_name, path)
    restore = target.get("configurationRestoreBackstore")
    if isinstance(restore, dict) and os.environ.get("ABLESTACK_STORAGE_CONFIGURATION_TRANSACTION") == "1":
        native = BlockStorageObject(backstore_name)
        if restore.get("name") != backstore_name or os.path.realpath(restore.get("dev", "")) != os.path.realpath(path):
            raise SystemExit("iSCSI restoration backstore identity differs")
        if restore.get("wwn") and native.wwn != restore["wwn"]:
            native.wwn = restore["wwn"]
        for attribute, value in (restore.get("attributes") or {}).items():
            if str(native.get_attribute(attribute)) != str(value):
                native.set_attribute(attribute, value)
    return f"/backstores/block/{backstore_name}", path, "block", existing is None

def port_listening(port):
    if not command_exists("ss"):
        return False
    result = run(["ss", "-H", "-lnt"], timeout=8)
    suffix = ":" + str(port)
    return any(len(line.split()) >= 4 and line.split()[3].endswith(suffix) for line in result.stdout.splitlines())

def configured_listeners():
    listeners = []
    for item in payload.get("listeners") or []:
        if not isinstance(item, dict):
            continue
        listen_ip = str(item.get("listenIp") or item.get("listenip") or "0.0.0.0")
        port = int(item.get("port") or 3260)
        listeners.append({"listenIp": listen_ip, "port": port})
    if not listeners:
        listeners.append({"listenIp": str(payload.get("listenIp") or "0.0.0.0"), "port": int(payload.get("port") or 3260)})
    normalized = []
    seen = set()
    for item in listeners:
        key = (item["listenIp"], item["port"])
        if key in seen:
            continue
        seen.add(key)
        normalized.append(item)
    ports_with_any = {item["port"] for item in normalized if item["listenIp"] in ("0.0.0.0", "::")}
    if ports_with_any:
        normalized = [item for item in normalized if item["port"] not in ports_with_any or item["listenIp"] in ("0.0.0.0", "::")]
    return normalized

def target_listener_ports(target, listeners):
    config = target.get("config") or {}
    raw_ports = target.get("listenerPorts") or target.get("listenerports") or config.get("listenerGroupPorts") or config.get("listenergroupports") or config.get("listenerPorts") or config.get("listenerports")
    ports = set()
    if isinstance(raw_ports, list):
        for value in raw_ports:
            try:
                ports.add(int(value))
            except Exception:
                pass
    elif isinstance(raw_ports, str):
        for value in raw_ports.split(','):
            value = value.strip()
            if value:
                ports.add(int(value))
    elif raw_ports:
        ports.add(int(raw_ports))
    if not ports:
        ports.add(int(payload.get("port") or 3260))
    return ports

def selected_listeners_for_target(target, listeners):
    config = target.get("config") or {}
    mode = str(target.get("endpointMode") or target.get("endpointmode") or config.get("endpointMode") or config.get("endpointmode") or "LISTENER_GROUP").upper()
    if mode == "ALL":
        return listeners
    ports = target_listener_ports(target, listeners)
    selected = [item for item in listeners if item["port"] in ports]
    if not selected:
        raise SystemExit(f"no iSCSI listener port group is enabled for target {target.get('targetName') or target.get('uuid')}: {sorted(ports)}")
    return selected

listeners = configured_listeners()
required_ports = set()

enabled = bool(payload.get("enabled", True))
applied = 0
skipped = 0
runtime_targets = []
targets = payload.get("targets", [])

def active_targets_by_iqn(targets):
    groups = {}
    for target in targets:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        iqn = target.get("targetName")
        if not iqn:
            continue
        groups.setdefault(iqn, []).append(target)
    return groups

def merged_listeners_for_targets(group_targets, listeners):
    selected = []
    seen = set()
    for target in group_targets:
        for listener in selected_listeners_for_target(target, listeners):
            key = (listener["listenIp"], listener["port"])
            if key in seen:
                continue
            seen.add(key)
            selected.append(listener)
    return selected

def iscsi_portal_exists(iqn, listen_ip, port):
    path = Path("/sys/kernel/config/target/iscsi") / str(iqn) / "tpgt_1" / "np" / f"{listen_ip}:{port}"
    return path.exists()

def create_iscsi_portal(iqn, listen_ip, port):
    listen_ip = str(listen_ip or "0.0.0.0")
    port = int(port or 3260)
    if iscsi_portal_exists(iqn, listen_ip, port):
        return
    if listen_ip not in ("0.0.0.0", "::") and iscsi_portal_exists(iqn, "0.0.0.0", port):
        return
    result = run_targetcli(f"/iscsi/{iqn}/tpg1/portals", "create", listen_ip, str(port))
    if ok_or_exists(result):
        return
    if listen_ip not in ("0.0.0.0", "::") and iscsi_portal_exists(iqn, "0.0.0.0", port):
        return
    if iscsi_portal_exists(iqn, listen_ip, port):
        return
    raise SystemExit((result.stderr or result.stdout or f"targetcli failed to create portal {listen_ip}:{port}").strip())

def iscsi_acl_chap_signature(acl):
    config = acl.get("config") or {}
    return "|".join([
        str(bool(config.get("chapEnabled"))),
        str(config.get("chapUsername") or ""),
        str(bool(config.get("mutualChapEnabled"))),
        str(config.get("mutualChapUsername") or ""),
    ])

def merged_acls_for_targets(group_targets):
    merged = []
    seen = {}
    for target in group_targets:
        for acl in target.get("acls", []):
            if acl.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            initiator = acl.get("principal")
            if not initiator:
                continue
            signature = iscsi_acl_chap_signature(acl)
            if initiator in seen:
                if seen[initiator] != signature:
                    raise SystemExit(f"conflicting iSCSI CHAP settings for initiator {initiator}; CHAP is target-scoped")
                existing = next(item for item in merged if item.get("principal") == initiator)
                if not (existing.get("secrets") or {}) and (acl.get("secrets") or {}):
                    existing["secrets"] = acl.get("secrets")
                continue
            seen[initiator] = signature
            merged.append(acl)
    return merged

def chap_enabled_for_acl(acl):
    config = acl.get("config") or {}
    return bool(config.get("chapEnabled")) or bool(config.get("mutualChapEnabled"))

def target_acl_auth(iqn, initiator):
    result = run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "get", "auth", "userid", "password", "mutual_userid", "mutual_password")
    values = {}
    for line in (result.stdout or "").splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    return values

def previous_acl_auth_map(iqn):
    values = {}
    root = Path("/sys/kernel/config/target/iscsi") / str(iqn) / "tpgt_1" / "acls"
    if not root.exists():
        return values
    for item in root.iterdir():
        if item.is_dir():
            values[item.name] = target_acl_auth(iqn, item.name)
    return values

def require_chap_value(name, value, iqn, initiator):
    if value:
        return value
    raise SystemExit(f"iSCSI CHAP credential is required to apply target {iqn} for initiator {initiator}: missing {name}")

def managed_iqn(iqn):
    text = str(iqn or "")
    return text.startswith("iqn.") and ".local.storage:" in text

def existing_iscsi_targets():
    root = Path("/sys/kernel/config/target/iscsi")
    if not root.exists():
        return set()
    return {item.name for item in root.iterdir() if item.is_dir() and managed_iqn(item.name)}

def desired_iqns_from_payload(value):
    iqns = set()
    for target in value.get("targets", []) or []:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        iqn = target.get("targetName")
        if iqn and managed_iqn(iqn):
            iqns.add(iqn)
    return iqns

def block_backstores_from_payload(value, iqns=None):
    names = set()
    for target in value.get("targets", []) or []:
        iqn = target.get("targetName")
        if iqns is not None and iqn not in iqns:
            continue
        uuid = target.get("uuid")
        if uuid:
            names.add(f"ablestack-{uuid}")
    return names

def existing_managed_block_backstores():
    root = Path("/sys/kernel/config/target/core")
    if not root.exists():
        return set()
    names = set()
    for path in root.glob("iblock_*/*"):
        if path.is_dir() and path.name.startswith("ablestack-"):
            names.add(path.name)
    return names

def cleanup_stale_managed_targets(desired_iqns):
    previous_iqns = desired_iqns_from_payload(previous_payload)
    stale_iqns = (existing_iscsi_targets() | previous_iqns) - desired_iqns
    for iqn in sorted(stale_iqns):
        if managed_iqn(iqn):
            run_targetcli("/iscsi", "delete", iqn)
    stale_backstores = block_backstores_from_payload(previous_payload, stale_iqns)
    if not desired_iqns:
        stale_backstores |= existing_managed_block_backstores()
    for name in sorted(stale_backstores):
        run_targetcli("/backstores/block", "delete", name)

def clear_managed_iscsi_runtime():
    for iqn in sorted(existing_iscsi_targets()):
        run_targetcli("/iscsi", "delete", iqn)
    for name in sorted(existing_managed_block_backstores()):
        run_targetcli("/backstores/block", "delete", name)

def rollback_created(created_iqns, created_backstores):
    for iqn in reversed(created_iqns):
        run_targetcli("/iscsi", "delete", iqn)
    for name in reversed(created_backstores):
        run_targetcli("/backstores/block", "delete", name)

if enabled and targets:
    ensure_iscsi_runtime_dependencies()
if enabled and command_exists("targetcli"):
    desired_iqns = set(active_targets_by_iqn(targets).keys())
    if os.environ.get("ABLESTACK_STORAGE_ISCSI_AUTHORITATIVE_REBUILD") == "1":
        clear_managed_iscsi_runtime()
    from rtslib_fb import RTSRoot
    root = RTSRoot()
    session_targets = set()
    for session in root.sessions:
        node_acl = session.get("parent_nodeacl")
        if node_acl is not None:
            session_targets.add(node_acl.parent_tpg.parent_target.wwn)
    previous_groups = active_targets_by_iqn(previous_payload.get("targets", []))
    desired_groups = active_targets_by_iqn(targets)
    for iqn in session_targets:
        old_luns = {(str(v.get("lunOrNamespace") or "0"), v.get("volumeUuid")) for v in previous_groups.get(iqn, [])}
        new_luns = {(str(v.get("lunOrNamespace") or "0"), v.get("volumeUuid")) for v in desired_groups.get(iqn, [])}
        if old_luns - new_luns:
            raise SystemExit("active iSCSI sessions prevent a destructive target/backing change")
        old_portals = {(p.ip_address, p.port) for target in root.targets if target.wwn == iqn for tpg in target.tpgs for p in tpg.network_portals}
        new_portals = {(v["listenIp"], int(v["port"])) for v in merged_listeners_for_targets(desired_groups.get(iqn, []), listeners)}
        if old_portals - new_portals:
            raise SystemExit("active iSCSI sessions prevent removal of a listener portal")
    for iqn, group_targets in desired_groups.items():
        previous_auth = previous_acl_auth_map(iqn)
        merged_listeners_for_targets(group_targets, listeners)
        for target in group_targets:
            validate_block_backstore_device(find_backing_path(target))
        for acl in merged_acls_for_targets(group_targets):
            config = acl.get("config") or {}
            secret = acl.get("secrets") or {}
            old = previous_auth.get(acl.get("principal"), {})
            if config.get("chapEnabled"):
                require_chap_value("chapUsername", config.get("chapUsername"), iqn, acl.get("principal"))
                require_chap_value("chapSecret", secret.get("chapSecret") or old.get("password"), iqn, acl.get("principal"))
            if config.get("mutualChapEnabled"):
                require_chap_value("mutualChapUsername", config.get("mutualChapUsername"), iqn, acl.get("principal"))
                require_chap_value("mutualChapSecret", secret.get("mutualChapSecret") or old.get("mutual_password"), iqn, acl.get("principal"))
    created_iqns = []
    created_backstores = []
    for target in targets:
        if target.get("state", "Ready") in ("Disabled", "Destroyed", "Error") or target.get("targetName"):
            continue
        skipped += 1
    try:
        for iqn, group_targets in active_targets_by_iqn(targets).items():
            previous_auth = previous_acl_auth_map(iqn)
            existing_target = (Path("/sys/kernel/config/target/iscsi") / iqn).exists()
            require_targetcli("/iscsi", "create", iqn)
            if not existing_target:
                created_iqns.append(iqn)
            group_listeners = merged_listeners_for_targets(group_targets, listeners)
            if not existing_target and not any(v["listenIp"] == "0.0.0.0" and v["port"] == 3260 for v in group_listeners):
                run_targetcli(f"/iscsi/{iqn}/tpg1/portals", "delete", "0.0.0.0", "3260")
            required_ports.update({item["port"] for item in group_listeners})
            for listener in group_listeners:
                create_iscsi_portal(iqn, listener["listenIp"], listener["port"])
            for target in group_targets:
                lun = str(target.get("lunOrNamespace") or "0")
                backstore = f"ablestack-{target.get('uuid')}"
                backstore_path, backing_path, backstore_type, created_backstore = resolve_backstore(target, backstore)
                if created_backstore:
                    created_backstores.append(backstore)
                require_targetcli(f"/iscsi/{iqn}/tpg1/luns", "create", backstore_path, lun)
                applied += 1
                runtime_targets.append({
                    "uuid": target.get("uuid"),
                    "targetName": iqn,
                    "lunOrNamespace": lun,
                    "volumeUuid": target.get("volumeUuid"),
                    "volumeName": target.get("volumeName"),
                    "volumeSizeBytes": target.get("volumeSizeBytes"),
                    "lunSizeBytes": target.get("lunSizeBytes") or (target.get("config") or {}).get("lunSizeBytes"),
                    "effectiveSizeBytes": target_size_bytes(target, backing_path),
                    "backingPath": backing_path,
                    "backstoreType": backstore_type,
                    "listenerPorts": sorted({item["port"] for item in group_listeners}),
                    "endpoints": [f"{item['listenIp']}:{item['port']}" for item in group_listeners],
                })
            chap_required = False
            for acl in merged_acls_for_targets(group_targets):
                initiator = acl.get("principal")
                require_targetcli(f"/iscsi/{iqn}/tpg1/acls", "create", initiator)
                acl_config = acl.get("config") or {}
                secrets = acl.get("secrets") or {}
                old_auth = previous_auth.get(initiator, {})
                if chap_enabled_for_acl(acl):
                    chap_required = True
                if acl_config.get("chapEnabled"):
                    username = require_chap_value("chapUsername", acl_config.get("chapUsername"), iqn, initiator)
                    password = secrets.get("chapSecret") or old_auth.get("password")
                    password = require_chap_value("chapSecret", password, iqn, initiator)
                    secrets["chapSecret"] = password
                    require_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"userid={username}")
                    require_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"password={password}")
                else:
                    run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", "userid=")
                    run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", "password=")
                if acl_config.get("mutualChapEnabled"):
                    mutual_username = require_chap_value("mutualChapUsername", acl_config.get("mutualChapUsername"), iqn, initiator)
                    mutual_password = secrets.get("mutualChapSecret") or old_auth.get("mutual_password")
                    mutual_password = require_chap_value("mutualChapSecret", mutual_password, iqn, initiator)
                    secrets["mutualChapSecret"] = mutual_password
                    require_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"mutual_userid={mutual_username}")
                    require_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", f"mutual_password={mutual_password}")
                else:
                    run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", "mutual_userid=")
                    run_targetcli(f"/iscsi/{iqn}/tpg1/acls/{initiator}", "set", "auth", "mutual_password=")
            require_targetcli(f"/iscsi/{iqn}/tpg1", "set", "attribute", f"authentication={1 if chap_required else 0}")
            from rtslib_fb import FabricModule, Target, TPG
            native_tpg = TPG(Target(FabricModule("iscsi"), iqn, mode="lookup"), 1, mode="lookup")
            wanted_portals = {(v["listenIp"], int(v["port"])) for v in group_listeners}
            for portal in list(native_tpg.network_portals):
                if (portal.ip_address, portal.port) not in wanted_portals:
                    portal.delete()
            acl_root = Path("/sys/kernel/config/target/iscsi") / iqn / "tpgt_1" / "acls"
            desired_initiators = {acl.get("principal") for acl in merged_acls_for_targets(group_targets)}
            if acl_root.exists():
                for old_acl in acl_root.iterdir():
                    if old_acl.is_dir() and old_acl.name not in desired_initiators:
                        require_targetcli(f"/iscsi/{iqn}/tpg1/acls", "delete", old_acl.name)
            lun_root = Path("/sys/kernel/config/target/iscsi") / iqn / "tpgt_1" / "lun"
            desired_luns = {str(target.get("lunOrNamespace") or "0") for target in group_targets}
            if lun_root.exists():
                for old_lun in lun_root.iterdir():
                    number = old_lun.name.removeprefix("lun_")
                    if old_lun.is_dir() and number not in desired_luns:
                        require_targetcli(f"/iscsi/{iqn}/tpg1/luns", "delete", number)

    except BaseException:
        rollback_created(created_iqns, created_backstores)
        raise
    cleanup_stale_managed_targets(desired_iqns)
    merge_and_persist_iscsi_secrets(payload)
    run_targetcli("saveconfig")
else:
    skipped = len(payload.get("targets", []))

if enabled and applied:
    service_action("start")
    for port in required_ports:
        best_effort_firewall(port)
    for _ in range(10):
        if all(port_listening(port) for port in required_ports):
            break
        time.sleep(0.5)
    missing_ports = [port for port in sorted(required_ports) if not port_listening(port)]
    if missing_ports:
        raise SystemExit(f"iSCSI target service did not listen on TCP port(s): {', '.join(str(port) for port in missing_ports)}")

print(json.dumps({"success": True, "targets": len(payload.get("targets", [])), "applied": applied, "skipped": skipped, "ports": sorted(required_ports), "listening": all(port_listening(port) for port in required_ports), "runtimeTargets": runtime_targets}))
PY

  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now target >/dev/null 2>&1 || systemctl enable --now rtslib-fb-targetctl >/dev/null 2>&1 || true
    systemctl start target >/dev/null 2>&1 || systemctl start rtslib-fb-targetctl >/dev/null 2>&1 || true
  fi
}

apply_nvmeof_subsystems() {
  local payload_file="$1"

  network_endpoint_apply "$payload_file" >/dev/null

  python3 - "$payload_file" <<'PY'
import json
import os
import subprocess
import sys
import glob
import time
import errno
sys.path.insert(0, __import__("os").environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from nvmeof_identity import NamespaceIdentityStore

payload_path = sys.argv[1]
with open(payload_path, "r", encoding="utf-8") as payload_fp:
    payload = json.load(payload_fp)

state_dir = "/etc/ablestack-storage"
os.makedirs(state_dir, exist_ok=True)
identity_store = NamespaceIdentityStore(os.path.join(state_dir, "nvmeof-namespace-identities.json"))
configuration_transaction = os.environ.get("ABLESTACK_STORAGE_CONFIGURATION_TRANSACTION") == "1"
previous_payload = {}
if configuration_transaction:
    try:
        with open(os.path.join(state_dir, "nvmeof-subsystems.json"), encoding="utf-8") as previous_fp:
            previous_payload = json.load(previous_fp)
    except FileNotFoundError:
        pass

def write_file(path, value):
    with open(path, "w", encoding="utf-8") as fp:
        fp.write(str(value))

def read_file(path):
    try:
        with open(path, "r", encoding="utf-8") as fp:
            return fp.read().strip()
    except OSError:
        return None

def write_if_changed(path, value):
    desired = str(value)
    if read_file(path) != desired:
        write_file(path, desired)

def ensure_dir(path):
    os.makedirs(path, exist_ok=True)

def safe_write_if_exists(path, value):
    if value and os.path.exists(path):
        write_if_changed(path, value)

SENSITIVE_KEYS = {
    "secrets",
    "secret",
    "password",
    "passwords",
    "key",
    "keys",
    "dhChapKey",
    "dhChapCtrlKey",
    "chapSecret",
    "mutualChapSecret",
}

def redact_sensitive(value):
    if isinstance(value, list):
        return [redact_sensitive(item) for item in value]
    if isinstance(value, dict):
        redacted = {}
        for key, item in value.items():
            lower_key = str(key).lower()
            if key in SENSITIVE_KEYS or "secret" in lower_key or "password" in lower_key or lower_key.endswith("key"):
                continue
            redacted[key] = redact_sensitive(item)
        return redacted
    return value

def write_required_configfs(path, value, feature):
    if not value:
        if os.path.exists(path) and read_file(path):
            return
        raise SystemExit(f"{feature} is enabled but no secret was supplied in the runtime request")
    if not os.path.exists(path):
        raise SystemExit(f"{feature} is not supported by this System VM kernel/configfs: missing {path}")
    write_if_changed(path, value)

def run(args, timeout=20):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)

def lsblk_devices():
    result = run(["lsblk", "-b", "-J", "-o", "NAME,PATH,TYPE,FSTYPE,UUID,SERIAL,SIZE,MOUNTPOINT"], timeout=20)
    if result.returncode != 0:
        return []
    try:
        return json.loads(result.stdout).get("blockdevices", [])
    except Exception:
        return []

def walk_devices(devices):
    for dev in devices:
        yield dev
        for child in dev.get("children") or []:
            yield from walk_devices([child])

def normalize_token(value):
    return str(value or "").replace("-", "").replace("_", "").lower()

def token_matches_text(token, text):
    if not token or not text:
        return False
    return token in text or text in token or (len(token) >= 16 and token[:16] in text)

def matchable_tokens(target):
    config = target.get("config") or {}
    candidates = [
        target.get("volumeUuid"),
        target.get("volumeName"),
        config.get("volumeUuid"),
        config.get("volumeName"),
        config.get("volumeSerial"),
    ]
    tokens = []
    for candidate in candidates:
        token = normalize_token(candidate)
        if len(token) >= 8 and not token.isdigit():
            tokens.append(token)
    return tokens

def match_by_id(tokens):
    tokens = [normalize_token(token) for token in tokens if token]
    if not tokens:
        return None
    for path in glob.glob("/dev/disk/by-id/*"):
        text = normalize_token(os.path.basename(path))
        if any(token_matches_text(token, text) for token in tokens):
            return os.path.realpath(path)
    return None

def find_backing_path(target):
    config = target.get("config") or {}
    configured = config.get("backingPath") or target.get("backingPath")
    if configured and os.path.exists(configured):
        return configured
    tokens = matchable_tokens(target)
    matched = match_by_id(tokens)
    if matched:
        return matched
    for dev in walk_devices(lsblk_devices()):
        fields = [normalize_token(dev.get(key)) for key in ("name", "path", "serial", "uuid")]
        if any(token_matches_text(token, field) for token in tokens for field in fields):
            return dev.get("path")
    raise SystemExit(f"unable to resolve backing block device for NVMe-oF namespace {target.get('targetName') or target.get('uuid')}; volumeUuid or volumeName did not match any guest disk")

def mountpoint_for_device(path):
    result = run(["findmnt", "-n", "-o", "TARGET", "--source", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.strip().splitlines()[0]
    return ""

def device_size_bytes(path):
    result = run(["lsblk", "-b", "-dn", "-o", "SIZE", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip().isdigit():
        return int(result.stdout.strip())
    if os.path.exists(path):
        return os.path.getsize(path)
    raise SystemExit(f"unable to determine backing size for {path}")

def namespace_size_bytes(namespace, backing_path):
    config = namespace.get("config") or {}
    value = config.get("namespaceSizeBytes") or namespace.get("namespaceSizeBytes") or namespace.get("effectiveSizeBytes") or namespace.get("volumeSizeBytes")
    if value:
        return int(value)
    return device_size_bytes(backing_path)

def loop_for_file(path):
    result = run(["losetup", "-j", path], timeout=8)
    if result.returncode == 0 and result.stdout.strip():
        return result.stdout.split(":", 1)[0].strip()
    result = run(["losetup", "--find", "--show", path], timeout=20)
    if result.returncode != 0 or not result.stdout.strip():
        raise SystemExit((result.stderr or result.stdout or f"unable to create loop device for {path}").strip())
    return result.stdout.strip()

def resolve_namespace_device(namespace):
    path = find_backing_path(namespace)
    config = namespace.get("config") or {}
    mountpoint = mountpoint_for_device(path)
    if mountpoint:
        raise SystemExit(f"backing device {path} is mounted at {mountpoint}; NVMe-oF namespaces require a dedicated raw block volume")
    return path, "block"

def desired_listeners():
    raw = payload.get("listeners") or []
    listeners = []
    seen = set()
    for listener in raw:
        listen_ip = str(listener.get("listenIp") or "0.0.0.0")
        port = int(listener.get("port") or payload.get("port") or 4420)
        key = (listen_ip, port)
        if key in seen:
            continue
        seen.add(key)
        listeners.append({"listenIp": listen_ip, "port": port})
    if not listeners:
        listeners.append({"listenIp": payload.get("listenIp") or "0.0.0.0", "port": int(payload.get("port") or 4420)})
    wildcard_ports = {int(listener["port"]) for listener in listeners if str(listener["listenIp"]) == "0.0.0.0"}
    normalized = []
    normalized_seen = set()
    for listener in listeners:
        port = int(listener["port"])
        listen_ip = str(listener["listenIp"])
        if port in wildcard_ports and listen_ip != "0.0.0.0":
            continue
        key = (listen_ip, port)
        if key in normalized_seen:
            continue
        normalized_seen.add(key)
        normalized.append(listener)
    return normalized

def listener_ports_for_subsystem(subsystem, all_listeners):
    ports = set()
    for namespace in subsystem.get("namespaces", []):
        config = namespace.get("config") or {}
        for value in config.get("listenerGroupPorts") or config.get("listenerports") or []:
            try:
                ports.add(int(value))
            except Exception:
                pass
    if not ports:
        ports.add(int(payload.get("port") or 4420))
    available = {int(listener["port"]) for listener in all_listeners}
    missing = sorted(ports - available)
    if missing:
        raise SystemExit(f"NVMe-oF namespace requested listener port group(s) that are not enabled: {', '.join(str(port) for port in missing)}")
    return ports

def resource_is_active(resource):
    return str(resource.get("state", "Ready")) not in ("Disabled", "Destroyed", "Error")

def merge_nvmeof_resource_list(items, key_func):
    merged = {}
    ordered = []
    for item in items or []:
        key = key_func(item)
        if not key:
            continue
        existing = merged.get(key)
        if existing is None:
            merged[key] = item
            ordered.append(item)
            continue
        should_replace = False
        if not resource_is_active(existing) and resource_is_active(item):
            should_replace = True
        elif not existing.get("secrets") and item.get("secrets"):
            should_replace = True
        elif not existing.get("permission") and item.get("permission"):
            should_replace = True
        if should_replace:
            index = ordered.index(existing)
            ordered[index] = item
            merged[key] = item
    return ordered

def merge_nvmeof_subsystems(subsystems):
    merged = {}
    ordered = []
    for subsystem in subsystems or []:
        nqn = subsystem.get("targetName")
        if not nqn:
            continue
        current = merged.get(nqn)
        if current is None:
            current = dict(subsystem)
            current["config"] = dict(subsystem.get("config") or {})
            current["namespaces"] = list(subsystem.get("namespaces") or [])
            current["hosts"] = list(subsystem.get("hosts") or [])
            merged[nqn] = current
            ordered.append(current)
            continue
        config = subsystem.get("config") or {}
        current_config = current.setdefault("config", {})
        if config.get("allowAnyHost"):
            current_config["allowAnyHost"] = True
        for key in ("engine", "engineState", "transport"):
            if not current_config.get(key) and config.get(key):
                current_config[key] = config[key]
        if not resource_is_active(current) and resource_is_active(subsystem):
            current["state"] = subsystem.get("state", "Ready")
        current["namespaces"].extend(subsystem.get("namespaces") or [])
        current["hosts"].extend(subsystem.get("hosts") or [])
    for subsystem in ordered:
        subsystem["namespaces"] = merge_nvmeof_resource_list(
            subsystem.get("namespaces") or [],
            lambda namespace: str(namespace.get("lunOrNamespace") or "1"),
        )
        subsystem["hosts"] = merge_nvmeof_resource_list(
            subsystem.get("hosts") or [],
            lambda host: host.get("principal"),
        )
    return ordered

def unlink_all_subsystems(port_dir):
    subsystem_dir = os.path.join(port_dir, "subsystems")
    if not os.path.isdir(subsystem_dir):
        return
    for name in os.listdir(subsystem_dir):
        path = os.path.join(subsystem_dir, name)
        if os.path.islink(path):
            os.unlink(path)

def remove_port_dir(port_dir):
    unlink_all_subsystems(port_dir)
    try:
        os.rmdir(port_dir)
    except OSError as exc:
        if exc.errno not in (errno.ENOENT, errno.ENOTEMPTY, errno.EBUSY):
            raise

def read_port_tuple(port_dir):
    trtype = read_file(os.path.join(port_dir, "addr_trtype"))
    adrfam = read_file(os.path.join(port_dir, "addr_adrfam"))
    traddr = read_file(os.path.join(port_dir, "addr_traddr"))
    trsvcid = read_file(os.path.join(port_dir, "addr_trsvcid"))
    if trtype and trtype != "tcp":
        return None
    if adrfam and adrfam != "ipv4":
        return None
    if not traddr or not trsvcid:
        return None
    try:
        return (traddr, int(trsvcid))
    except Exception:
        return None

def existing_port_map(base):
    ports_root = os.path.join(base, "ports")
    mapped = {}
    used = set()
    if not os.path.isdir(ports_root):
        return mapped, used
    for port_id in os.listdir(ports_root):
        used.add(str(port_id))
        port_dir = os.path.join(ports_root, port_id)
        if not os.path.isdir(port_dir):
            continue
        key = read_port_tuple(port_dir)
        if key:
            mapped.setdefault(key, []).append(str(port_id))
    return mapped, used

def allocate_port_id(used):
    for candidate in range(1, 4096):
        value = str(candidate)
        if value not in used:
            used.add(value)
            return value
    raise SystemExit("unable to allocate NVMe-oF configfs port id")

def configure_new_port(port_dir, listen_ip, port):
    ensure_dir(port_dir)
    write_if_changed(os.path.join(port_dir, "addr_trtype"), "tcp")
    write_if_changed(os.path.join(port_dir, "addr_adrfam"), "ipv4")
    write_if_changed(os.path.join(port_dir, "addr_traddr"), listen_ip)
    write_if_changed(os.path.join(port_dir, "addr_trsvcid"), port)

def ensure_listener_port(base, listener, existing, used):
    key = (str(listener["listenIp"]), int(listener["port"]))
    port_ids = existing.get(key) or []
    if port_ids:
        return str(port_ids[0])
    port_id = allocate_port_id(used)
    port_dir = os.path.join(base, "ports", port_id)
    configure_new_port(port_dir, key[0], key[1])
    existing.setdefault(key, []).append(port_id)
    return port_id

def link_once(source, link_path):
    if os.path.islink(link_path) and os.path.realpath(link_path) == os.path.realpath(source):
        return
    if os.path.exists(link_path):
        raise SystemExit(f"NVMe-oF configfs path already exists and is not the expected symlink: {link_path}")
    os.symlink(source, link_path)

def unlink_stale_symlinks(parent_dir, desired_names):
    if not os.path.isdir(parent_dir):
        return
    for name in os.listdir(parent_dir):
        path = os.path.join(parent_dir, name)
        if name not in desired_names and os.path.islink(path):
            os.unlink(path)

def remove_stale_managed_port_links(base, desired_listener_keys, desired_subsystems_by_listener, active_subsystem_names):
    ports_root = os.path.join(base, "ports")
    if not os.path.isdir(ports_root):
        return
    for port_id in os.listdir(ports_root):
        port_dir = os.path.join(ports_root, port_id)
        if not os.path.isdir(port_dir):
            continue
        key = read_port_tuple(port_dir)
        subsystems_dir = os.path.join(port_dir, "subsystems")
        if key in desired_listener_keys:
            unlink_stale_symlinks(subsystems_dir, desired_subsystems_by_listener.get(key, set()))
            continue
        touched = False
        if os.path.isdir(subsystems_dir):
            for name in os.listdir(subsystems_dir):
                path = os.path.join(subsystems_dir, name)
                if name in active_subsystem_names and os.path.islink(path):
                    os.unlink(path)
                    touched = True
        if touched:
            remove_port_dir(port_dir)

enabled = bool(payload.get("enabled", True))
base = "/sys/kernel/config/nvmet"
applied = 0
skipped = 0
if enabled:
    subprocess.run(["modprobe", "nvmet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["modprobe", "nvmet-tcp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if enabled and os.path.isdir(base):
    listeners = desired_listeners()
    payload["subsystems"] = merge_nvmeof_subsystems(payload.get("subsystems") or [])
    if configuration_transaction:
        def namespace_identities(value):
            return {(sub.get("targetName"), str(ns.get("lunOrNamespace") or "1"), ns.get("volumeUuid"))
                    for sub in value.get("subsystems", []) for ns in sub.get("namespaces", [])
                    if ns.get("state", "Ready") not in ("Disabled", "Destroyed", "Error")}
        removed_namespaces = namespace_identities(previous_payload) - namespace_identities(payload)
        if removed_namespaces:
            ports_before = {str(v.get("port") or 4420) for v in previous_payload.get("listeners", [])}
            ports_before.add(str(previous_payload.get("port") or 4420))
            sessions = run(["ss", "-H", "-tn", "state", "established"], timeout=8)
            if sessions.returncode != 0:
                raise SystemExit("unable to observe NVMe-oF sessions before a destructive change")
            if any(len(row.split()) > 3 and row.split()[2].rsplit(":", 1)[-1] in ports_before
                   for row in sessions.stdout.splitlines()):
                raise SystemExit("active NVMe-oF sessions prevent a destructive namespace/backing change")
    active_subsystems = []
    for subsystem in payload.get("subsystems", []):
        if subsystem.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
            continue
        nqn = subsystem.get("targetName")
        if not nqn:
            skipped += 1
            continue
        config = subsystem.get("config") or {}
        engine = str(config.get("engine") or "KERNEL_NVMET").upper()
        if engine != "KERNEL_NVMET":
            skipped += 1
            continue
        active_subsystems.append(subsystem)
    active_listeners = listeners if active_subsystems else []
    active_subsystem_names = {subsystem.get("targetName") for subsystem in active_subsystems if subsystem.get("targetName")}
    existing_ports, used_port_ids = existing_port_map(base)
    listener_port_ids = {}
    desired_listener_keys = set()
    desired_subsystems_by_listener = {}
    for listener in active_listeners:
        key = (str(listener["listenIp"]), int(listener["port"]))
        desired_listener_keys.add(key)
        desired_subsystems_by_listener.setdefault(key, set())
        listener_port_ids[key] = ensure_listener_port(base, listener, existing_ports, used_port_ids)
    for subsystem in active_subsystems:
        nqn = subsystem.get("targetName")
        subsystem_ports = listener_ports_for_subsystem(subsystem, active_listeners)
        subsystem["runtimeListenerPorts"] = sorted(subsystem_ports)
        for listener in active_listeners:
            key = (str(listener["listenIp"]), int(listener["port"]))
            if int(listener["port"]) in subsystem_ports:
                desired_subsystems_by_listener.setdefault(key, set()).add(nqn)
    remove_stale_managed_port_links(base, desired_listener_keys, desired_subsystems_by_listener, active_subsystem_names)

    for subsystem in active_subsystems:
        nqn = subsystem.get("targetName")
        subsystem_dir = os.path.join(base, "subsystems", nqn)
        config = subsystem.get("config") or {}
        ensure_dir(subsystem_dir)
        allow_any_host = bool(config.get("allowAnyHost"))
        write_if_changed(os.path.join(subsystem_dir, "attr_allow_any_host"), "1" if allow_any_host else "0")
        desired_hosts = set()
        if allow_any_host:
            unlink_stale_symlinks(os.path.join(subsystem_dir, "allowed_hosts"), desired_hosts)
        else:
            for host in subsystem.get("hosts", []):
                host_nqn = host.get("principal")
                if host_nqn:
                    desired_hosts.add(host_nqn)
                    host_dir = os.path.join(base, "hosts", host_nqn)
                    ensure_dir(host_dir)
                    host_config = host.get("config") or {}
                    host_secrets = host.get("secrets") or {}
                    if host_config.get("dhChapEnabled"):
                        write_required_configfs(os.path.join(host_dir, "dhchap_key"), host_secrets.get("dhChapKey"), "NVMe-oF DH-HMAC-CHAP host authentication")
                    if host_config.get("dhChapCtrlEnabled"):
                        write_required_configfs(os.path.join(host_dir, "dhchap_ctrl_key"), host_secrets.get("dhChapCtrlKey"), "NVMe-oF DH-HMAC-CHAP controller authentication")
                    allowed_host_path = os.path.join(subsystem_dir, "allowed_hosts", host_nqn)
                    link_once(host_dir, allowed_host_path)
            unlink_stale_symlinks(os.path.join(subsystem_dir, "allowed_hosts"), desired_hosts)
        for namespace in subsystem.get("namespaces", []):
            if namespace.get("state", "Ready") in ("Disabled", "Destroyed", "Error"):
                continue
            nsid = str(namespace.get("lunOrNamespace") or "1")
            backing_path, backing_type = resolve_namespace_device(namespace)
            ns_dir = os.path.join(subsystem_dir, "namespaces", nsid)
            ensure_dir(ns_dir)
            identity_store.prepare(ns_dir, nqn, namespace, backing_path)
            current_device = read_file(os.path.join(ns_dir, "device_path"))
            enabled_now = read_file(os.path.join(ns_dir, "enable")) == "1"
            if current_device != backing_path:
                if enabled_now:
                    write_if_changed(os.path.join(ns_dir, "enable"), "0")
                    for _ in range(10):
                        if read_file(os.path.join(ns_dir, "enable")) != "1":
                            break
                        time.sleep(0.1)
                write_if_changed(os.path.join(ns_dir, "device_path"), backing_path)
            write_if_changed(os.path.join(ns_dir, "enable"), "1")
            identity_store.verify(ns_dir, nqn, namespace)
            namespace["runtime"] = {"backingPath": backing_path, "backingType": backing_type}
        if configuration_transaction:
            desired_nsids = {str(ns.get("lunOrNamespace") or "1") for ns in subsystem.get("namespaces", [])
                             if ns.get("state", "Ready") not in ("Disabled", "Destroyed", "Error")}
            namespace_root = os.path.join(subsystem_dir, "namespaces")
            for old_nsid in os.listdir(namespace_root):
                if old_nsid not in desired_nsids:
                    old_namespace = os.path.join(namespace_root, old_nsid)
                    write_if_changed(os.path.join(old_namespace, "enable"), "0")
                    os.rmdir(old_namespace)
        subsystem_ports = set(subsystem.get("runtimeListenerPorts") or listener_ports_for_subsystem(subsystem, active_listeners))
        for listener in active_listeners:
            listener_key = (str(listener["listenIp"]), int(listener["port"]))
            if int(listener["port"]) not in subsystem_ports:
                continue
            port_id = listener_port_ids.get(listener_key)
            if not port_id:
                continue
            port_dir = os.path.join(base, "ports", port_id)
            link_path = os.path.join(port_dir, "subsystems", nqn)
            link_once(subsystem_dir, link_path)
        applied += 1
else:
    skipped = len(payload.get("subsystems", []))

if configuration_transaction:
    desired_names = {sub.get("targetName") for sub in payload.get("subsystems", [])
                     if sub.get("state", "Ready") not in ("Disabled", "Destroyed", "Error")}
    previous_names = {sub.get("targetName") for sub in previous_payload.get("subsystems", [])}
    for old_name in previous_names - desired_names:
        if not old_name or "/" in old_name or not old_name.startswith("nqn."):
            raise SystemExit("invalid owned NVMe-oF subsystem identity")
        old_subsystem = os.path.join("/sys/kernel/config/nvmet/subsystems", old_name)
        if not os.path.isdir(old_subsystem):
            continue
        ports_root = "/sys/kernel/config/nvmet/ports"
        for port_id in os.listdir(ports_root):
            link = os.path.join(ports_root, port_id, "subsystems", old_name)
            if os.path.islink(link):
                os.unlink(link)
        for nsid in os.listdir(os.path.join(old_subsystem, "namespaces")):
            directory = os.path.join(old_subsystem, "namespaces", nsid)
            write_if_changed(os.path.join(directory, "enable"), "0")
            os.rmdir(directory)
        for host in os.listdir(os.path.join(old_subsystem, "allowed_hosts")):
            os.unlink(os.path.join(old_subsystem, "allowed_hosts", host))
        os.rmdir(old_subsystem)

state_payload = redact_sensitive(dict(payload))
state_payload["lastApply"] = {"success": True, "applied": applied, "skipped": skipped}
with open(os.path.join(state_dir, "nvmeof-subsystems.json"), "w", encoding="utf-8") as state_fp:
    json.dump(state_payload, state_fp, sort_keys=True, indent=2)

print(json.dumps({"success": True, "subsystems": len(payload.get("subsystems", [])), "applied": applied, "skipped": skipped}))
PY
}

command="${1:-}"
subcommand="${2:-}"
action="${3:-}"
payload="${4:-}"

case "$command" in
  directory)
    if [[ "$subcommand" != "policy" || ! "$action" =~ ^(inspect|preview)$ || ! -r "$payload" ]]; then
      emit_error "Invalid directory observation."
      exit 2
    fi
    exec python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/shared_directory_policy.py" "$action" "$payload"
    ;;
  configuration)
    if [[ "$subcommand" == "ad-domain" && "$action" == "show" ]]; then
      exec python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/configuration_transaction.py" ad-domain show "$payload"
    fi
    if [[ "$subcommand" == "preflight" && "$action" == "show" && -r "$payload" ]]; then
      exec python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/configuration_transaction.py" preflight show "$payload"
    fi
    if [[ "$subcommand" == "capability" && "$action" == "show" ]]; then
      exec python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/configuration_transaction.py" capability show
    fi
    if [[ "$subcommand" != "operation" || ! "$action" =~ ^(apply|show|resume|commit)$ || -z "$payload" || ! -r "$payload" ]]; then
      emit_error "Invalid configuration transaction operation."
      exit 2
    fi
    exec python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/configuration_transaction.py" operation "$action" "$payload"
    ;;
  apply)
    payload="${2:-}"
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for apply."
      exit 2
    fi
    log_command "$command" "$payload"
    emit_success "Storage Service apply skeleton accepted the payload."
    ;;
  health)
    log_command "$command" ""
    runtime_health
    ;;
  inventory)
    log_command "$command" ""
    runtime_inventory
    ;;
  sessions)
    payload="${2:-}"
    log_command "$command" "$payload"
    runtime_sessions "$payload"
    ;;
  session)
    payload="${3:-}"
    if [[ "$subcommand" != "disconnect" ]]; then
      emit_error "Unsupported session operation: ${subcommand:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for session disconnect."
      exit 2
    fi
    log_command "$command $subcommand" "$payload"
    session_disconnect "$payload"
    ;;
  network)
    if [[ "$subcommand" == "endpoint" && "$action" == "apply" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for network endpoint apply."
        exit 2
      fi
      log_command "$command $subcommand $action" "$payload"
      network_endpoint_apply "$payload"
    elif [[ "$subcommand" == "endpoints" && "$action" == "reconcile" ]]; then
      log_command "$command $subcommand $action" ""
      network_endpoints_reconcile
    else
      emit_error "Unsupported network operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    ;;
  volume)
    if [[ "$subcommand" == "prepare" && ( "$action" == "start" || "$action" == "status" || "$action" == "resume" ) ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for initial volume preparation."
        exit 2
      fi
      python3 "${ABLESTACK_STORAGE_HELPER_ROOT}/volume_preparation.py" "$action" "$payload"
    elif [[ "$subcommand" == "attach" && "$action" == "inspect" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume attach inspect."
        exit 2
      fi
      log_command "$command $subcommand $action" "$payload"
      volume_attach_inspect "$payload"
    elif [[ "$subcommand" == "detach" && "$action" == "prepare" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume detach prepare."
        exit 2
      fi
      log_command "$command $subcommand $action" "$payload"
      volume_detach_prepare "$payload"
    elif [[ "$subcommand" == "rescan" ]]; then
      payload="${3:-}"
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for volume rescan."
        exit 2
      fi
      log_command "$command $subcommand" "$payload"
      volume_rescan "$payload"
    else
      emit_error "Unsupported volume operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    ;;
  filesystem)
    payload="${3:-}"
    if [[ "$subcommand" != "resize" ]]; then
      emit_error "Unsupported filesystem operation: ${subcommand:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for filesystem resize."
      exit 2
    fi
    log_command "$command $subcommand" "$payload"
    filesystem_resize "$payload"
    ;;
  nfs)
    if [[ "$subcommand" != "export" || "$action" != "apply" ]]; then
      emit_error "Unsupported nfs operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for nfs export apply."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    apply_nfs_exports "$payload"
    ;;
  smb)
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for smb ${subcommand:-<empty>} ${action:-<empty>}."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    case "$subcommand $action" in
      "share apply")
        apply_smb_shares "$payload"
        ;;
      "domain join")
        smb_domain_join "$payload"
        ;;
      "domain leave")
        smb_domain_leave "$payload"
        ;;
      *)
        emit_error "Unsupported smb operation: ${subcommand:-<empty>} ${action:-<empty>}"
        exit 2
        ;;
    esac
    ;;
  iscsi)
    if [[ "$subcommand" != "target" || "$action" != "apply" ]]; then
      emit_error "Unsupported iscsi operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    if [[ -z "$payload" || ! -r "$payload" ]]; then
      emit_error "A readable payload file is required for iscsi target apply."
      exit 2
    fi
    log_command "$command $subcommand $action" "$payload"
    apply_iscsi_targets "$payload"
    ;;
  nvmeof)
    if [[ "$subcommand" == "prepare" ]]; then
      payload="${3:-}"
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for nvmeof prepare."
        exit 2
      fi
      log_command "$command $subcommand" "$payload"
      nvmeof_prepare "$payload"
    elif [[ "$subcommand" == "subsystem" && "$action" == "apply" ]]; then
      if [[ -z "$payload" || ! -r "$payload" ]]; then
        emit_error "A readable payload file is required for nvmeof subsystem apply."
        exit 2
      fi
      log_command "$command $subcommand $action" "$payload"
      apply_nvmeof_subsystems "$payload"
    else
      emit_error "Unsupported nvmeof operation: ${subcommand:-<empty>} ${action:-<empty>}"
      exit 2
    fi
    ;;
  *)
    emit_error "Unsupported storagectl command: ${command:-<empty>}"
    exit 2
    ;;
esac
