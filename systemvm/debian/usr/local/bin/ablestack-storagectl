set -euo pipefail

runtime_release="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ -d "${runtime_release}/lib/ablestack-storage" ]]; then
  export ABLESTACK_STORAGE_HELPER_ROOT="${runtime_release}/lib/ablestack-storage"
else
  export ABLESTACK_STORAGE_HELPER_ROOT="/usr/local/lib/ablestack-storage"
fi

LOG_FILE="/var/log/ablestack-storagectl.log"
MONITOR_CACHE_DIR="${ABLESTACK_STORAGE_MONITOR_CACHE_DIR:-/run/ablestack-storage/monitor}"
DESIRED_STATE_DIR="${ABLESTACK_STORAGE_DESIRED_STATE_DIR:-/etc/ablestack-storage/desired-state}"
NFS_DESIRED_STATE_FILE="${ABLESTACK_STORAGE_NFS_DESIRED_STATE_FILE:-${DESIRED_STATE_DIR}/nfs-export-apply.json}"
SMB_DESIRED_STATE_FILE="${ABLESTACK_STORAGE_SMB_DESIRED_STATE_FILE:-${DESIRED_STATE_DIR}/smb-share-apply.json}"

json_escape() {
  local value="${1:-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

emit_success() {
  local message="$1"
  printf '{"success":true,"message":"%s"}\n' "$(json_escape "$message")"
}

emit_error() {
  local message="$1"
  printf '{"success":false,"message":"%s"}\n' "$(json_escape "$message")" >&2
}

log_command() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s command=%s payload=%s\n' "$(date -Is)" "${1:-}" "${2:-}" >> "$LOG_FILE"
}

persist_nfs_desired_state() {
  local payload_file="$1"
  local tmp
  if [[ -z "$payload_file" || ! -r "$payload_file" ]]; then
    return
  fi
  mkdir -p "$DESIRED_STATE_DIR"
  tmp="$(mktemp "${DESIRED_STATE_DIR}/.nfs-export-apply.XXXXXX")"
  python3 - "$payload_file" "$tmp" <<'PY'
import json, sys
with open(sys.argv[1]) as source:
    value = json.load(source)
value.pop("posixIntent", None)
value.pop("configurationOperationId", None)
import os
sys.path.insert(0, os.environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from shared_directory_policy import FileSharePathBindings
FileSharePathBindings().enrich_desired(value)
with open(sys.argv[2], "w") as target:
    json.dump(value, target, sort_keys=True)
PY
  chmod 0600 "$tmp"
  mv "$tmp" "$NFS_DESIRED_STATE_FILE"
}

persist_smb_desired_state() {
  local payload_file="$1"
  local tmp
  if [[ -z "$payload_file" || ! -r "$payload_file" ]]; then
    return
  fi
  mkdir -p "$DESIRED_STATE_DIR"
  tmp="$(mktemp "${DESIRED_STATE_DIR}/.smb-share-apply.XXXXXX")"
  python3 - "$payload_file" "$tmp" <<'PY'
import json
import sys

source, target = sys.argv[1], sys.argv[2]
with open(source, "r", encoding="utf-8") as source_fp:
    payload = json.load(source_fp)
import os
sys.path.insert(0, os.environ["ABLESTACK_STORAGE_HELPER_ROOT"])
from shared_directory_policy import FileSharePathBindings
FileSharePathBindings().enrich_desired(payload)
for share in payload.get("shares", []):
    for acl in share.get("acls", []):
        acl.pop("password", None)
if "password" in payload:
    payload.pop("password", None)
with open(target, "w", encoding="utf-8") as target_fp:
    json.dump(payload, target_fp, sort_keys=True, indent=2)
    target_fp.write("\n")
PY
  chmod 0600 "$tmp"
  mv "$tmp" "$SMB_DESIRED_STATE_FILE"
}

open_tcp_firewall_port() {
  local port="$1"
  if [[ -z "$port" ]]; then
    return
  fi
  if command -v firewall-cmd >/dev/null 2>&1; then
    firewall-cmd --add-port="${port}/tcp" >/dev/null 2>&1 || true
    firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 || true
  fi
  if command -v iptables >/dev/null 2>&1; then
    iptables -C INPUT -p tcp --dport "$port" -j ACCEPT >/dev/null 2>&1 || \
    iptables -I INPUT -p tcp --dport "$port" -j ACCEPT >/dev/null 2>&1 || true
  fi
}

open_udp_firewall_port() {
  local port="$1"
  if [[ -z "$port" ]]; then
    return
  fi
  if command -v firewall-cmd >/dev/null 2>&1; then
    firewall-cmd --add-port="${port}/udp" >/dev/null 2>&1 || true
    firewall-cmd --permanent --add-port="${port}/udp" >/dev/null 2>&1 || true
  fi
  if command -v iptables >/dev/null 2>&1; then
    iptables -C INPUT -p udp --dport "$port" -j ACCEPT >/dev/null 2>&1 || \
      iptables -I INPUT -p udp --dport "$port" -j ACCEPT >/dev/null 2>&1 || true
  fi
}

emit_cached_runtime() {
  local scope="$1"
  local payload_file="${2:-}"
  if [[ "${ABLESTACK_STORAGECTL_CACHE:-1}" == "0" ]]; then
    return 1
  fi
  python3 - "$MONITOR_CACHE_DIR" "$scope" "$payload_file" <<'PY'
import json
import os
import sys
import time

cache_dir, scope = sys.argv[1], sys.argv[2]
payload_file = sys.argv[3] if len(sys.argv) > 3 else ""
path = os.path.join(cache_dir, scope + ".json")

def load_payload(path):
    if not path:
        return {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}

def matches(session, payload):
    protocol = str(payload.get("protocol") or "").upper()
    client = str(payload.get("client") or "").strip()
    state = str(payload.get("state") or "").upper()
    resource_id = str(payload.get("resourceId") or "").strip()
    if protocol and str(session.get("protocol") or "").upper() != protocol:
        return False
    if client and client not in str(session.get("peer") or "") and client not in str(session.get("client") or ""):
        return False
    if state and str(session.get("state") or "").upper() != state:
        return False
    if resource_id and resource_id not in (str(session.get("resourceId") or ""), str(session.get("resourceName") or "")):
        return False
    return True

try:
    with open(path, "r", encoding="utf-8") as handle:
        cached = json.load(handle)
except Exception:
    sys.exit(1)

generated = float(cached.get("generatedEpoch") or 0)
stale_after = int(cached.get("staleAfterSeconds") or 15)
if generated <= 0 or time.time() - generated > stale_after:
    sys.exit(1)

cached["cached"] = True
if scope == "sessions":
    payload = load_payload(payload_file)
    sessions = [session for session in cached.get("sessions", []) if matches(session, payload)]
    cached["sessions"] = sessions
    cached["count"] = len(sessions)
print(json.dumps(cached, sort_keys=True))
PY
}


network_endpoint_apply() {
  local payload_file="${1:-}"
  if [[ -z "$payload_file" || ! -r "$payload_file" ]]; then
    emit_error "A readable payload file is required for network endpoint apply."
    exit 2
  fi
  python3 - "$payload_file" <<'PY'
import ipaddress
import json
import os
import re
import subprocess
import sys

STATE_PATH = "/etc/ablestack-storage/network-endpoints.json"
payload_path = sys.argv[1]

def run(args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default
    except (OSError, ValueError) as error:
        raise ValueError("INVALID_ENDPOINT_STATE: " + path) from error

def write_state(entries):
    os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump({"endpoints": entries}, handle, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, STATE_PATH)

def normalize_payload(payload):
    if isinstance(payload, dict):
        entries = []
        if isinstance(payload.get("endpoints"), list):
            entries.extend(payload.get("endpoints") or [])
        if isinstance(payload.get("listeners"), list):
            entries.extend(payload.get("listeners") or [])
        if isinstance(payload.get("endpointAliases"), list):
            entries.extend(payload.get("endpointAliases") or [])
        if entries:
            return entries
        if payload.get("listenIp") or payload.get("listenip"):
            return [payload]
        return []
    if isinstance(payload, list):
        return payload
    return []

def netmask_to_prefix(netmask):
    if not netmask:
        return None
    try:
        return ipaddress.IPv4Network("0.0.0.0/" + str(netmask), strict=False).prefixlen
    except Exception:
        return None

def cidr_to_prefix(cidr):
    if not cidr:
        return None
    try:
        return ipaddress.IPv4Network(str(cidr), strict=False).prefixlen
    except Exception:
        return None

def requested_prefix(entry):
    for key in ("prefixlen", "prefixLen"):
        value = entry.get(key)
        if value not in (None, ""):
            prefix = int(value)
            if not 0 <= prefix <= 32:
                raise ValueError("INVALID_ENDPOINT_PREFIX")
            return prefix
    for value, converter in [(entry.get("networkCidr") or entry.get("cidr"), cidr_to_prefix), (entry.get("netmask"), netmask_to_prefix)]:
        if value:
            prefix = converter(value)
            if prefix is None:
                raise ValueError("INVALID_ENDPOINT_PREFIX")
            return prefix
    return 24

def interface_addresses():
    result = run(["ip", "-j", "-4", "addr", "show", "scope", "global"])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "failed to inspect IPv4 addresses")
    return json.loads(result.stdout or "[]")

def interface_links():
    result = run(["ip", "-j", "link", "show"])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "failed to inspect network links")
    return json.loads(result.stdout or "[]")

def find_existing_iface(listen_ip, links):
    matches = [(link.get("ifname"), int(addr.get("prefixlen", 24))) for link in links for addr in link.get("addr_info", [])
               if addr.get("local") == listen_ip]
    if len(matches) > 1:
        raise RuntimeError("NIC_OWNER_UNKNOWN: listen IP exists on multiple NICs")
    return matches[0] if matches else (None, None)

def find_target_iface(entry, links):
    prefix = requested_prefix(entry)
    mac = str(entry.get("macAddress") or "").strip().lower()
    if mac:
        if not re.fullmatch(r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
            raise ValueError("INVALID_ENDPOINT_MAC")
        matches = [link.get("ifname") for link in interface_links() if str(link.get("address", "")).lower() == mac]
        if len(matches) != 1:
            raise RuntimeError("NIC_OWNER_UNKNOWN: endpoint MAC must identify one NIC")
        return matches[0], prefix
    primary = str(entry.get("primaryIp") or "").strip()
    if primary:
        iface, observed_prefix = find_existing_iface(primary, links)
        if iface:
            return iface, observed_prefix
    candidates = [link.get("ifname") for link in interface_links()
                  if link.get("ifname") not in (None, "", "lo") and link.get("link_type") == "ether"]
    if len(candidates) == 1:
        return candidates[0], prefix
    raise RuntimeError("NIC_OWNER_UNKNOWN: legacy endpoint has no unique primary NIC")

def apply_one(entry):
    listen_ip = str(entry.get("listenIp") or entry.get("listenip") or "").strip()
    if not listen_ip or listen_ip in ("0.0.0.0", "::"):
        return None
    ipaddress.IPv4Address(listen_ip)
    links = interface_addresses()
    iface, prefix = find_target_iface({**entry, "listenIp": listen_ip}, links)
    existing_iface, existing_prefix = find_existing_iface(listen_ip, links)
    if existing_iface:
        if existing_iface != iface or (entry.get("macAddress") and existing_prefix != prefix):
            raise RuntimeError("ENDPOINT_OWNER_CONFLICT: active listen IP does not match requested NIC/prefix")
        return {"listenIp": listen_ip, "interface": iface, "prefixlen": existing_prefix, "active": True, "changed": False}
    if not iface:
        raise RuntimeError(f"No System VM interface can host Storage Service listen IP {listen_ip}")
    link_result = run(["ip", "link", "set", iface, "up"])
    if link_result.returncode != 0:
        raise RuntimeError(link_result.stderr.strip() or f"failed to bring up {iface}")
    result = run(["ip", "addr", "add", f"{listen_ip}/{prefix}", "dev", iface])
    if result.returncode != 0 and "File exists" not in (result.stderr or ""):
        raise RuntimeError(result.stderr.strip() or f"failed to add {listen_ip}/{prefix} to {iface}")
    links = interface_addresses()
    verify_iface, verify_prefix = find_existing_iface(listen_ip, links)
    if verify_iface != iface or verify_prefix != prefix:
        raise RuntimeError(f"Storage Service listen IP {listen_ip} did not match requested NIC/prefix after ip addr add")
    return {"listenIp": listen_ip, "interface": verify_iface, "prefixlen": verify_prefix, "active": True, "changed": result.returncode == 0}

payload = load_json(payload_path, {})
requested = [entry for entry in normalize_payload(payload) if isinstance(entry, dict)]
state = load_json(STATE_PATH, {"endpoints": []})
if not isinstance(state, dict) or not isinstance(state.get("endpoints"), list) or any(not isinstance(e, dict) for e in state["endpoints"]):
    raise ValueError("INVALID_ENDPOINT_STATE")
merged = {str(entry.get("listenIp") or entry.get("listenip") or "").strip(): entry for entry in state.get("endpoints", []) if isinstance(entry, dict)}
results = []
for entry in requested:
    result = apply_one(entry)
    if not result:
        continue
    merged[result["listenIp"]] = {**entry, "listenIp": result["listenIp"], "prefixlen": result["prefixlen"]}
    results.append(result)
write_state(list(merged.values()))
print(json.dumps({"success": True, "status": "ok", "endpoints": results, "count": len(results)}, sort_keys=True))
PY
}

network_endpoints_reconcile() {
  local state="/etc/ablestack-storage/network-endpoints.json"
  if [[ ! -r "$state" ]]; then
    emit_success "No Storage Service network endpoints to reconcile."
    return 0
  fi
  network_endpoint_apply "$state"
}

runtime_health() {
  emit_cached_runtime "health" && return 0
  python3 - <<'PY'
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import time

def run(args):
    try:
        return subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
    except Exception as exc:
        return type("Result", (), {"returncode": 1, "stdout": "", "stderr": str(exc)})()

def service_state(name):
    if not shutil.which("systemctl"):
        return "unknown"
    result = run(["systemctl", "is-active", name])
    return result.stdout.strip() or "unknown"

def first_service_state(*names):
    for name in names:
        state = service_state(name)
        if state not in ("unknown", "inactive", "failed"):
            return state
    return service_state(names[0]) if names else "unknown"

def command_present(name):
    return shutil.which(name) is not None

def port_listening(port):
    if not shutil.which("ss"):
        return False
    result = run(["ss", "-H", "-lnt"])
    suffix = ":" + str(port)
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[3].endswith(suffix):
            return True
    return False

def endpoint_listening(ip, port, timeout=1.0):
    deadline = time.time() + max(timeout, 0.5)
    last_error = ""
    candidate_ip = str(ip or "127.0.0.1").strip()
    if candidate_ip in ("0.0.0.0", "::"):
        candidate_ip = "127.0.0.1"
    while time.time() < deadline:
        try:
            with socket.create_connection((candidate_ip, int(port)), timeout=1.0):
                return True, ""
        except Exception as exc:
            last_error = str(exc)
            time.sleep(0.25)
    return False, last_error

def nfs_protocol_mode_from_content(content):
    if not content:
        return "V4_ONLY"
    for match in re.finditer(r"Protocols\s*=\s*([^;]+);", content, re.I):
        value = re.sub(r"\s+", "", match.group(1))
        if "3" in value and "4" in value:
            return "V3V4_DUAL"
        if value == "4":
            return "V4_ONLY"
    return "V4_ONLY"

def rpcbind_active():
    if not shutil.which("systemctl"):
        return False
    for unit in ("rpcbind.socket", "rpcbind.service"):
        try:
            result = subprocess.run(["systemctl", "is-active", "--quiet", unit],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                return True
        except Exception:
            continue
    return False

def collect_ganesha_runtime():
    runtime_dir = "/run/ablestack-storage/ganesha"
    endpoints = []
    for conf_path in sorted(glob.glob("/etc/ganesha/ablestack-storage/*.conf")):
        item = {"file": os.path.basename(conf_path), "listening": False, "processRunning": False}
        try:
            with open(conf_path, "r", encoding="utf-8") as fp:
                content = fp.read()
            listen_ip = ""
            listen_port = 2049
            for line in content.splitlines():
                stripped = line.strip()
                if stripped.startswith("Bind_addr"):
                    listen_ip = stripped.split("=", 1)[1].strip().rstrip(";").strip('"')
                elif stripped.startswith("NFS_Port"):
                    try:
                        listen_port = int(stripped.split("=", 1)[1].strip().rstrip(";"))
                    except Exception:
                        listen_port = 2049
            protocol_mode = nfs_protocol_mode_from_content(content)
            key = os.path.splitext(os.path.basename(conf_path))[0]
            pid_path = os.path.join(runtime_dir, f"{key}.pid")
            log_path = os.path.join(runtime_dir, f"{key}.log")
            item.update({"listenIp": listen_ip, "port": listen_port, "protocolMode": protocol_mode, "pidPath": pid_path, "logPath": log_path})
            if os.path.exists(pid_path):
                try:
                    with open(pid_path, "r", encoding="utf-8") as pid_fp:
                        pid = int(pid_fp.read().strip())
                    item["pid"] = pid
                    item["processRunning"] = os.path.exists(f"/proc/{pid}")
                except Exception as exc:
                    item["error"] = str(exc)
            item["listening"], listen_error = endpoint_listening(listen_ip or "127.0.0.1", listen_port)
            if not item["listening"] and listen_error:
                item["error"] = listen_error
            item["status"] = "active" if item["listening"] else "inactive"
        except Exception as exc:
            item["error"] = str(exc)
            item["status"] = "error"
        endpoints.append(item)
    active = [item for item in endpoints if item.get("listening")]
    needs_rpcbind = any(item.get("protocolMode") == "V3V4_DUAL" for item in endpoints)
    return {
        "configured": len(endpoints),
        "active": len(active),
        "listening": bool(active),
        "status": "ok" if (not endpoints or active) and (not needs_rpcbind or rpcbind_active()) else "degraded",
        "protocolMode": "V3V4_DUAL" if any(item.get("protocolMode") == "V3V4_DUAL" for item in endpoints) else "V4_ONLY",
        "rpcbindRequired": needs_rpcbind,
        "rpcbindActive": rpcbind_active(),
        "endpoints": endpoints,
    }

def collect_network_policy():
    helper = "/usr/local/sbin/ablestack-sharedfs-network"
    if not os.path.isfile(helper):
        return {"status": "UNKNOWN", "error": "NETWORK_HELPER_UNAVAILABLE"}
    result = run([helper, "--observe"])
    try:
        if result.returncode == 0:
            return json.loads(result.stdout)
    except (ValueError, TypeError):
        pass
    return {"status": "UNKNOWN", "error": "NETWORK_OBSERVATION_FAILED"}

def collect_network_addresses():
    if not shutil.which("ip"):
        return []
    addresses = []
    seen = set()
    result = run(["ip", "-j", "-4", "addr", "show", "scope", "global"])
    if result.returncode == 0:
        try:
            for link in json.loads(result.stdout or "[]"):
                ifname = link.get("ifname")
                for item in link.get("addr_info", []) or []:
                    ipaddress = item.get("local")
                    prefix = item.get("prefixlen")
                    if not ipaddress or ipaddress in seen:
                        continue
                    seen.add(ipaddress)
                    flags = item.get("flags") or []
                    secondary = bool(item.get("secondary")) or "secondary" in flags
                    dynamic = bool(item.get("dynamic")) or "dynamic" in flags
                    entry = {
                        "interface": ifname,
                        "ipaddress": ipaddress,
                        "secondary": secondary,
                        "primary": not secondary,
                        "role": "secondary" if secondary else "primary",
                    }
                    if dynamic:
                        entry["dynamic"] = True
                    if prefix is not None:
                        entry["prefixlen"] = prefix
                        entry["cidr"] = f"{ipaddress}/{prefix}"
                    addresses.append(entry)
            return addresses
        except Exception:
            pass
    result = run(["ip", "-o", "-4", "addr", "show", "scope", "global"])
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        ifname = parts[1]
        cidr = parts[3]
        ipaddress = cidr.split("/", 1)[0]
        if not ipaddress or ipaddress in seen:
            continue
        seen.add(ipaddress)
        secondary = " secondary " in f" {line} "
        entry = {
            "interface": ifname,
            "ipaddress": ipaddress,
            "cidr": cidr,
            "secondary": secondary,
            "primary": not secondary,
            "role": "secondary" if secondary else "primary",
        }
        if " dynamic " in f" {line} ":
            entry["dynamic"] = True
        if "/" in cidr:
            try:
                entry["prefixlen"] = int(cidr.split("/", 1)[1])
            except Exception:
                pass
        addresses.append(entry)
    return addresses

def nvmeof_capabilities():
    base = "/sys/kernel/config/nvmet"
    host_root = os.path.join(base, "hosts")
    sample_host = "nqn.2014-08.org.nvmexpress:uuid:00000000-0000-0000-0000-000000000000"
    host_dir = os.path.join(host_root, sample_host)
    existed = os.path.exists(host_dir)
    result = {
        "kernel": run(["uname", "-r"]).stdout.strip(),
        "kernelTargetSupported": os.path.isdir(base),
        "configfsHostSupported": os.path.isdir(host_root),
        "dhChapSupported": False,
        "dhChapCtrlSupported": False,
    }
    if not result["kernelTargetSupported"]:
        result["reason"] = "missing nvmet configfs root"
        return result
    if not result["configfsHostSupported"]:
        result["reason"] = "missing nvmet hosts configfs root"
        return result
    try:
        os.makedirs(host_dir, exist_ok=True)
        result["dhChapSupported"] = os.path.exists(os.path.join(host_dir, "dhchap_key"))
        result["dhChapCtrlSupported"] = os.path.exists(os.path.join(host_dir, "dhchap_ctrl_key"))
        if not result["dhChapSupported"] or not result["dhChapCtrlSupported"]:
            result["reason"] = "missing nvmet host dhchap_key/dhchap_ctrl_key"
    except Exception as exc:
        result["reason"] = str(exc)
    finally:
        if not existed:
            try:
                os.rmdir(host_dir)
            except Exception:
                pass
    return result

def load_state(name):
    path = os.path.join("/etc/ablestack-storage", name)
    if not os.path.exists(path):
        return False
    return os.path.getsize(path) >= 0

def load_json_state(name):
    path = os.path.join("/etc/ablestack-storage", name)
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as fp:
            return json.load(fp)
    except Exception as exc:
        return {"state": "ERROR", "message": str(exc)}

